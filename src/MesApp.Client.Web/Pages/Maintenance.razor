    private async Task SetTab(string tab)
    {
        _tab = tab;
        _error = null;
        _message = null;
        switch (tab)
        {
            case "logs":
                await LoadLogsAsync();
                break;
            case "plans":
                _plans = await Http.GetFromJsonAsync<List<MaintenancePlanResponse>>("api/maintenance-plans");
                break;
            case "orders":
                await LoadMaintenanceOrdersAsync(1);
                break;
            case "parts":
                await LoadPartsConsumptionAsync();
                break;
