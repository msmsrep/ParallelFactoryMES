@page "/maintenance"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>設備保全 - Parallel Factory MES</PageTitle>

<h1>設備保全</h1>
<p class="text-muted">稼働履歴・稼働率（B-40-20、E-20-10）、保全計画（E-30-10）、保全指示・実績（E-30-20〜E-40-30）、保全手順書（E-10-20）。</p>

<Notice Error="@_error" Message="@_message" />

<div class="tabs">
    <button class="@TabClass("logs")" @onclick='() => SetTab("logs")'>稼働監視</button>
    <button class="@TabClass("plans")" @onclick='() => SetTab("plans")'>保全計画</button>
    <button class="@TabClass("orders")" @onclick='() => SetTab("orders")'>保全指示・実績</button>
    <button class="@TabClass("procedures")" @onclick='() => SetTab("procedures")'>保全手順書</button>
    <button class="@TabClass("parts")" @onclick='() => SetTab("parts")'>消耗材モニタリング</button>
</div>

@if (_tab == "logs")
{
    <div class="card">
        <h2 style="margin-top:0;">稼働実績の記録（手入力。センサー自動収集は将来拡張）</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>設備</label>
                <select @bind="_log.EquipmentId">
                    <option value="0">選択してください</option>
                    @foreach (var equipment in _equipments)
                    {
                        <option value="@equipment.Id">@equipment.AssetNo @equipment.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>状態</label>
                <select @bind="_log.Status">
                    <option value="@EquipmentLogStatus.Running">稼働</option>
                    <option value="@EquipmentLogStatus.Stopped">停止</option>
                    <option value="@EquipmentLogStatus.Setup">段取り</option>
                    <option value="@EquipmentLogStatus.Failure">故障</option>
                    <option value="@EquipmentLogStatus.Idle">アイドル</option>
                </select>
            </div>
            <div class="form-field">
                <label>対象作業指示（任意）</label>
                @* 作業指示に紐づけると、そのロットの品質と設備の状態を突き合わせられる（Spec.md 5.7） *@
                <OptionSelect TItem="WorkOrderResponse" Endpoint="api/work-orders/options"
                              @bind-Value="_log.WorkOrderId" EmptyLabel="（なし）"
                              ValueOf="w => w.Id"
                              LabelOf='@(w => $"{w.WorkOrderNo}（{w.ProductCode}）")' />
            </div>
            <div class="form-field">
                <label>開始時刻</label>
                <input type="datetime-local" @bind="_log.StartedAt" />
            </div>
            <div class="form-field">
                <label>終了時刻</label>
                <input type="datetime-local" @bind="_log.EndedAt" />
            </div>
            <div class="form-field">
                <label>停止原因（停止・故障時は必須）</label>
                <input @bind="_log.StopCause" />
            </div>
        </div>
        <button class="btn" disabled="@_busy" @onclick="AddLogAsync">稼働実績を記録</button>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">設備別 稼働サマリ（E-20-10-03）</h2>
        @if (_utilization is null)
        {
            <p class="text-muted">読み込み中...</p>
        }
        else if (_utilization.Count == 0)
        {
            <p class="text-muted">終了時刻まで記録された稼働実績がありません。</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>設備</th><th>稼働(h)</th><th>停止(h)</th><th>段取り(h)</th><th>故障(h)</th><th>アイドル(h)</th><th>故障回数</th><th>時間稼働率</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _utilization)
                    {
                        <tr>
                            <td>@row.AssetNo @row.EquipmentName</td>
                            <td>@row.RunningHours</td>
                            <td>@row.StoppedHours</td>
                            <td>@row.SetupHours</td>
                            <td>@row.FailureHours</td>
                            <td>@row.IdleHours</td>
                            <td>@row.FailureCount</td>
                            <td>
                                @row.UtilizationRate %
                                <BarMeter Value="@row.UtilizationRate" HighIsBad="false" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* 設備総合効率（E-20-30-03）。稼働サマリの素の時間区分に対し、こちらは製造実績と突き合わせた評価指標 *@
    <div class="card">
        <h2 style="margin-top:0;">設備総合効率 OEE（E-20-30-03）</h2>
        @if (_oee is null)
        {
            <p class="text-muted">読み込み中...</p>
        }
        else if (_oee.Count == 0)
        {
            <p class="text-muted">終了時刻まで記録された稼働実績がありません。</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>設備</th><th>負荷(h)</th><th>稼働(h)</th><th>時間稼働率</th>
                        <th>産出数</th><th>性能稼働率</th><th>良品率</th><th>OEE</th><th>カバー率</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _oee)
                    {
                        <tr>
                            <td>@row.AssetNo @row.EquipmentName</td>
                            <td>@row.LoadHours.ToString("0.##")</td>
                            <td>@row.RunningHours.ToString("0.##")</td>
                            <td>@Rate(row.AvailabilityRate)</td>
                            <td>@row.ProducedQuantity.ToString("0.##")</td>
                            <td>@Rate(row.PerformanceRate)</td>
                            <td>@Rate(row.QualityRate)</td>
                            <td>
                                @Rate(row.Oee)
                                @if (row.Oee is not null)
                                {
                                    <BarMeter Value="@row.Oee.Value" HighIsBad="false" />
                                }
                            </td>
                            <td>@Rate(row.CoverageRate)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">
                OEE＝時間稼働率×性能稼働率×良品率。性能稼働率と良品率は<b>作業指示に紐づけて記録した稼働</b>からしか出せないため、
                紐付けのない稼働は対象外にしています（どれだけを見られているかがカバー率）。
                算出できない項目は「-」で、0%としては扱いません。
                理論サイクルタイムは指図展開時に固定した標準作業時間（1個あたり）で、標準より速ければ性能稼働率は100%を超えます。
            </p>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">稼働履歴</h2>
        @if (_logs is not null && _logs.Total > 0)
        {
            <table class="table">
                <thead><tr><th>設備</th><th>状態</th><th>作業指示</th><th>開始</th><th>終了</th><th>停止原因</th></tr></thead>
                <tbody>
                    @foreach (var log in _logs.Items)
                    {
                        <tr>
                            <td>@log.EquipmentName</td>
                            <td>@LogStatusLabel(log.Status)</td>
                            <td>@(log.WorkOrderNo ?? "-")</td>
                            <td>@log.StartedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td>@(log.EndedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                            <td>@(log.StopCause ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pager TItem="EquipmentLogResponse" Result="_logs"
                   OnPageChanged="LoadEquipmentLogsAsync" Busy="@_busy" />
        }
        else
        {
            <p class="text-muted">稼働履歴はありません。</p>
        }
    </div>
}
else if (_tab == "plans")
{
    <AuthorizeView Roles="@MesRoleGroups.MaintenanceManage">
        <div class="card">
            <h2 style="margin-top:0;">保全計画の作成（E-30-10）</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label>設備</label>
                    <select @bind="_plan.EquipmentId">
                        <option value="0">選択してください</option>
                        @foreach (var equipment in _equipments)
                        {
                            <option value="@equipment.Id">@equipment.AssetNo @equipment.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>保全種別</label>
                    <select @bind="_plan.Category">
                        <option value="@MaintenanceCategory.Periodic">定期</option>
                        <option value="@MaintenanceCategory.Unplanned">計画外</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>計画年度</label>
                    <input type="number" @bind="_plan.PlanYear" />
                </div>
                <div class="form-field">
                    <label>予定日</label>
                    <input type="date" @bind="_plan.ScheduledDate" />
                </div>
                <div class="form-field">
                    <label>周期（日数）</label>
                    <input type="number" @bind="_plan.CycleDays" />
                </div>
                <div class="form-field">
                    <label>備考</label>
                    <input @bind="_plan.Note" />
                </div>
            </div>
            <button class="btn" disabled="@_busy" @onclick="CreatePlanAsync">計画を作成</button>
        </div>
    </AuthorizeView>

    <div class="card">
        @if (_plans is null)
        {
            <p class="text-muted">読み込み中...</p>
        }
        else if (_plans.Count == 0)
        {
            <p class="text-muted">保全計画はありません。</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>設備</th><th>種別</th><th>年度</th><th>予定日</th><th>周期</th><th>状態</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var plan in _plans)
                    {
                        <tr>
                            <td>@plan.AssetNo @plan.EquipmentName</td>
                            <td>@(plan.Category == MaintenanceCategory.Periodic ? "定期" : "計画外")</td>
                            <td>@plan.PlanYear</td>
                            <td>@(plan.ScheduledDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@(plan.CycleDays is null ? "-" : $"{plan.CycleDays}日")</td>
                            <td>@PlanStatusLabel(plan.Status)</td>
                            <td>
                                <AuthorizeView Roles="@MesRoleGroups.MaintenanceManage" Context="mt">
                                    @if (plan.Status == MaintenancePlanStatus.Planned)
                                    {
                                        <button class="btn btn-sm" disabled="@_busy"
                                                @onclick="() => CreateOrderFromPlanAsync(plan)">保全指示を発行</button>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else if (_tab == "orders")
{
    <div class="card">
        <h2 style="margin-top:0;">保全指示の作成（計画保全は保全担当、突発依頼は全ユーザー可。E-30-30-01）</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>対象設備</label>
                <select @bind="_order.EquipmentId">
                    <option value="0">なし</option>
                    @foreach (var equipment in _equipments)
                    {
                        <option value="@equipment.Id">@equipment.AssetNo @equipment.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>対象治工具（E-60-30）</label>
                <select @bind="_order.ToolId">
                    <option value="0">なし</option>
                    @foreach (var tool in _tools)
                    {
                        <option value="@tool.Id">@tool.Code @tool.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>依頼区分</label>
                <select @bind="_order.RequestType">
                    <option value="@MaintenanceRequestType.Spot">突発依頼</option>
                    <option value="@MaintenanceRequestType.Planned">計画</option>
                </select>
            </div>
            <div class="form-field">
                <label>手順書</label>
                <select @bind="_order.ProcedureId">
                    <option value="0">なし</option>
                    @foreach (var procedure in _procedures)
                    {
                        <option value="@procedure.Id">@procedure.ProcedureNo @procedure.Title</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>予定日</label>
                <input type="date" @bind="_order.ScheduledDate" />
            </div>
            <div class="form-field">
                <label>依頼内容</label>
                <input @bind="_order.Note" />
            </div>
        </div>
        <button class="btn" disabled="@_busy" @onclick="CreateOrderAsync">保全指示を作成</button>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">保全指示・実績一覧（E-20-30-01〜02）</h2>
        @if (_orders is null)
        {
            <p class="text-muted">読み込み中...</p>
        }
        else if (_orders.Total == 0)
        {
            <p class="text-muted">保全指示はありません。</p>
        }
        else
        {
            @foreach (var order in _orders.Items)
            {
                <div class="card">
                    <div>
                        <strong>@order.OrderNo</strong>
                        <span class="badge">@(order.RequestType == MaintenanceRequestType.Planned ? "計画" : "突発依頼")</span>
                        <span class="badge @OrderStatusClass(order.Status)">@OrderStatusLabel(order.Status)</span>
                        <span class="text-muted">対象：@(order.EquipmentName ?? order.ToolName ?? "-")</span>
                        @if (order.ProcedureNo is not null)
                        {
                            <span class="text-muted">／手順書 @order.ProcedureNo</span>
                        }
                        <span class="text-muted">／予定日 @(order.ScheduledDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                    </div>
                    @if (order.Note is not null)
                    {
                        <div class="text-muted">@order.Note</div>
                    }

                    @if (order.Records.Count > 0)
                    {
                        <table class="table mt-2">
                            <thead><tr><th>実施者</th><th>開始</th><th>終了</th><th>消費部材</th><th>結果</th></tr></thead>
                            <tbody>
                                @foreach (var record in order.Records)
                                {
                                    <tr>
                                        <td>@record.PerformedByName</td>
                                        <td>@record.StartedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                        <td>@(record.EndedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                                        <td>
                                            @foreach (var part in record.Parts)
                                            {
                                                <div>@part.ProductCode @part.ProductName @part.Quantity@part.Unit
                                                    <span class="text-muted">（@part.LotNumber / @part.LocationCode）</span>
                                                </div>
                                            }
                                            @if (record.PartsUsed is not null)
                                            {
                                                <div class="text-muted">@record.PartsUsed</div>
                                            }
                                            @if (record.Parts.Count == 0 && record.PartsUsed is null)
                                            {
                                                @("-")
                                            }
                                        </td>
                                        <td>@(record.Result ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <Pager TItem="MaintenanceOrderResponse" Result="_orders" OnPageChanged="LoadMaintenanceOrdersAsync" />
                    }

                    @if (order.Status == MaintenanceOrderStatus.Instructed)
                    {
                        <div class="form-grid mt-2">
                            <div class="form-field">
                                <label>開始時刻</label>
                                <input type="datetime-local" value="@GetRecord(order.Id).StartedAt.ToString("yyyy-MM-ddTHH:mm")"
                                       @onchange="e => GetRecord(order.Id).StartedAt = ToDateTime(e.Value)" />
                            </div>
                            <div class="form-field">
                                <label>終了時刻</label>
                                <input type="datetime-local" @onchange="e => GetRecord(order.Id).EndedAt = ToDateTime(e.Value)" />
                            </div>
                            <div class="form-field">
                                <label>消費部材・交換部品</label>
                                <input value="@GetRecord(order.Id).PartsUsed"
                                       @onchange="e => GetRecord(order.Id).PartsUsed = e.Value?.ToString()" />
                            </div>
                            <div class="form-field">
                                <label>結果</label>
                                <input value="@GetRecord(order.Id).Result"
                                       @onchange="e => GetRecord(order.Id).Result = e.Value?.ToString()" />
                            </div>
                            @if (order.ToolId is not null)
                            {
                                <div class="form-field">
                                    <label>
                                        <input type="checkbox" style="width:auto;" checked="@GetRecord(order.Id).ResetLife"
                                               @onchange="e => GetRecord(order.Id).ResetLife = (bool)(e.Value ?? false)" />
                                        寿命カウンタをリセット（E-60-30）
                                    </label>
                                </div>
                            }
                        </div>
                        @* 在庫を引き落とす消費部材（E-40-30-01）。自由記述の欄は補足として残している *@
                        <h3>消費部材（在庫から引き落とす）</h3>
                        @foreach (var line in GetRecord(order.Id).Parts)
                        {
                            <div class="form-grid">
                                <div class="form-field">
                                    <label>消費ロット（スキャン可）</label>
                                    <OptionSelect TItem="StockResponse" Endpoint="api/inventory/stocks/options"
                                                  @bind-Value="line.LotId"
                                                  SelectedItemChanged="stock => OnPartStockSelected(line, stock)"
                                                  ValueOf="stock => stock.LotId"
                                                  LabelOf='@(stock => $"{stock.LotNumber}（{stock.ProductCode} / {stock.LocationCode} 残{stock.Quantity}）")' />
                                </div>
                                <div class="form-field">
                                    <label>数量</label>
                                    <input type="number" step="any" min="0" value="@line.Quantity"
                                           @onchange="e => line.Quantity = ToDecimal(e.Value)" />
                                </div>
                                <div class="form-field">
                                    <label>&nbsp;</label>
                                    <button class="btn btn-secondary" @onclick="() => RemovePartLine(order.Id, line)">この行を削除</button>
                                </div>
                            </div>
                        }
                        <div class="actions">
                            <button class="btn btn-secondary" @onclick="() => AddPartLine(order.Id)">消費部材の行を追加</button>
                        </div>

                        <div class="actions">
                            <button class="btn" disabled="@_busy" @onclick="() => AddRecordAsync(order)">保全実績を登録</button>
                            <AuthorizeView Roles="@MesRoleGroups.MaintenanceManage" Context="mtCancel">
                                <button class="btn btn-danger" disabled="@_busy" @onclick="() => CancelOrderAsync(order.Id)">取消</button>
                            </AuthorizeView>
                        </div>
                    }
                </div>
            }
        }
    </div>
}
else if (_tab == "parts")
{
    @* 消耗材モニタリング（E-20-10-04）。保全実績で引き落とした部材と現在庫を並べる *@
    <div class="card">
        <h2 style="margin-top:0;">消耗材の消費実績（E-20-10-04）</h2>
        <p class="text-muted">保全実績で在庫から引き落とした部材の集計。現在庫と見比べて補充の要否を判断する。</p>
        <div class="form-grid">
            <div class="form-field">
                <label>開始日</label>
                <input type="date" @bind="_partsFrom" />
            </div>
            <div class="form-field">
                <label>終了日</label>
                <input type="date" @bind="_partsTo" />
            </div>
        </div>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="LoadPartsConsumptionAsync">集計</button>
        </div>
    </div>

    <div class="card">
        @if (_partsConsumption is null)
        {
            <p class="text-muted">読み込み中...</p>
        }
        else if (_partsConsumption.Count == 0)
        {
            <p class="text-muted">該当期間の消費実績はありません。</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>品目</th><th>名称</th><th>消費数量</th><th>保全件数</th><th>現在庫</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _partsConsumption)
                    {
                        <tr>
                            <td>@row.ProductCode</td>
                            <td>@row.ProductName</td>
                            <td>@row.Quantity @row.Unit</td>
                            <td>@row.RecordCount</td>
                            <td>@row.StockOnHand @row.Unit</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else
{
    <AuthorizeView Roles="@MesRoleGroups.MaintenanceManage">
        <div class="card">
            <h2 style="margin-top:0;">保全手順書の作成（E-10-20。更新で版数が上がります）</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label>手順書番号</label>
                    <input @bind="_procedure.ProcedureNo" />
                </div>
                <div class="form-field">
                    <label>表題</label>
                    <input @bind="_procedure.Title" />
                </div>
                <div class="form-field">
                    <label>対象設備</label>
                    <select @bind="_procedure.EquipmentId">
                        <option value="0">なし</option>
                        @foreach (var equipment in _equipments)
                        {
                            <option value="@equipment.Id">@equipment.AssetNo @equipment.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>対象治工具</label>
                    <select @bind="_procedure.ToolId">
                        <option value="0">なし</option>
                        @foreach (var tool in _tools)
                        {
                            <option value="@tool.Id">@tool.Code @tool.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-field">
                <label>手順ステップ</label>
                <textarea rows="4" @bind="_procedure.Steps"></textarea>
            </div>
            <button class="btn mt-2" disabled="@_busy" @onclick="CreateProcedureAsync">手順書を登録</button>
        </div>
    </AuthorizeView>

    <div class="card">
        @if (_procedures.Count == 0)
        {
            <p class="text-muted">保全手順書はありません。</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>手順書番号</th><th>表題</th><th>対象</th><th>版数</th><th>手順</th></tr></thead>
                <tbody>
                    @foreach (var procedure in _procedures)
                    {
                        <tr>
                            <td>@procedure.ProcedureNo</td>
                            <td>@procedure.Title</td>
                            <td>@(procedure.TargetEquipmentName ?? procedure.TargetToolName ?? "-")</td>
                            <td>v@(procedure.Version)</td>
                            <td style="white-space:pre-wrap;max-width:340px;">@procedure.Steps</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

