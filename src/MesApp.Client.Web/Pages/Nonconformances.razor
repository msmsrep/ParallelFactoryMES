@page "/nonconformances"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>不適合管理 - Parallel Factory MES</PageTitle>

<h1>不適合・逸脱管理</h1>
<p class="text-muted">逸脱/不具合の一覧（C-30-10-01）、対応指示（C-30-20-01）、対応実行記録（-02）、逸脱承認・特別採用（-03）。</p>

<Notice Error="@_error" Message="@_message" />

<div class="card">
    <h2 style="margin-top:0;">逸脱・品質不具合の記録（B-40-30）</h2>
    <div class="form-grid">
        <div class="form-field">
            <label>発生元</label>
            <select @bind="_form.Source">
                <option value="@NonconformanceSource.Production">生産実績</option>
                <option value="@NonconformanceSource.Inspection">検査</option>
                <option value="@NonconformanceSource.Receiving">受入</option>
            </select>
        </div>
        <div class="form-field">
            <label>対象ロット</label>
            <OptionSelect TItem="StockResponse" Endpoint="api/inventory/stocks/options"
                          @bind-Value="_form.LotId" EmptyLabel="なし"
                          ValueOf="s => s.LotId"
                          LabelOf='@(s => $"{s.LotNumber}（{s.ProductCode}）")' />
        </div>
        <div class="form-field">
            <label>対象作業指示</label>
            <OptionSelect TItem="WorkOrderResponse" Endpoint="api/work-orders/options"
                          @bind-Value="_form.WorkOrderId" EmptyLabel="なし"
                          ValueOf="w => w.Id" LabelOf="w => w.WorkOrderNo" />
        </div>
        <div class="form-field">
            <label>原因区分（B-40-30-02）</label>
            <input @bind="_form.CauseCategory" placeholder="例：設備不調／作業ミス／部材不良" />
        </div>
    </div>
    <div class="form-field">
        <label>内容</label>
        <textarea rows="2" @bind="_form.Content"></textarea>
    </div>
    <div class="form-field mt-2">
        <label>原因詳細</label>
        <textarea rows="2" @bind="_form.CauseDetail"></textarea>
    </div>
    <button class="btn mt-2" disabled="@_busy" @onclick="CreateAsync">不適合を起票</button>
</div>

<div class="card">
    <h2 style="margin-top:0;">不適合一覧</h2>
    <select @bind="_statusFilter" @bind:after="LoadAsync" style="margin-bottom:8px;">
        <option value="">全状態</option>
        <option value="Open">発生（未対応）</option>
        <option value="ActionInstructed">対応指示済</option>
        <option value="ActionCompleted">対応完了</option>
        <option value="Closed">承認済（クローズ）</option>
    </select>

    @if (_reports is null)
    {
        <p class="text-muted">読み込み中...</p>
    }
    else if (_reports.Total == 0)
    {
        <p class="text-muted">不適合はありません。</p>
    }
    else
    {
        @foreach (var report in _reports.Items)
        {
            <div class="card">
                <div>
                    <strong>@report.ReportNo</strong>
                    <span class="badge">@SourceLabel(report.Source)</span>
                    <span class="badge @StatusClass(report.Status)">@StatusLabel(report.Status)</span>
                    @if (report.LotNumber is not null)
                    {
                        <span class="text-muted">ロット：@report.LotNumber</span>
                    }
                    @if (report.ReworkOrderNo is not null)
                    {
                        <span class="badge badge-warning">リワーク指図 @report.ReworkOrderNo</span>
                    }
                </div>
                <table class="table mt-2">
                    <tbody>
                        <tr><th style="width:120px;">内容</th><td style="white-space:normal;">@report.Content</td></tr>
                        <tr><th>原因</th><td>@(report.CauseCategory ?? "-") @(report.CauseDetail)</td></tr>
                        <tr>
                            <th>対応指示</th>
                            <td>@(report.Action is null ? "-" : $"{ActionLabel(report.Action.Value)}：{report.ActionInstruction}")</td>
                        </tr>
                        <tr><th>対応実績</th><td style="white-space:normal;">@(report.ActionRecord ?? "-")</td></tr>
                    </tbody>
                </table>
                <Pager TItem="NonconformanceResponse" Result="_reports" OnPageChanged="LoadPageAsync" />

                <div class="actions mt-2">
                    <AuthorizeView Roles="@MesRoleGroups.QualityManage" Context="qc">
                        @if (report.Status != NonconformanceStatus.Closed)
                        {
                            <select value="@GetForm(report.Id).Action"
                                    @onchange="e => GetForm(report.Id).Action = e.Value?.ToString()">
                                <option value="@NonconformanceAction.Rework">リワーク</option>
                                <option value="@NonconformanceAction.Hold">保留</option>
                                <option value="@NonconformanceAction.Discard">廃棄</option>
                                <option value="@NonconformanceAction.SpecialAcceptance">特別採用</option>
                            </select>
                            <input placeholder="指示内容" value="@GetForm(report.Id).Instruction"
                                   @onchange="e => GetForm(report.Id).Instruction = e.Value?.ToString()" />
                            <button class="btn btn-sm" disabled="@_busy" @onclick="() => InstructAsync(report)">対応指示</button>
                        }
                    </AuthorizeView>

                    @if (report.Status == NonconformanceStatus.ActionInstructed)
                    {
                        <input placeholder="対応実績" value="@GetForm(report.Id).Record"
                               @onchange="e => GetForm(report.Id).Record = e.Value?.ToString()" />
                        <button class="btn btn-sm btn-secondary" disabled="@_busy"
                                @onclick="() => RecordActionAsync(report)">対応記録</button>
                    }

                    <AuthorizeView Roles="@MesRoleGroups.QualityManage" Context="qcApprove">
                        @if (report.Status is NonconformanceStatus.ActionInstructed or NonconformanceStatus.ActionCompleted)
                        {
                            <button class="btn btn-sm" disabled="@_busy" @onclick="() => ApproveAsync(report)">
                                承認（特採時はロット解放）
                            </button>
                        }
                    </AuthorizeView>
                </div>
            </div>
        }
    }
</div>

@code {
    private sealed class CreateForm
    {
        public NonconformanceSource Source { get; set; } = NonconformanceSource.Production;
        public int LotId { get; set; }
        public int WorkOrderId { get; set; }
        public string Content { get; set; } = string.Empty;
        public string? CauseCategory { get; set; }
        public string? CauseDetail { get; set; }
    }

    private sealed class ActionForm
    {
        public string? Action { get; set; } = nameof(NonconformanceAction.Rework);
        public string? Instruction { get; set; }
        public string? Record { get; set; }
    }

    private PagedResult<NonconformanceResponse>? _reports;
    private readonly CreateForm _form = new();
    private readonly Dictionary<int, ActionForm> _forms = [];
    private string _statusFilter = string.Empty;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private ActionForm GetForm(int id)
    {
        if (!_forms.TryGetValue(id, out var form))
        {
            form = new ActionForm();
            _forms[id] = form;
        }
        return form;
    }

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        var url = $"api/nonconformances?page={page}";
        if (!string.IsNullOrEmpty(_statusFilter))
        {
            url += $"&status={_statusFilter}";
        }
        _reports = await Http.GetFromJsonAsync<PagedResult<NonconformanceResponse>>(url);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Content))
        {
            _error = "内容を入力してください。";
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/nonconformances",
                new NonconformanceCreateRequest(_form.Source,
                    _form.LotId == 0 ? null : _form.LotId,
                    _form.WorkOrderId == 0 ? null : _form.WorkOrderId,
                    null, _form.Content, _form.CauseCategory, _form.CauseDetail));
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "起票に失敗しました。";
                return;
            }
            _message = "不適合を起票しました。";
            _form.Content = string.Empty;
            _form.CauseDetail = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InstructAsync(NonconformanceResponse report)
    {
        var form = GetForm(report.Id);
        if (!Enum.TryParse<NonconformanceAction>(form.Action, out var action))
        {
            _error = "対応区分を選択してください。";
            return;
        }
        await PostAsync($"api/nonconformances/{report.Id}/instruct",
            new NonconformanceActionRequest(action, form.Instruction),
            "対応を指示しました（保留・廃棄はロットへ、リワークは指図へ連動）。");
    }

    private async Task RecordActionAsync(NonconformanceResponse report)
    {
        var record = GetForm(report.Id).Record;
        if (string.IsNullOrWhiteSpace(record))
        {
            _error = "対応実績を入力してください。";
            return;
        }
        await PostAsync($"api/nonconformances/{report.Id}/record-action",
            new NonconformanceActionRecordRequest(record), "対応実績を記録しました。");
    }

    private async Task ApproveAsync(NonconformanceResponse report)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsync($"api/nonconformances/{report.Id}/approve", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "承認に失敗しました。";
                return;
            }
            _message = "承認しました（クローズ）。";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PostAsync<T>(string url, T body, string successMessage)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync(url, body);
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "操作に失敗しました。";
                return;
            }
            _message = successMessage;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SourceLabel(NonconformanceSource source) => source switch
    {
        NonconformanceSource.Production => "生産実績",
        NonconformanceSource.Inspection => "検査",
        NonconformanceSource.Receiving => "受入",
        _ => source.ToString(),
    };

    private static string ActionLabel(NonconformanceAction action) => action switch
    {
        NonconformanceAction.Rework => "リワーク",
        NonconformanceAction.Hold => "保留",
        NonconformanceAction.Discard => "廃棄",
        NonconformanceAction.SpecialAcceptance => "特別採用",
        _ => action.ToString(),
    };

    private static string StatusLabel(NonconformanceStatus status) => status switch
    {
        NonconformanceStatus.Open => "発生",
        NonconformanceStatus.ActionInstructed => "対応指示済",
        NonconformanceStatus.ActionCompleted => "対応完了",
        NonconformanceStatus.Closed => "クローズ",
        _ => status.ToString(),
    };

    private static string StatusClass(NonconformanceStatus status) => status switch
    {
        NonconformanceStatus.Closed => "badge-success",
        NonconformanceStatus.Open => "badge-danger",
        _ => "badge-warning",
    };
}
