@page "/work-orders/{Id:int}/setup"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>段取り・チェックリスト - Parallel Factory MES</PageTitle>

@if (_workOrder is null)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    <h1>段取り・チェックリスト：@_workOrder.WorkOrderNo</h1>
    <p class="text-muted">
        @_workOrder.ProductCode @_workOrder.ProductName ／ 工程 @_workOrder.ProcessCode @_workOrder.ProcessName
        <a class="btn btn-secondary btn-sm" href="work-orders/@Id/record">実績入力へ</a>
    </p>

    <Notice Error="@_error" Message="@_message" />

    <div class="card">
        <h2 style="margin-top:0;">段取り実績（B-20-50 前段取り／B-40-40 後段取り）</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>区分</label>
                <select @bind="_setupType">
                    <option value="@SetupType.Pre">前段取り</option>
                    <option value="@SetupType.Post">後段取り</option>
                </select>
            </div>
            <div class="form-field">
                <label>開始時刻</label>
                <input type="datetime-local" @bind="_startedAt" />
            </div>
            <div class="form-field">
                <label>終了時刻</label>
                <input type="datetime-local" @bind="_endedAt" />
            </div>
            <div class="form-field">
                <label>異常報告（B-20-50-05）</label>
                <input @bind="_abnormality" placeholder="異常があれば記入" />
            </div>
        </div>
        <AuthorizeView Roles="@MesRoleGroups.ShopFloorRecord">
            <button class="btn" disabled="@_busy" @onclick="AddSetupAsync">段取り実績を記録</button>
        </AuthorizeView>

        @if (_setupRecords.Count > 0)
        {
            <table class="table mt-2">
                <thead>
                    <tr><th>区分</th><th>開始</th><th>終了</th><th>実施者</th><th>異常報告</th></tr>
                </thead>
                <tbody>
                    @foreach (var record in _setupRecords)
                    {
                        <tr>
                            <td>@(record.Type == SetupType.Pre ? "前段取り" : "後段取り")</td>
                            <td>@record.StartedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td>@(record.EndedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                            <td>@record.PerformedByName</td>
                            <td>@(record.AbnormalityNote ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* 治工具の引当・払出・受領確認（B-20-30-01〜03）。現物の所在を追う。寿命の累計は治工具管理で記録する *@
    <div class="card">
        <h2 style="margin-top:0;">治工具の引当・払出（B-20-30）</h2>
        <AuthorizeView Roles="@MesRoleGroups.ProductionManage" Context="toolAllocate">
            <div class="form-grid">
                <div class="form-field">
                    <label>治工具</label>
                    <select @bind="_allocateToolId">
                        <option value="0">選択してください</option>
                        @foreach (var tool in _tools)
                        {
                            <option value="@tool.Id">@tool.Code @tool.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>備考</label>
                    <input @bind="_allocateNote" />
                </div>
            </div>
            <button class="btn" disabled="@_busy" @onclick="AllocateToolAsync">引き当てる</button>
            <p class="text-muted">
                メンテナンス中・廃棄済み・寿命に達した治工具、他の作業指示に引当中の治工具は引き当てられない。
            </p>
        </AuthorizeView>

        @if (_toolIssues.Count == 0)
        {
            <p class="text-muted">この作業指示への治工具の引当はありません。</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>治工具</th><th>状態</th><th>引当日時</th><th>払出日時</th><th>受領者</th><th>返却日時</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var issue in _toolIssues)
                    {
                        <tr>
                            <td>@issue.ToolCode @issue.ToolName</td>
                            <td><StatusBadge Status="@issue.Status.ToString()" /></td>
                            <td>@issue.AllocatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td>@(issue.IssuedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                            <td>@(issue.IssuedToName ?? "-")</td>
                            <td>@(issue.ReturnedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                            <td class="actions">
                                @if (issue.Status == ToolIssueStatus.Allocated)
                                {
                                    <AuthorizeView Roles="@MesRoleGroups.ShopFloorRecord" Context="toolIssue">
                                        <button class="btn btn-sm" disabled="@_busy"
                                                @onclick="() => IssueToolAsync(issue.Id)">受領（払出）</button>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="@MesRoleGroups.ProductionManage" Context="toolCancel">
                                        <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                                @onclick="() => CancelToolIssueAsync(issue.Id)">引当取消</button>
                                    </AuthorizeView>
                                }
                                else if (issue.Status == ToolIssueStatus.Issued)
                                {
                                    <AuthorizeView Roles="@MesRoleGroups.ShopFloorRecord" Context="toolReturn">
                                        <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                                @onclick="() => ReturnToolAsync(issue.Id)">返却</button>
                                    </AuthorizeView>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">チェックリスト実施（B-30-10。HSE項目含む）</h2>
        <div class="form-field" style="max-width:360px;">
            <label>チェックリスト</label>
            <select @bind="_selectedChecklistId" @bind:after="OnChecklistChanged">
                <option value="0">選択してください</option>
                @foreach (var checklist in _checklists)
                {
                    <option value="@checklist.Id">@checklist.Code @checklist.Name（@ChecklistCategoryLabel(checklist.Category)）</option>
                }
            </select>
        </div>

        @if (_selectedChecklist is not null)
        {
            <table class="table mt-2">
                <thead>
                    <tr><th style="width:60px;">確認</th><th>項目</th><th>必須</th><th>備考</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _selectedChecklist.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@_checks[item.Id].Checked"
                                       @onchange="e => _checks[item.Id].Checked = (bool)(e.Value ?? false)" />
                            </td>
                            <td>@item.Text</td>
                            <td>@(item.IsRequired ? "必須" : "-")</td>
                            <td>
                                <input value="@_checks[item.Id].Note"
                                       @onchange="e => _checks[item.Id].Note = e.Value?.ToString()" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <AuthorizeView Roles="@MesRoleGroups.ShopFloorRecord" Context="checklistWrite">
                <button class="btn mt-2" disabled="@_busy" @onclick="SubmitChecklistAsync">チェックリストを記録</button>
            </AuthorizeView>
        }

        @if (_checklistRecords.Count > 0)
        {
            <h2>実施履歴</h2>
            <table class="table">
                <thead>
                    <tr><th>チェックリスト</th><th>実施者</th><th>実施日時</th><th>結果</th></tr>
                </thead>
                <tbody>
                    @foreach (var record in _checklistRecords)
                    {
                        <tr>
                            <td>@record.ChecklistCode @record.ChecklistName</td>
                            <td>@record.PerformedByName</td>
                            <td>@record.PerformedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td>@record.Results.Count(r => r.IsChecked) / @record.Results.Count 項目</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private sealed class CheckState
    {
        public bool Checked { get; set; }
        public string? Note { get; set; }
    }

    [Parameter] public int Id { get; set; }

    private WorkOrderResponse? _workOrder;
    private List<SetupRecordResponse> _setupRecords = [];
    private List<ChecklistResponse> _checklists = [];
    private List<ChecklistRecordResponse> _checklistRecords = [];
    private List<ToolResponse> _tools = [];
    private List<ToolIssueResponse> _toolIssues = [];
    private int _allocateToolId;
    private string? _allocateNote;
    private ChecklistResponse? _selectedChecklist;
    private readonly Dictionary<int, CheckState> _checks = [];

    private SetupType _setupType = SetupType.Pre;
    private DateTime _startedAt = DateTime.Now;
    private DateTime? _endedAt;
    private string? _abnormality;
    private int _selectedChecklistId;

    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _checklists = await Http.GetFromJsonAsync<List<ChecklistResponse>>("api/checklists") ?? [];
        _tools = await Http.GetFromJsonAsync<List<ToolResponse>>("api/tools") ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _workOrder = await Http.GetFromJsonAsync<WorkOrderResponse>($"api/work-orders/{Id}");
        _setupRecords = await Http.GetFromJsonAsync<List<SetupRecordResponse>>(
            $"api/work-orders/{Id}/setup-records") ?? [];
        _checklistRecords = await Http.GetFromJsonAsync<List<ChecklistRecordResponse>>(
            $"api/work-orders/{Id}/checklist-records") ?? [];
        _toolIssues = await Http.GetFromJsonAsync<List<ToolIssueResponse>>(
            $"api/tool-issues?workOrderId={Id}") ?? [];
    }

    private void OnChecklistChanged()
    {
        _selectedChecklist = _checklists.FirstOrDefault(c => c.Id == _selectedChecklistId);
        _checks.Clear();
        foreach (var item in _selectedChecklist?.Items ?? [])
        {
            _checks[item.Id] = new CheckState();
        }
    }

    private async Task AddSetupAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/work-orders/{Id}/setup-records",
                new SetupRecordRequest(_setupType, new DateTimeOffset(_startedAt),
                    _endedAt is null ? null : new DateTimeOffset(_endedAt.Value), _abnormality));
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "記録に失敗しました。";
                return;
            }
            _message = "段取り実績を記録しました。";
            _abnormality = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitChecklistAsync()
    {
        if (_selectedChecklist is null)
        {
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var results = _selectedChecklist.Items
                .Select(i => new ChecklistResultRequest(i.Id, _checks[i.Id].Checked, _checks[i.Id].Note))
                .ToList();
            var response = await Http.PostAsJsonAsync($"api/work-orders/{Id}/checklist-records",
                new ChecklistRecordRequest(_selectedChecklist.Id, results));
            if (!response.IsSuccessStatusCode)
            {
                // 必須項目が未チェックの場合はここでエラーになる
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "記録に失敗しました。";
                return;
            }
            _message = "チェックリストを記録しました。";
            OnChecklistChanged();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ChecklistCategoryLabel(ChecklistCategory category) => category switch
    {
        ChecklistCategory.Common => "共通",
        ChecklistCategory.Process => "工程",
        ChecklistCategory.Product => "品目",
        ChecklistCategory.Setup => "段取り",
        ChecklistCategory.Maintenance => "保全",
        ChecklistCategory.Hse => "HSE",
        _ => category.ToString(),
    };

    private async Task AllocateToolAsync()
    {
        if (_allocateToolId == 0)
        {
            _error = "治工具を選択してください。";
            return;
        }
        await RunToolActionAsync(
            () => Http.PostAsJsonAsync("api/tool-issues",
                new ToolAllocateRequest(_allocateToolId, Id, _allocateNote)),
            "引き当てました。",
            () =>
            {
                _allocateToolId = 0;
                _allocateNote = null;
            });
    }

    private Task IssueToolAsync(int issueId) => RunToolActionAsync(
        () => Http.PostAsJsonAsync($"api/tool-issues/{issueId}/issue", new ToolIssueReceiveRequest(null)),
        "受領（払出）を記録しました。");

    private Task ReturnToolAsync(int issueId) => RunToolActionAsync(
        () => Http.PostAsJsonAsync($"api/tool-issues/{issueId}/return", new ToolIssueCloseRequest(null)),
        "返却を記録しました。");

    private Task CancelToolIssueAsync(int issueId) => RunToolActionAsync(
        () => Http.PostAsJsonAsync($"api/tool-issues/{issueId}/cancel", new ToolIssueCloseRequest(null)),
        "引当を取り消しました。");

    /// <summary>治工具の操作は成否の見せ方が同じなのでまとめる（各画面の _error / _message の作法に合わせる）</summary>
    private async Task RunToolActionAsync(
        Func<Task<HttpResponseMessage>> action, string success, Action? onSuccess = null)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await action();
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "操作に失敗しました。";
                return;
            }
            _message = success;
            onSuccess?.Invoke();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
