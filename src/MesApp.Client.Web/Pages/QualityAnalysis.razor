@page "/quality-analysis"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>品質分析 - Parallel Factory MES</PageTitle>

<h1>品質分析</h1>
<p class="text-muted">不良項目別・工程別・期間別の集計（C-40-10-03）、不適合・逸脱発生状況のモニタリング（C-40-10-05）。期間は製造日（業務日付）基準。</p>

<div class="card">
    <div class="form-grid">
        <div class="form-field">
            <label>開始日（製造日）</label>
            <input type="date" @bind="_from" />
        </div>
        <div class="form-field">
            <label>終了日（製造日）</label>
            <input type="date" @bind="_to" />
        </div>
    </div>
    <button class="btn" @onclick="LoadAsync">集計</button>
</div>

@if (_summary is null)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    <div class="card">
        <h2 style="margin-top:0;">サマリ</h2>
        <table class="table">
            <tbody>
                <tr>
                    <th>検査 合格 / 不合格</th>
                    <td>@_summary.InspectionPassCount 件 / @_summary.InspectionFailCount 件</td>
                    <th>未クローズの不適合</th>
                    <td>
                        @_summary.OpenNonconformanceCount 件
                        @if (_summary.OpenNonconformanceCount > 0)
                        {
                            <span class="badge badge-warning">要対応</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">品目別の不良集計</h2>
        @if (_summary.ByProduct.Count == 0)
        {
            <p class="text-muted">対象期間の生産実績はありません。</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>品目</th><th>良品数</th><th>不良数</th><th>うち廃棄</th><th>うち再作業待ち</th><th>不良率</th><th>構成</th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByProduct)
                    {
                        <tr>
                            <td>@row.Key</td>
                            <td>@row.GoodQuantity</td>
                            <td>@row.DefectQuantity</td>
                            <td>@row.ScrapQuantity</td>
                            <td>@row.ReworkQuantity</td>
                            <td class="@(row.DefectRate > 0 ? "text-danger" : "")">@row.DefectRate %</td>
                            <td><BarMeter Value="@row.DefectRate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">工程別の不良集計</h2>
        @if (_summary.ByProcess.Count == 0)
        {
            <p class="text-muted">対象期間の生産実績はありません。</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>工程</th><th>良品数</th><th>不良数</th><th>うち廃棄</th><th>うち再作業待ち</th><th>不良率</th><th>構成</th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByProcess)
                    {
                        <tr>
                            <td>@row.Key</td>
                            <td>@row.GoodQuantity</td>
                            <td>@row.DefectQuantity</td>
                            <td>@row.ScrapQuantity</td>
                            <td>@row.ReworkQuantity</td>
                            <td class="@(row.DefectRate > 0 ? "text-danger" : "")">@row.DefectRate %</td>
                            <td><BarMeter Value="@row.DefectRate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">不適合の原因区分別 発生件数</h2>
        @if (_summary.NonconformanceByCause.Count == 0)
        {
            <p class="text-muted">対象期間の不適合はありません。</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>原因区分</th><th>件数</th><th>構成</th></tr></thead>
                <tbody>
                    @foreach (var pair in _summary.NonconformanceByCause)
                    {
                        <tr>
                            <td>@pair.Key</td>
                            <td>@pair.Value 件</td>
                            <td><BarMeter Value="@(MaxCause == 0 ? 0 : (decimal)pair.Value / MaxCause * 100)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private QualitySummaryResponse? _summary;
    private DateTime? _from;
    private DateTime? _to;

    private int MaxCause => _summary?.NonconformanceByCause.Count > 0
        ? _summary.NonconformanceByCause.Values.Max()
        : 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (_from is not null)
        {
            query.Add($"from={DateOnly.FromDateTime(_from.Value):yyyy-MM-dd}");
        }
        if (_to is not null)
        {
            query.Add($"to={DateOnly.FromDateTime(_to.Value):yyyy-MM-dd}");
        }
        var url = "api/quality/summary" + (query.Count > 0 ? "?" + string.Join("&", query) : string.Empty);
        _summary = await Http.GetFromJsonAsync<QualitySummaryResponse>(url);
    }
}
