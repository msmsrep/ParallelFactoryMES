@page "/quality-analysis"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["品質分析 - Parallel Factory MES"]</PageTitle>

<h1>@L["品質分析"]</h1>
<p class="text-muted">@L["不良項目別・工程別・直別・期間別の集計（C-40-10-03）、不適合・逸脱発生状況のモニタリング（C-40-10-05）、管理図と工程能力（C-50-10-01〜02）。期間は製造日（業務日付）基準。"]</p>

<div class="card">
    <div class="form-grid">
        <div class="form-field">
            <label>@L["開始日（製造日）"]</label>
            <input type="date" @bind="_from" />
        </div>
        <div class="form-field">
            <label>@L["終了日（製造日）"]</label>
            <input type="date" @bind="_to" />
        </div>
    </div>
    <button class="btn" @onclick="LoadAsync">@L["集計"]</button>
</div>

@if (_summary is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <div class="card">
        <h2 style="margin-top:0;">@L["サマリ"]</h2>
        <table class="table">
            <tbody>
                <tr>
                    <th>@L["検査 合格 / 不合格"]</th>
                    <td>@L["{0} 件 / {1} 件", _summary.InspectionPassCount, _summary.InspectionFailCount]</td>
                    <th>@L["未クローズの不適合"]</th>
                    <td>
                        @L["{0} 件", _summary.OpenNonconformanceCount]
                        @if (_summary.OpenNonconformanceCount > 0)
                        {
                            <span class="badge badge-warning">@L["要対応"]</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">@L["品目別の不良集計"]</h2>
        @if (_summary.ByProduct.Count == 0)
        {
            <p class="text-muted">@L["対象期間の生産実績はありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["品目"]</th><th>@L["良品数"]</th><th>@L["不良数"]</th><th>@L["うち廃棄"]</th><th>@L["うち再作業待ち"]</th><th>@L["不良率"]</th><th>@L["構成"]</th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByProduct)
                    {
                        <tr>
                            <td>@row.Key</td>
                            <td>@row.GoodQuantity</td>
                            <td>@row.DefectQuantity</td>
                            <td>@row.ScrapQuantity</td>
                            <td>@row.ReworkQuantity</td>
                            <td class="@(row.DefectRate > 0 ? "text-danger" : "")">@row.DefectRate %</td>
                            <td><BarMeter Value="@row.DefectRate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">@L["工程別の不良集計"]</h2>
        @if (_summary.ByProcess.Count == 0)
        {
            <p class="text-muted">@L["対象期間の生産実績はありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["工程"]</th><th>@L["良品数"]</th><th>@L["不良数"]</th><th>@L["うち廃棄"]</th><th>@L["うち再作業待ち"]</th><th>@L["不良率"]</th><th>@L["構成"]</th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByProcess)
                    {
                        <tr>
                            <td>@row.Key</td>
                            <td>@row.GoodQuantity</td>
                            <td>@row.DefectQuantity</td>
                            <td>@row.ScrapQuantity</td>
                            <td>@row.ReworkQuantity</td>
                            <td class="@(row.DefectRate > 0 ? "text-danger" : "")">@row.DefectRate %</td>
                            <td><BarMeter Value="@row.DefectRate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* 直別の不良集計（C-40-10-03）。3.9節の製造日が夜勤を前提にしているので昼勤と比べられるようにする *@
    <div class="card">
        <h2 style="margin-top:0;">@L["直別の不良集計"]</h2>
        @if (_summary.ByShift.Count == 0)
        {
            <p class="text-muted">@L["対象期間の生産実績はありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["直"]</th><th>@L["良品数"]</th><th>@L["不良数"]</th><th>@L["うち廃棄"]</th><th>@L["うち再作業待ち"]</th><th>@L["不良率"]</th><th>@L["構成"]</th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByShift)
                    {
                        <tr>
                            <td>@(row.Key == ShiftLabels.NoShift ? L[ShiftLabels.NoShift] : row.Key)</td>
                            <td>@row.GoodQuantity</td>
                            <td>@row.DefectQuantity</td>
                            <td>@row.ScrapQuantity</td>
                            <td>@row.ReworkQuantity</td>
                            <td class="@(row.DefectRate > 0 ? "text-danger" : "")">@row.DefectRate %</td>
                            <td><BarMeter Value="@row.DefectRate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_summary.ByShift.All(r => r.Key == ShiftLabels.NoShift))
            {
                @* 直を運用していないと全実績がここへ落ちる。無言だと表の意味が伝わらない *@
                <p class="text-muted">
                    @L["実績に直が付いていません。マスタ管理の勤務シフトで直を定義すると、以降の実績が直別に分かれて比べられます（直は実績の記録時に固定するため、それ以前の実績は「{0}」のままです）。", L[ShiftLabels.NoShift]]
                </p>
            }
        }
    </div>

    @* 不良理由別の集計（C-40-10-01）。改善の対象を選ぶための構成比つき *@
    <div class="card">
        <h2 style="margin-top:0;">@L["不良理由別の不良数（パレート）"]</h2>
        <p class="text-muted">
            @L["不良数の多い順に並べ、累積構成比を添える。上位いくつで全体の何割を占めるかが分かると、改善の対象を選べる。"]
        </p>
        @if (_summary.ByDefectReason.Count == 0)
        {
            <p class="text-muted">@L["対象期間の不良理由内訳はありません（実績入力で不良理由別の内訳を登録すると集計されます）。"]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["不良理由"]</th><th>@L["区分"]</th><th>@L["不良数"]</th><th>@L["構成比"]</th><th>@L["累積構成比"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _summary.ByDefectReason)
                    {
                        <tr>
                            <td>@row.Code @row.Name</td>
                            <td>@EnumLabels.Of(row.Category)</td>
                            <td>@row.Quantity</td>
                            <td>@row.Share %</td>
                            <td>@row.CumulativeShare %</td>
                            @* パレート図として読む：多い順に並べ、累積の伸びで改善対象の範囲を決める *@
                            <td><BarMeter Value="@row.CumulativeShare" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">@L["不適合の原因区分別 発生件数"]</h2>
        @if (_summary.NonconformanceByCause.Count == 0)
        {
            <p class="text-muted">@L["対象期間の不適合はありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["原因区分"]</th><th>@L["件数"]</th><th>@L["構成"]</th></tr></thead>
                <tbody>
                    @foreach (var pair in _summary.NonconformanceByCause)
                    {
                        <tr>
                            <td>@pair.Key</td>
                            <td>@L["{0} 件", pair.Value]</td>
                            <td><BarMeter Value="@(MaxCause == 0 ? 0 : (decimal)pair.Value / MaxCause * 100)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* 管理図と工程能力指数（C-50-10-01〜02）。群は検査指示ごと、期間は上の製造日 *@
    <div class="card">
        <h2 style="margin-top:0;">@L["管理図と工程能力"]</h2>
        <p class="text-muted">
            @L["検査実績の測定値を検査指示ごとの群にまとめ、X̄-R 管理図（群の大きさが1なら X-Rs 管理図）を描く。赤は管理限界の外、黄は中心線の同じ側に9点以上続く並び。工程能力指数は群内のばらつきから求める。"]
        </p>
        <div class="form-field">
            <label>@L["検査項目（定量）"]</label>
            <select value="@_chartItemId" @onchange="OnChartItemChangedAsync">
                <option value="0">@L["選択してください"]</option>
                @foreach (var item in _chartItems)
                {
                    <option value="@item.Id">@item.Code @item.Name</option>
                }
            </select>
        </div>
        @if (_chart is not null)
        {
            @if (_chart.Points.Count == 0)
            {
                <p class="text-muted">@L["対象期間の測定値はありません。"]</p>
            }
            else
            {
                <table class="table">
                    <tbody>
                        <tr>
                            <th>@L["管理図"]</th>
                            <td>@(_chart.IsIndividuals ? L["X-Rs 管理図"] : L["X̄-R 管理図（群の大きさ {0}）", _chart.SubgroupSize])</td>
                            <th>@L["群の数"]</th>
                            <td>
                                @_chart.Points.Count
                                @if (_chart.ExcludedSubgroupCount > 0)
                                {
                                    <span class="text-muted">@L["（大きさの違う {0} 群を除外）", _chart.ExcludedSubgroupCount]</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Cp</th>
                            <td>@(_chart.Cp?.ToString("0.00") ?? "-")</td>
                            <th>Cpk</th>
                            <td>
                                @(_chart.Cpk?.ToString("0.00") ?? "-")
                                @if (_chart.Cpk is { } cpk && cpk < 1.33m)
                                {
                                    <span class="badge badge-warning">@L["1.33 未満"]</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                @if (_chart.CenterLine is null)
                {
                    <p class="text-muted">@L["群が2つ以上ないと管理限界と工程能力は求められません。"]</p>
                }
                @if (_chart.SpecLimitsChanged)
                {
                    <p class="text-muted">@L["期間内に規格値が改訂されています。工程能力は最新の規格値で求めています。"]</p>
                }
                <h3>@(_chart.IsIndividuals ? L["個別値（X）"] : L["平均値（X̄）"])</h3>
                <ControlLineChart Labels="@ChartLabels" Values="@_chart.Points.Select(p => (decimal?)p.Mean).ToList()"
                                  OutOfControl="@_chart.Points.Select(p => p.MeanOutOfControl).ToList()"
                                  InRun="@_chart.Points.Select(p => p.InRun).ToList()"
                                  Center="@_chart.CenterLine" Upper="@_chart.UpperControlLimit" Lower="@_chart.LowerControlLimit"
                                  SpecUpper="@_chart.UpperSpecLimit" SpecLower="@_chart.LowerSpecLimit"
                                  AriaLabel="@L["平均値の管理図"]" />
                <h3>@(_chart.IsIndividuals ? L["移動範囲（Rs）"] : L["範囲（R）"])</h3>
                <ControlLineChart Labels="@ChartLabels" Values="@_chart.Points.Select(p => p.Range).ToList()"
                                  OutOfControl="@_chart.Points.Select(p => p.RangeOutOfControl).ToList()"
                                  Center="@_chart.RangeCenterLine" Upper="@_chart.RangeUpperControlLimit"
                                  Lower="@(_chart.RangeLowerControlLimit > 0 ? _chart.RangeLowerControlLimit : null)"
                                  AriaLabel="@L["範囲の管理図"]" />
            }
        }
    </div>
}

@code {
    private QualitySummaryResponse? _summary;
    private List<InspectionItemResponse> _chartItems = [];
    private int _chartItemId;
    private ControlChartResponse? _chart;

    private List<string> ChartLabels => _chart?.Points.Select(p => p.BusinessDate.ToString("MM/dd")).ToList() ?? [];
    private DateTime? _from;
    private DateTime? _to;

    private int MaxCause => _summary?.NonconformanceByCause.Count > 0
        ? _summary.NonconformanceByCause.Values.Max()
        : 0;

    protected override async Task OnInitializedAsync()
    {
        // 管理図は測定値を持つ（規格値のある）項目だけを選べるようにする
        _chartItems = (await Http.GetFromJsonAsync<List<InspectionItemResponse>>("api/inspection-items") ?? [])
            .Where(i => i.LowerLimit is not null || i.UpperLimit is not null)
            .ToList();
        await LoadAsync();
    }

    private async Task OnChartItemChangedAsync(ChangeEventArgs e)
    {
        _chartItemId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await LoadChartAsync();
    }

    private async Task LoadChartAsync()
    {
        if (_chartItemId == 0)
        {
            _chart = null;
            return;
        }
        _chart = await Http.GetFromJsonAsync<ControlChartResponse>(
            $"api/quality/control-chart?inspectionItemId={_chartItemId}" + PeriodQuery("&"));
    }

    private string PeriodQuery(string prefix)
    {
        var query = new List<string>();
        if (_from is not null)
        {
            query.Add($"from={DateOnly.FromDateTime(_from.Value):yyyy-MM-dd}");
        }
        if (_to is not null)
        {
            query.Add($"to={DateOnly.FromDateTime(_to.Value):yyyy-MM-dd}");
        }
        return query.Count > 0 ? prefix + string.Join("&", query) : string.Empty;
    }

    private async Task LoadAsync()
    {
        _summary = await Http.GetFromJsonAsync<QualitySummaryResponse>("api/quality/summary" + PeriodQuery("?"));
        await LoadChartAsync();
    }
}
