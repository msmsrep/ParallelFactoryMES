@page "/manufacturing-orders"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["製造指図 - Parallel Factory MES"]</PageTitle>

<h1>@L["製造指図管理"]</h1>

<AuthorizeView Roles="@MesRoleGroups.ProductionManage">
    <div class="card">
        <h2 style="margin-top:0;">@L["指図登録（A-20-10-01）"]</h2>
        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }
        <div class="form-grid">
            <div class="form-field">
                <label>@L["品目"]</label>
                <OptionSelect TItem="ProductResponse" Endpoint="api/products/options"
                              @bind-Value="_form.ProductId"
                              EmptyLabel="@L["選択してください"]"
                              ValueOf="p => p.Id"
                              LabelOf='@(p => $"{p.Code} {p.Name}")' />
            </div>
            <div class="form-field">
                <label>@L["数量"]</label>
                <input type="number" @bind="_form.Quantity" min="0" />
            </div>
            <div class="form-field">
                <label>@L["納期"]</label>
                <input type="date" @bind="_form.DueDate" />
            </div>
            <div class="form-field">
                <label>@L["指図区分"]</label>
                <select @bind="_form.OrderType">
                    <option value="@ManufacturingOrderType.Normal">@EnumLabels.Of(ManufacturingOrderType.Normal)</option>
                    <option value="@ManufacturingOrderType.Spot">@EnumLabels.Of(ManufacturingOrderType.Spot)</option>
                </select>
            </div>
            <div class="form-field">
                <label>@L["備考"]</label>
                <input @bind="_form.Note" />
            </div>
        </div>
        <button class="btn" disabled="@_busy" @onclick="CreateAsync">@L["登録"]</button>
    </div>
</AuthorizeView>

<div class="card">
    <div class="actions" style="margin-bottom:8px;">
        <select @bind="_statusFilter" @bind:after="LoadAsync">
            <option value="">@L["全状態"]</option>
            <option value="Draft">@L["未承認"]</option>
            <option value="Approved">@L["承認済"]</option>
            <option value="Released">@L["展開済"]</option>
            <option value="Completed">@L["完了"]</option>
            <option value="Canceled">@EnumLabels.Of(ManufacturingOrderStatus.Canceled)</option>
        </select>
    </div>

    @if (_orders is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["指図番号"]</th>
                    <th>@L["品目"]</th>
                    <th>@L["数量"]</th>
                    <th>@L["納期"]</th>
                    <th>@L["区分"]</th>
                    <th>@L["状態"]</th>
                    <th>@L["産出ロット"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in _orders.Items)
                {
                    <tr>
                        <td><a href="manufacturing-orders/@order.Id">@order.OrderNo</a></td>
                        <td>@order.ProductCode @order.ProductName</td>
                        <td>@order.Quantity</td>
                        <td>@(order.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@EnumLabels.Of(order.OrderType)</td>
                        <td><StatusBadge Status="@order.Status.ToString()" /></td>
                        <td>@(order.OutputLotNumber ?? "-")</td>
                        <td><a class="btn btn-secondary btn-sm" href="manufacturing-orders/@order.Id">@L["詳細"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager TItem="ManufacturingOrderResponse" Result="_orders" OnPageChanged="LoadPageAsync" />
    }
</div>

@code {
    private sealed class OrderForm
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public DateTime? DueDate { get; set; }
        public ManufacturingOrderType OrderType { get; set; } = ManufacturingOrderType.Normal;
        public string? Note { get; set; }
    }

    private PagedResult<ManufacturingOrderResponse>? _orders;
    private readonly OrderForm _form = new();
    private string _statusFilter = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        var url = $"api/manufacturing-orders?page={page}";
        if (!string.IsNullOrEmpty(_statusFilter))
        {
            url += $"&status={_statusFilter}";
        }
        _orders = await Http.GetFromJsonAsync<PagedResult<ManufacturingOrderResponse>>(url);
    }

    private async Task CreateAsync()
    {
        if (_busy)
        {
            return;
        }
        if (_form.ProductId == 0 || _form.Quantity <= 0)
        {
            _error = L["品目と数量（0より大きい値）を指定してください。"];
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/manufacturing-orders",
                new CreateManufacturingOrderRequest(
                    _form.ProductId, _form.Quantity,
                    _form.DueDate is null ? null : DateOnly.FromDateTime(_form.DueDate.Value),
                    _form.OrderType, null, _form.Note));
            if (await response.ReadErrorAsync(L["登録に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _form.ProductId = 0;
            _form.Quantity = 0;
            _form.DueDate = null;
            _form.Note = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

}
