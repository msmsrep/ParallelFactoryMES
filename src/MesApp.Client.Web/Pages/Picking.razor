@page "/picking"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["出庫・払出 - Parallel Factory MES"]</PageTitle>

<h1>@L["出庫・工程払出"]</h1>
<p class="text-muted">@L["出庫指示・ピッキング指示（D-20-10。ロットは先入れ先出し（有効期限優先）で自動引当）、ピッキング実行・払出（D-20-20）。"]</p>

<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.InventoryManage">
<div class="card">
    <h2 style="margin-top:0;">@L["ピッキング指示の作成"]</h2>
    <div class="form-grid">
        <div class="form-field">
            <label>@L["区分"]</label>
            <select @bind="_type">
                <option value="@PickingOrderType.ProcessIssue">@EnumLabels.Of(PickingOrderType.ProcessIssue)</option>
                <option value="@PickingOrderType.Shipping">@EnumLabels.Of(PickingOrderType.Shipping)</option>
            </select>
        </div>
        @if (_type == PickingOrderType.ProcessIssue)
        {
            <div class="form-field">
                <label>@L["払出先 作業指示"]</label>
                <OptionSelect TItem="WorkOrderResponse" Endpoint="api/work-orders/options"
                              @bind-Value="_workOrderId"
                              ValueOf="w => w.Id"
                              LabelOf='@(w => L["{0}（{1} / {2}）", w.WorkOrderNo, w.ProductCode, w.ProcessCode])' />
            </div>
        }
        else
        {
            <div class="form-field">
                <label>@L["払出先 出荷指示"]</label>
                <OptionSelect TItem="ShippingOrderResponse"
                              Endpoint="api/shipping-orders/options?status=Instructed"
                              @bind-Value="_shippingOrderId"
                              ValueOf="s => s.Id"
                              LabelOf='@(s => L["{0}（{1}）", s.ShippingNo, s.Destination])' />
            </div>
        }
        <div class="form-field">
            <label>@L["品目"]</label>
            <OptionSelect TItem="ProductResponse" Endpoint="api/products/options"
                          @bind-Value="_lineProductId"
                          SelectedItemChanged="RememberProduct"
                          ValueOf="p => p.Id"
                          LabelOf='@(p => $"{p.Code} {p.Name}")' />
        </div>
        <div class="form-field">
            <label>@L["数量"]</label>
            <input type="number" @bind="_lineQuantity" />
        </div>
    </div>
    <div class="actions">
        <button class="btn btn-secondary" @onclick="AddLine">@L["明細に追加"]</button>
        <button class="btn" disabled="@_busy" @onclick="CreateAsync">@L["ピッキング指示を作成"]</button>
    </div>

    @if (_lines.Count > 0)
    {
        <table class="table mt-2">
            <thead><tr><th>@L["品目"]</th><th>@L["数量"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var line in _lines)
                {
                    <tr>
                        <td>@_productCodes.GetValueOrDefault(line.ProductId, "-")</td>
                        <td>@line.Quantity</td>
                        <td><button class="btn btn-danger btn-sm" @onclick="() => _lines.Remove(line)">@L["削除"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</AuthorizeView>

<div class="card">
    <h2 style="margin-top:0;">@L["ピッキング指示一覧"]</h2>
    @if (_orders is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_orders.Total == 0)
    {
        <p class="text-muted">@L["ピッキング指示はありません。"]</p>
    }
    else
    {
        @foreach (var order in _orders.Items)
        {
            <div class="card">
                <div class="actions" style="justify-content:space-between;">
                    <div>
                        <strong>@order.OrderNo</strong>
                        <span class="badge">@EnumLabels.Of(order.Type)</span>
                        <span class="badge @StatusClass(order.Status)">@EnumLabels.Of(order.Status)</span>
                        <span class="text-muted">@L["払出先：{0}", order.WorkOrderNo ?? order.ShippingNo ?? "-"]</span>
                    </div>
                    @if (order.Status == PickingOrderStatus.Instructed)
                    {
                        <AuthorizeView Roles="@MesRoleGroups.InventoryManage" Context="inventoryWrite">
                            <div class="actions">
                                <button class="btn btn-sm" disabled="@_busy" @onclick="() => ExecuteAsync(order.Id)">@L["ピッキング実行"]</button>
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => CancelAsync(order.Id)">@L["取消"]</button>
                            </div>
                        </AuthorizeView>
                    }
                </div>
                <table class="table mt-2">
                    <thead>
                        <tr><th>@L["品目"]</th><th>@L["引当ロット"]</th><th>@L["ロケーション"]</th><th>@L["数量"]</th><th>@L["照合"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in order.Lines)
                        {
                            <tr>
                                <td>@line.ProductCode @line.ProductName</td>
                                <td>@line.LotNumber</td>
                                <td>@line.LocationCode</td>
                                <td>@line.Quantity</td>
                                <td>
                                    @if (order.Status == PickingOrderStatus.Instructed)
                                    {
                                        @* バーコード照合（D-20-20-01）：スキャン値と引当ロットの一致を確認 *@
                                        <ScanInput Value="@GetScan(line.Id)" ShowSubmit="false"
                                                   Placeholder="@L["ロットをスキャン"]"
                                                   ValueChanged="v => SetScan(line.Id, v)" />
                                        @if (GetScan(line.Id) is { Length: > 0 } scanned)
                                        {
                                            @if (string.Equals(scanned.Trim(), line.LotNumber, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge badge-success">@L["一致"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">@L["不一致"]</span>
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pager TItem="PickingOrderResponse" Result="_orders" OnPageChanged="LoadPageAsync" />
            </div>
        }
    }
</div>

@code {
    private PagedResult<PickingOrderResponse>? _orders;
    private readonly List<PickingRequestLine> _lines = [];

    /// <summary>入力中の明細に出す品目コード（選択肢APIにしたため一覧を手元に持たない）</summary>
    private readonly Dictionary<int, string> _productCodes = [];
    private readonly Dictionary<int, string?> _scans = [];

    private PickingOrderType _type = PickingOrderType.ProcessIssue;
    private int _workOrderId;
    private int _shippingOrderId;
    private int _lineProductId;
    private decimal _lineQuantity;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void RememberProduct(ProductResponse? product)
    {
        if (product is not null)
        {
            _productCodes[product.Id] = product.Code;
        }
    }

    private string? GetScan(int lineId) => _scans.GetValueOrDefault(lineId);

    private void SetScan(int lineId, string? value) => _scans[lineId] = value;

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page) =>
        _orders = await Http.GetFromJsonAsync<PagedResult<PickingOrderResponse>>($"api/picking-orders?page={page}");

    private void AddLine()
    {
        if (_lineProductId == 0 || _lineQuantity <= 0)
        {
            _error = L["品目と数量を指定してください。"];
            return;
        }
        _error = null;
        _lines.Add(new PickingRequestLine(_lineProductId, _lineQuantity));
        _lineQuantity = 0;
    }

    private async Task CreateAsync()
    {
        if (_lines.Count == 0)
        {
            _error = L["明細を追加してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/picking-orders",
                new PickingOrderCreateRequest(_type,
                    _workOrderId == 0 ? null : _workOrderId,
                    _shippingOrderId == 0 ? null : _shippingOrderId,
                    [.. _lines]));
            // 在庫不足もここで通知される
            if (await response.ReadErrorAsync(L["作成に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["ピッキング指示を作成しました（先入れ先出しで引当）。"];
            _lines.Clear();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExecuteAsync(int id) =>
        await PostAsync($"api/picking-orders/{id}/execute", L["ピッキングを実行しました（在庫引落し済み）。"]);

    private async Task CancelAsync(int id) =>
        await PostAsync($"api/picking-orders/{id}/cancel", L["ピッキング指示を取消しました。"]);

    private async Task PostAsync(string url, string successMessage)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsync(url, null);
            if (await response.ReadErrorAsync(L["操作に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = successMessage;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }


    private static string StatusClass(PickingOrderStatus status) => status switch
    {
        PickingOrderStatus.Completed => "badge-success",
        PickingOrderStatus.Canceled => "badge-danger",
        _ => "badge-info",
    };
}
