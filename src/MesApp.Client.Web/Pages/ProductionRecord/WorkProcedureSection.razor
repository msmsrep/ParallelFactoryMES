@inject HttpClient Http

@* 作業手順書（B-10-30-03）。本文はマスタの現在値で、版数だけが展開時点のスナップショット *@
@if (_procedure is { } procedure)
{
    <h2>@L["作業手順書（{0} {1}）", procedure.ProcedureNo, procedure.Title]</h2>
    <div class="card">
        <p class="text-muted">
            @L["版数 v{0}", procedure.CurrentVersion]
            @if (procedure.PlannedVersion is { } planned)
            {
                <span>@L["／計画時 v{0}", planned]</span>
            }
        </p>
        @if (procedure.IsRevised)
        {
            <p class="text-muted">
                <span class="badge badge-danger">@L["改訂あり"]</span>
                @L["この作業指示を展開した時点から手順書が改訂されています。最新の手順で作業してください。"]
            </p>
        }
        @if (!procedure.IsActive)
        {
            <p class="text-muted">
                <span class="badge badge-danger">@L["無効"]</span>
                @L["この手順書は無効化されています。作業前に手順を確認してください。"]
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(procedure.Steps))
        {
            <pre style="white-space:pre-wrap;">@procedure.Steps</pre>
        }
        @if (procedure.Reference is { } reference)
        {
            <p class="text-muted">@L["手順書の所在：{0}", reference]</p>
        }
    </div>
}

@code {
    /// <summary>対象の作業指示</summary>
    [Parameter, EditorRequired] public int WorkOrderId { get; set; }

    private WorkOrderProcedureResponse? _procedure;
    private int _loadedWorkOrderId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedWorkOrderId == WorkOrderId)
        {
            return;
        }
        _loadedWorkOrderId = WorkOrderId;
        // 手順書が紐付いていない作業指示は404になる（工順に登録が無い運用でも画面は開ける）
        var response = await Http.GetAsync($"api/work-orders/{WorkOrderId}/procedure");
        _procedure = response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<WorkOrderProcedureResponse>()
            : null;
    }
}
