@page "/tool-management"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["治工具管理 - Parallel Factory MES"]</PageTitle>

<h1>@L["治工具管理"]</h1>
<p class="text-muted">@L["利用実績の記録（E-60-20-01）、寿命通知（-02）、寿命分析（-03）。治工具マスタはマスタ管理、メンテナンス記録は設備保全から行います。"]</p>

<Notice Error="@_error" Message="@_message" />

<div class="card">
    <h2 style="margin-top:0;">@L["利用実績の記録"]</h2>
    <div class="form-grid">
        <div class="form-field">
            <label>@L["治工具"]</label>
            <select @bind="_toolId">
                <option value="0">@L["選択してください"]</option>
                @foreach (var tool in _tools)
                {
                    <option value="@tool.Id">@tool.Code @tool.Name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label>@L["関連作業指示"]</label>
            <OptionSelect TItem="WorkOrderResponse" Endpoint="api/work-orders/options"
                          @bind-Value="_workOrderId" EmptyLabel="@L["なし"]"
                          ValueOf="w => w.Id"
                          LabelOf='@(w => L["{0}（{1}）", w.WorkOrderNo, w.ProductCode])' />
        </div>
        <div class="form-field">
            <label>@L["使用回数"]</label>
            <input type="number" @bind="_usageCount" />
        </div>
        <div class="form-field">
            <label>@L["使用時間（h）"]</label>
            <input type="number" step="any" @bind="_usageHours" />
        </div>
    </div>
    <button class="btn" disabled="@_busy" @onclick="RecordUsageAsync">@L["利用実績を記録"]</button>
</div>

<div class="card">
    <h2 style="margin-top:0;">@L["寿命ステータス（E-60-20-02：80%で交換時期接近、100%で要交換）"]</h2>
    <label style="display:block;margin-bottom:8px;">
        <input type="checkbox" style="width:auto;" @bind="_alertOnly" @bind:after="LoadAsync" />
        @L["警告・要交換のみ表示"]
    </label>

    @if (_lifeStatus is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_lifeStatus.Count == 0)
    {
        <p class="text-muted">@L["対象の治工具はありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["治工具"]</th><th>@L["状態"]</th><th>@L["使用回数"]</th><th>@L["使用時間"]</th>
                    <th>@L["寿命消化率"]</th><th>@L["通知"]</th><th>@L["最終リセット"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _lifeStatus)
                {
                    <tr>
                        <td>@row.ToolCode @row.ToolName</td>
                        <td>@EnumLabels.Of(row.Status)</td>
                        <td>@row.CumulativeCount @(row.LifeThresholdCount is null ? "" : $"/ {row.LifeThresholdCount}")</td>
                        <td>@row.CumulativeHours @(row.LifeThresholdHours is null ? "" : $"/ {row.LifeThresholdHours}")</td>
                        <td>
                            @if (row.LifeUsageRate is decimal rate)
                            {
                                <text>@rate %</text>
                                <BarMeter Value="@rate" />
                            }
                            else
                            {
                                <span class="text-muted">@L["閾値未設定"]</span>
                            }
                        </td>
                        <td>
                            @if (row.IsLifeReached)
                            {
                                <span class="badge badge-danger">@L["要交換・廃棄"]</span>
                            }
                            else if (row.IsWarning)
                            {
                                <span class="badge badge-warning">@L["交換時期接近"]</span>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@(row.LifeResetAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* 寿命分析（E-60-20-03）。寿命ステータスが「いま何%か」なのに対し、こちらは「いつ交換が要るか」 *@
<div class="card">
    <h2 style="margin-top:0;">@L["寿命分析（E-60-20-03）"]</h2>
    <div class="form-grid">
        <div class="form-field">
            <label>@L["開始日（製造日）"]</label>
            <input type="date" @bind="_analysisFrom" />
        </div>
        <div class="form-field">
            <label>@L["終了日（製造日）"]</label>
            <input type="date" @bind="_analysisTo" />
        </div>
    </div>
    <button class="btn" @onclick="LoadAnalysisAsync">@L["分析"]</button>

    @if (_analysis is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_analysis.Count == 0)
    {
        <p class="text-muted">@L["有効な治工具がありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["治工具"]</th><th>@L["寿命閾値"]</th><th>@L["累計"]</th><th>@L["残り"]</th>
                    <th>@L["期間内の使用"]</th><th>@L["使用日数"]</th><th>@L["1日平均"]</th><th>@L["指示1件平均"]</th><th>@L["寿命到達見込み"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _analysis)
                {
                    <tr>
                        <td>@row.ToolCode @row.ToolName</td>
                        <td>@(row.LifeThresholdCount?.ToString() ?? "-")</td>
                        <td>@row.CumulativeCount</td>
                        <td>@(row.RemainingCount?.ToString() ?? "-")</td>
                        <td>@row.PeriodUsageCount</td>
                        <td>@row.UsageDays</td>
                        <td>@(row.AveragePerDay?.ToString("0.##") ?? "-")</td>
                        <td>@(row.AveragePerWorkOrder?.ToString("0.##") ?? "-")</td>
                        <td>
                            @if (row.EstimatedLifeReachedOn is { } due)
                            {
                                <span>@due.ToString("yyyy-MM-dd")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="text-muted">
            @L["1日平均は「使用実績のあった日」で割る（稼働しない日を含めると余裕があるように見えるため）。"]
            @L["寿命閾値が未設定・期間内に使用が無い・すでに寿命到達のものは見込みを出さない（「-」）。"]
        </p>
    }
</div>

@* いま現場に出ている治工具（B-20-30）。引当・払出そのものは作業指示の段取り画面から行う *@
<div class="card">
    <h2 style="margin-top:0;">@L["引当中・払出中の治工具（B-20-30）"]</h2>
    @if (_openIssues is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_openIssues.Count == 0)
    {
        <p class="text-muted">@L["引当中・払出中の治工具はありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>@L["治工具"]</th><th>@L["作業指示"]</th><th>@L["品目"]</th><th>@L["工程"]</th><th>@L["状態"]</th><th>@L["引当日時"]</th><th>@L["受領者"]</th></tr>
            </thead>
            <tbody>
                @foreach (var issue in _openIssues)
                {
                    <tr>
                        <td>@issue.ToolCode @issue.ToolName</td>
                        <td><a href="work-orders/@issue.WorkOrderId/setup">@issue.WorkOrderNo</a></td>
                        <td>@issue.ProductCode</td>
                        <td>@issue.ProcessCode</td>
                        <td><StatusBadge Status="@issue.Status.ToString()" /></td>
                        <td>@issue.AllocatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                        <td>@(issue.IssuedToName ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2 style="margin-top:0;">@L["利用実績履歴"]</h2>
    @if (_usages is null || _usages.Total == 0)
    {
        <p class="text-muted">@L["利用実績はありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>@L["記録日時"]</th><th>@L["治工具"]</th><th>@L["作業指示"]</th><th>@L["使用回数"]</th><th>@L["使用時間"]</th></tr></thead>
            <tbody>
                @foreach (var usage in _usages.Items)
                {
                    <tr>
                        <td>@usage.RecordedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                        <td>@usage.ToolCode</td>
                        <td>@(usage.WorkOrderNo ?? "-")</td>
                        <td>@usage.UsageCount</td>
                        <td>@(usage.UsageHours?.ToString() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager TItem="ToolUsageResponse" Result="_usages" OnPageChanged="LoadUsagesAsync" Busy="@_busy" />
    }
</div>

@code {
    private List<ToolResponse> _tools = [];
    private List<ToolLifeStatusRow>? _lifeStatus;
    private PagedResult<ToolUsageResponse>? _usages;
    private List<ToolLifeAnalysisRow>? _analysis;
    private List<ToolIssueResponse>? _openIssues;
    private DateTime? _analysisFrom = DateTime.Today.AddMonths(-1);
    private DateTime? _analysisTo = DateTime.Today;

    private int _toolId;
    private int _workOrderId;
    private int _usageCount;
    private decimal? _usageHours;
    private bool _alertOnly;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _tools = await Http.GetFromJsonAsync<List<ToolResponse>>("api/tools") ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lifeStatus = await Http.GetFromJsonAsync<List<ToolLifeStatusRow>>(
            $"api/tool-usages/life-status?alertOnly={_alertOnly.ToString().ToLowerInvariant()}");
        _openIssues = await Http.GetFromJsonAsync<List<ToolIssueResponse>>("api/tool-issues?openOnly=true");
        await LoadAnalysisAsync();
        await LoadUsagesAsync(1);
    }

    private async Task LoadUsagesAsync(int page) =>
        _usages = await Http.GetFromJsonAsync<PagedResult<ToolUsageResponse>>($"api/tool-usages?page={page}");

    private async Task RecordUsageAsync()
    {
        if (_toolId == 0)
        {
            _error = L["治工具を選択してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/tool-usages",
                new ToolUsageRequest(_toolId, _workOrderId == 0 ? null : _workOrderId,
                    _usageCount, _usageHours));
            if (await response.ReadErrorAsync(L["記録に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["利用実績を記録しました。"];
            _usageCount = 0;
            _usageHours = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }


    private async Task LoadAnalysisAsync()
    {
        var query = new List<string>();
        if (_analysisFrom is not null)
        {
            query.Add($"from={DateOnly.FromDateTime(_analysisFrom.Value):yyyy-MM-dd}");
        }
        if (_analysisTo is not null)
        {
            query.Add($"to={DateOnly.FromDateTime(_analysisTo.Value):yyyy-MM-dd}");
        }
        var url = "api/tool-usages/life-analysis" + (query.Count > 0 ? "?" + string.Join("&", query) : string.Empty);
        _analysis = await Http.GetFromJsonAsync<List<ToolLifeAnalysisRow>>(url);
    }
}
