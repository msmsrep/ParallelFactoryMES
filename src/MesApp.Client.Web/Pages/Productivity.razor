@* 生産性モニタリング（Spec.md 3.2 工程進捗管理。歩留まり・直行率・標準時間予実・製造リードタイム。B-60-10-05） *@
@page "/productivity"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["生産性モニタリング - Parallel Factory MES"]</PageTitle>

<h1>@L["生産性モニタリング"]</h1>
<p class="text-muted">
    @L["歩留まり・直行率・標準時間の予実（B-60-10-05）。期間は製造日（業務日付）基準。"]
    @L["直行率は手直しを経ずに一度で良品になった割合、歩留まりはリワークでの救済を含めた最終的な良品の割合。"]
</p>

<div class="card">
    <div class="form-grid">
        <div class="form-field">
            <label>@L["開始日（製造日）"]</label>
            <input type="date" @bind="_from" />
        </div>
        <div class="form-field">
            <label>@L["終了日（製造日）"]</label>
            <input type="date" @bind="_to" />
        </div>
    </div>
    <button class="btn" @onclick="LoadAsync">@L["集計"]</button>
</div>

@if (_summary is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <div class="card">
        <h2 style="margin-top:0;">@L["合計"]</h2>
        @if (_summary.Total.GoodQuantity + _summary.Total.DefectQuantity == 0)
        {
            <p class="text-muted">@L["対象期間の生産実績はありません。"]</p>
        }
        else
        {
            <table class="table">
                <tbody>
                    <tr>
                        <th>@L["良品数"]</th>
                        <td>@_summary.Total.GoodQuantity</td>
                        <th>@L["不良数"]</th>
                        <td>@_summary.Total.DefectQuantity</td>
                        <th>@L["リワークでの救済"]</th>
                        <td>@_summary.Total.ReworkGoodQuantity</td>
                    </tr>
                    <tr>
                        <th>@L["直行率"]</th>
                        <td>
                            @_summary.Total.FirstPassRate %
                            <BarMeter Value="@_summary.Total.FirstPassRate" HighIsBad="false" />
                        </td>
                        <th>@L["歩留まり"]</th>
                        <td>
                            @_summary.Total.YieldRate %
                            <BarMeter Value="@_summary.Total.YieldRate" HighIsBad="false" />
                        </td>
                        <th></th>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">@L["品目別"]</h2>
        <ProductivityTable Rows="_summary.ByProduct" KeyLabel="@L["品目"]" />
    </div>

    <div class="card">
        <h2 style="margin-top:0;">@L["工程別"]</h2>
        <ProductivityTable Rows="_summary.ByProcess" KeyLabel="@L["工程"]" />
    </div>

    @* 標準時間の予実。予定は指図展開時に固定した工順の値で、マスタの現在値では引き直さない *@
    <div class="card">
        <h2 style="margin-top:0;">@L["標準時間の予実"]</h2>
        @if (_summary.TimeVariances.Count == 0)
        {
            <p class="text-muted">@L["対象期間の生産実績はありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["作業指示"]</th><th>@L["品目"]</th><th>@L["工程"]</th><th>@L["計画数量"]</th>
                        <th>@L["予定（分）"]</th><th>@L["実績（分）"]</th><th>@L["超過率"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _summary.TimeVariances)
                    {
                        <tr>
                            <td><a href="work-orders/@row.WorkOrderId/record">@row.WorkOrderNo</a></td>
                            <td>@row.ProductCode</td>
                            <td>@row.ProcessCode</td>
                            <td>@row.PlannedQuantity</td>
                            <td>@row.PlannedMinutes.ToString("0.##")</td>
                            <td>@row.ActualMinutes.ToString("0.##")</td>
                            <td class="@(row.VarianceRate > 0 ? "text-danger" : "")">
                                @(row.VarianceRate is null ? "-" : $"{row.VarianceRate:+0.##;-0.##;0} %")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">
                @L["予定＝標準段取り時間＋標準作業時間×計画数量（指図展開時に固定した工順の値）。"]
                @L["実績＝直接作業時間＋段取り実績時間（いずれも終了済みの記録のみ）。"]
                @L["作業時間を記録していない作業指示は実績0分として並ぶ。"]
            </p>
        }
    </div>
}

@* 製造リードタイムの分布（ガイド 8.3.2）。平均では見えないばらつきと異常値を、完了した指図の分布で見る *@
<div class="card">
    <h2 style="margin-top:0;">@L["製造リードタイム"]</h2>
    <p class="text-muted">
        @L["完了した製造指図ごとに、最初の作業（段取り・実績の開始）から最後の実績の終了までを製造日で数える。期間は完了した製造日。リワーク指図は含めない。"]
    </p>
    @if (_leadTime is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_leadTime.OrderCount == 0)
    {
        <p class="text-muted">@L["対象期間に完了した製造指図はありません。"]</p>
    }
    else
    {
        <table class="table">
            <tbody>
                <tr>
                    <th>@L["完了した指図"]</th>
                    <td>@L["{0} 件", _leadTime.OrderCount]</td>
                    <th>@L["平均"]</th>
                    <td>@L["{0} 日", _leadTime.AverageDays!.Value.ToString("0.##")]</td>
                    <th>@L["中央値"]</th>
                    <td>@L["{0} 日", _leadTime.MedianDays!.Value.ToString("0.#")]</td>
                </tr>
                <tr>
                    <th>@L["90%点"]</th>
                    <td>@L["{0} 日", _leadTime.Percentile90Days!.Value]</td>
                    <th>@L["最大"]</th>
                    <td>@L["{0} 日", _leadTime.MaxDays!.Value]</td>
                    <th>@L["納期内 / 遅れ / 納期なし"]</th>
                    <td>@L["{0} 件 / {1} 件 / {2} 件", _leadTime.OnTimeCount, _leadTime.LateCount, _leadTime.NoDueDateCount]</td>
                </tr>
            </tbody>
        </table>
        <ComboChart Labels="@_leadTime.Distribution.Select(d => L["{0}日", d.Days].Value).ToList()"
                    Bars="@LeadTimeBars" BarUnit="@L["件"]" BarInteger="true"
                    AriaLabel="@L["製造リードタイムの分布"]" />
        <h3>@L["リードタイムの長い指図"]</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>@L["製造指図"]</th><th>@L["品目"]</th><th>@L["数量"]</th><th>@L["着手"]</th><th>@L["完了"]</th>
                    <th>@L["リードタイム"]</th><th>@L["納期"]</th><th>@L["遅れ"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _leadTime.Orders.Take(20))
                {
                    <tr>
                        <td><a href="manufacturing-orders/@row.ManufacturingOrderId">@row.OrderNo</a></td>
                        <td>@row.ProductCode @row.ProductName</td>
                        <td>@row.Quantity</td>
                        <td>@row.StartedOn.ToString("yyyy-MM-dd")</td>
                        <td>@row.CompletedOn.ToString("yyyy-MM-dd")</td>
                        <td>
                            @L["{0} 日", row.LeadTimeDays]
                            @if (row.IsOutlier)
                            {
                                <span class="badge badge-warning">@L["異常値"]</span>
                            }
                        </td>
                        <td>@(row.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="@(row.DelayDays > 0 ? "text-danger" : "")">
                            @(row.DelayDays is { } delay && delay > 0 ? L["{0} 日", delay].Value : "-")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_leadTime.OutlierThresholdDays is { } threshold)
        {
            <p class="text-muted">@L["異常値は第3四分位＋1.5×四分位範囲（{0} 日）を超えるもの。平均を押し上げている原因を個別に調べる対象。", threshold.ToString("0.#")]</p>
        }
    }
</div>

@code {
    private ProductivitySummaryResponse? _summary;
    private LeadTimeResponse? _leadTime;

    /// <summary>分布の棒（納期内・納期なしと、納期遅れを積み上げる）</summary>
    private List<ChartSeries> LeadTimeBars => _leadTime is null ? [] :
    [
        new(L["納期内・納期なし"], "var(--primary)", [.. _leadTime.Distribution.Select(d => (decimal?)(d.Count - d.LateCount))]),
        new(L["納期遅れ"], "var(--danger)", [.. _leadTime.Distribution.Select(d => (decimal?)d.LateCount)]),
    ];
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (_from is not null)
        {
            query.Add($"from={DateOnly.FromDateTime(_from.Value):yyyy-MM-dd}");
        }
        if (_to is not null)
        {
            query.Add($"to={DateOnly.FromDateTime(_to.Value):yyyy-MM-dd}");
        }
        var suffix = query.Count > 0 ? "?" + string.Join("&", query) : string.Empty;
        _summary = await Http.GetFromJsonAsync<ProductivitySummaryResponse>("api/productivity" + suffix);
        _leadTime = await Http.GetFromJsonAsync<LeadTimeResponse>("api/productivity/lead-time" + suffix);
    }
}
