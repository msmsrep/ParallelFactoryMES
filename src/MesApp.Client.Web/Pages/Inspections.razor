@page "/inspections"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["検査管理 - Parallel Factory MES"]</PageTitle>

<h1>@L["検査管理"]</h1>
<p class="text-muted">@L["受入／工程内／完成品／サンプル／再検査の進捗一覧・検査指示発行（C-20）。"]</p>

<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.QualityManage">
    <div class="card">
        <h2 style="margin-top:0;">@L["検査指示の発行（C-20-10-02）"]</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["検査種別"]</label>
                <select @bind="_type">
                    <option value="@InspectionOrderType.Receiving">@L["受入検査"]</option>
                    <option value="@InspectionOrderType.InProcess">@L["工程内検査"]</option>
                    <option value="@InspectionOrderType.FinalProduct">@L["完成品検査"]</option>
                    <option value="@InspectionOrderType.Sample">@L["サンプル検査"]</option>
                    <option value="@InspectionOrderType.Reinspection">@EnumLabels.Of(InspectionOrderType.Reinspection)</option>
                </select>
            </div>
            @if (_type == InspectionOrderType.InProcess)
            {
                <div class="form-field">
                    <label>@L["対象作業指示"]</label>
                    <OptionSelect TItem="WorkOrderResponse" Endpoint="api/work-orders/options"
                                  @bind-Value="_workOrderId"
                                  ValueOf="w => w.Id"
                                  LabelOf='@(w => L["{0}（{1}）", w.WorkOrderNo, w.ProductCode])' />
                </div>
            }
            <div class="form-field">
                <label>@L["対象ロット（スキャン可）"]</label>
                <ScanInput @bind-Value="_lotNumber" ShowSubmit="false" Placeholder="@L["ロットをスキャン"]" />
            </div>
            <div class="form-field">
                <label>@L["ロット選択"]</label>
                <OptionSelect TItem="StockResponse" Endpoint="api/inventory/stocks/options"
                              @bind-Value="_lotId" EmptyLabel="@L["（スキャン入力または選択）"]"
                              ValueOf="s => s.LotId"
                              LabelOf='@(s => L["{0}（{1}）", s.LotNumber, s.ProductCode])' />
            </div>
            <div class="form-field">
                <label>@L["備考"]</label>
                <input @bind="_note" />
            </div>
        </div>
        <p class="text-muted">@L["検査項目は種別・対象品目/工程に合致する検査基準から自動選択されます（C-10-10）。"]</p>
        <button class="btn" disabled="@_busy" @onclick="CreateAsync">@L["検査指示を発行"]</button>
    </div>
</AuthorizeView>

<div class="card">
    <h2 style="margin-top:0;">@L["検査進捗一覧（C-20-10-01）"]</h2>
    <select @bind="_statusFilter" @bind:after="LoadAsync" style="margin-bottom:8px;">
        <option value="">@L["全状態"]</option>
        <option value="Instructed">@L["指示"]</option>
        <option value="InProgress">@L["実施中"]</option>
        <option value="Judged">@L["判定済"]</option>
        <option value="Approved">@L["承認済"]</option>
        <option value="Canceled">@EnumLabels.Of(InspectionOrderStatus.Canceled)</option>
    </select>

    @if (_orders is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_orders.Total == 0)
    {
        <p class="text-muted">@L["検査指示はありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>@L["検査指示番号"]</th><th>@L["種別"]</th><th>@L["対象"]</th><th>@L["状態"]</th><th>@L["判定"]</th><th>@L["発行日"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var order in _orders.Items)
                {
                    <tr>
                        <td>@order.OrderNo</td>
                        <td>@EnumLabels.Of(order.Type)</td>
                        <td>@(order.TargetLotNumber ?? order.TargetWorkOrderNo ?? "-")</td>
                        <td><span class="badge @StatusClass(order.Status)">@EnumLabels.Of(order.Status)</span></td>
                        <td>
                            @if (order.OverallJudgment is InspectionJudgment judgment)
                            {
                                <span class="badge @(judgment == InspectionJudgment.Pass ? "badge-success" : "badge-danger")">
                                    @EnumLabels.Of(judgment)
                                </span>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td><a class="btn btn-secondary btn-sm" href="inspections/@order.Id">@L["詳細・実績入力"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager TItem="InspectionOrderResponse" Result="_orders" OnPageChanged="LoadPageAsync" />
    }
</div>

@code {
    private PagedResult<InspectionOrderResponse>? _orders;

    private InspectionOrderType _type = InspectionOrderType.FinalProduct;
    private int _lotId;
    private string? _lotNumber;
    private int _workOrderId;
    private string? _note;
    private string _statusFilter = string.Empty;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        var url = $"api/inspection-orders?page={page}";
        if (!string.IsNullOrEmpty(_statusFilter))
        {
            url += $"&status={_statusFilter}";
        }
        _orders = await Http.GetFromJsonAsync<PagedResult<InspectionOrderResponse>>(url);
    }

    /// <summary>スキャンしたロット番号から在庫のロットIDを引く（完全一致のみ。見つからなければ0）</summary>
    private async Task<int> ResolveLotIdAsync(string lotNumber)
    {
        var result = await Http.GetFromJsonAsync<OptionsResult<StockResponse>>(
            $"api/inventory/stocks/options?q={Uri.EscapeDataString(lotNumber)}");
        return result?.Items.FirstOrDefault(s =>
            string.Equals(s.LotNumber, lotNumber, StringComparison.OrdinalIgnoreCase))?.LotId ?? 0;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            // スキャン入力があればロット番号から対象ロットを解決する。
            // 在庫は全件を手元に持たないため、選択肢APIへ問い合わせて完全一致を探す
            var lotId = _lotId;
            if (lotId == 0 && !string.IsNullOrWhiteSpace(_lotNumber))
            {
                lotId = await ResolveLotIdAsync(_lotNumber.Trim());
                if (lotId == 0)
                {
                    _error = L["ロット '{0}' が見つかりません。", _lotNumber];
                    return;
                }
            }

            var response = await Http.PostAsJsonAsync("api/inspection-orders",
                new InspectionOrderCreateRequest(_type,
                    lotId == 0 ? null : lotId,
                    _workOrderId == 0 ? null : _workOrderId,
                    null, _note));
            if (await response.ReadErrorAsync(L["発行に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            var created = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _message = L["検査指示 {0} を発行しました（対象ロットは検査待ちになります）。", created?.OrderNo ?? ""];
            _lotNumber = null;
            _note = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }



    private static string StatusClass(InspectionOrderStatus status) => status switch
    {
        InspectionOrderStatus.Approved => "badge-success",
        InspectionOrderStatus.Judged => "badge-warning",
        InspectionOrderStatus.Canceled => "badge-danger",
        _ => "badge-info",
    };
}
