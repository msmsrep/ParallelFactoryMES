@page "/actual-csv"
@attribute [Authorize]
@inject HttpClient Http

@* 実績のCSV一括取込（Spec.md 3.8 実績のCSV一括取込。受入 D-10-10-02 ほか） *@
<PageTitle>@L["実績CSV取込 - Parallel Factory MES"]</PageTitle>

<h1>@L["実績CSV取込"]</h1>
<p class="text-muted">
    @L["試験・移行・教育用に、実績をCSVでまとめて登録します。"]
    @L["1件ずつ画面から登録したときと同じチェックを通り、在庫・ロットの状態・監査ログも同じように記録されます。"]
    @L["記録者は取り込んだユーザーです。"]
</p>

<Notice Error="@_error" />

<div class="card">
    <h2 style="margin-top:0;">@L["取り込む順番"]</h2>
    <p class="text-muted">
        @L["後の実績が前の実績を参照するため、上から順に取り込んでください。"]
        @L["作業指示は「指図番号＋工程順序」で、投入・検査するロットはロット番号で指します。"]
        @L["製造指図の指図番号と、後で投入するロットのロット番号は、CSVで指定しておいてください（自動採番の番号は取り込むまで分かりません）。"]
    </p>
    <p class="text-muted">
        <strong>@L["1行でもエラーがあると、そのファイル（ZIPの一括取込ではZIPの全ファイル）が取り消されます。"]</strong>
        @L["最初は「検証のみ」で確認してから取り込むと安全です。"]
        @L["書き方の見本は、リポジトリの {0} にあります（{1} のマスタを取り込んだ後に使えます）。", "samples/actual-csv", "samples/master-csv"]
    </p>
</div>

@if (_kinds is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    @* 取込欄はどれか1種別でも取り込めるロールに出す。ZIP内の全種別の可否はAPIが判定する *@
    <CsvBundlePanel BaseUrl="api/actuals/csv" Label="@L["実績"]" Example="01_receiving.csv"
                    Roles="@string.Join(",", _kinds.Select(k => k.WriteRoles).OfType<string>().Distinct())" />

    @foreach (var kind in _kinds)
    {
        <CsvIoPanel @key="kind.Kind" Kind="@kind.Kind" Label="@kind.Label" Info="@kind"
                    BaseUrl="api/actuals/csv" CanExport="false"
                    Roles="@(kind.WriteRoles ?? MesRoleGroups.UserAdmin)" />
    }
}

@code {
    private List<CsvKindInfo>? _kinds;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 並び順はAPIの定義順（＝取り込む順番）のまま出す
            _kinds = await Http.GetFromJsonAsync<List<CsvKindInfo>>("api/actuals/csv/kinds") ?? [];
        }
        catch (HttpRequestException)
        {
            _error = L["取込に対応する実績の種別を取得できませんでした。"];
            _kinds = [];
        }
    }
}
