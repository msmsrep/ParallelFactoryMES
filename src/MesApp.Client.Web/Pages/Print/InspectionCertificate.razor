@page "/print/inspection/{Id:int}"
@attribute [Authorize]
@inject HttpClient Http

@* 検査成績書（C-20-10-05） *@
<PageTitle>@L["検査成績書 - Parallel Factory MES"]</PageTitle>

@if (_order is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <PrintButton Label="@L["検査成績書を印刷 / PDF出力"]" />

    <div class="print-sheet">
        <h1>@L["検 査 成 績 書"]</h1>
        <table class="table">
            <tbody>
                <tr>
                    <th>@L["検査指示番号"]</th><td>@_order.OrderNo</td>
                    <th>@L["検査種別"]</th><td>@EnumLabels.Of(_order.Type)</td>
                </tr>
                <tr>
                    <th>@L["対象"]</th><td>@(_order.TargetLotNumber ?? _order.TargetWorkOrderNo ?? "-")</td>
                    <th>@L["発行日"]</th><td>@_order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                </tr>
                <tr>
                    <th>@L["総合判定"]</th>
                    <td>
                        @if (_order.OverallJudgment is InspectionJudgment judgment)
                        {
                            <strong>@EnumLabels.Of(judgment)</strong>
                        }
                        else
                        {
                            <text>@L["未判定"]</text>
                        }
                    </td>
                    <th>@L["判定日"]</th><td>@(_order.JudgedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
                <tr>
                    <th>@L["承認"]</th>
                    <td colspan="3">@(_order.ApprovedAt is null ? L["未承認"] : L["承認済（{0:yyyy-MM-dd}）", _order.ApprovedAt])</td>
                </tr>
            </tbody>
        </table>

        <h2>@L["検査結果"]</h2>
        <table class="table">
            <thead>
                <tr><th>@L["検査項目"]</th><th>@L["規格値（版）"]</th><th>@L["検査方法"]</th><th>@L["測定値"]</th><th>@L["判定"]</th><th>@L["検査機"]</th><th>@L["検査者"]</th><th>@L["検査日時"]</th></tr>
            </thead>
            <tbody>
                @foreach (var result in _order.Results)
                {
                    var item = _order.Items.FirstOrDefault(i => i.InspectionItemId == result.InspectionItemId);
                    <tr>
                        <td>@result.ItemCode @result.ItemName</td>
                        @* 規格値は指示発行時点のスナップショット。マスタを改訂しても当時の判定根拠が印字される *@
                        <td>
                            @(item?.LowerLimit?.ToString() ?? "-") 〜 @(item?.UpperLimit?.ToString() ?? "-")
                            @if (item is not null)
                            {
                                <span class="text-muted">@L["（第{0}版）", item.ItemVersion]</span>
                            }
                        </td>
                        <td>@(item?.Method ?? "-")</td>
                        <td>@(result.MeasuredValue?.ToString() ?? result.TextValue ?? "-")</td>
                        <td>@EnumLabels.Of(result.Judgment)</td>
                        @* 使用した検査機（C-20-50-03）。校正済みの機器で測ったことを成績書で示す *@
                        <td>@(result.InspectionDeviceCode ?? "-")</td>
                        <td>@result.InspectedByName</td>
                        <td>@result.InspectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>

        @* 訂正があった場合は、元の記録を残したまま訂正理由・訂正者を成績書に出す（C-20-50-07） *@
        @if (_order.Corrections.Count > 0)
        {
            <h2>@L["訂正履歴"]</h2>
            <table class="table">
                <thead>
                    <tr><th>@L["検査項目"]</th><th>@L["訂正前"]</th><th>@L["訂正後"]</th><th>@L["理由"]</th><th>@L["訂正者"]</th><th>@L["訂正日時"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var correction in _order.Corrections)
                    {
                        <tr>
                            <td>@correction.ItemCode @correction.ItemName</td>
                            <td>@(correction.BeforeMeasuredValue?.ToString() ?? correction.BeforeTextValue ?? "-")</td>
                            <td>@(correction.AfterMeasuredValue?.ToString() ?? correction.AfterTextValue ?? "-")</td>
                            <td>@correction.Reason</td>
                            <td>@(correction.CorrectedByName ?? "-")</td>
                            <td>@correction.CorrectedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_order.TargetLotNumber is not null)
        {
            <div class="barcode">@((MarkupString)Code39.ToSvg(_order.TargetLotNumber))</div>
            <div class="barcode-text">@_order.TargetLotNumber</div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InspectionOrderResponse? _order;

    protected override async Task OnParametersSetAsync() =>
        _order = await Http.GetFromJsonAsync<InspectionOrderResponse>($"api/inspection-orders/{Id}");
}
