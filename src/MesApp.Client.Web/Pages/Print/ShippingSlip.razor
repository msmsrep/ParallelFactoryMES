@page "/print/shipping/{Id:int}"
@attribute [Authorize]
@inject HttpClient Http

@* 出荷伝票（D-40-30-07） *@
<PageTitle>出荷伝票 - Parallel Factory MES</PageTitle>

@if (_order is null)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    <PrintButton Label="出荷伝票を印刷 / PDF出力" />

    <div class="print-sheet">
        <h1>出 荷 伝 票</h1>
        <table class="table">
            <tbody>
                <tr>
                    <th>出荷番号</th><td>@_order.ShippingNo</td>
                    <th>出荷先</th><td>@_order.Destination</td>
                </tr>
                <tr>
                    <th>出荷予定日</th><td>@(_order.PlannedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <th>出荷完了日</th><td>@(_order.ShippedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            </tbody>
        </table>

        <h2>出荷明細</h2>
        <table class="table">
            <thead><tr><th>品目コード</th><th>品目名</th><th>指示数量</th><th>出荷数量</th></tr></thead>
            <tbody>
                @foreach (var line in _order.Lines)
                {
                    <tr>
                        <td>@line.ProductCode</td>
                        <td>@line.ProductName</td>
                        <td>@line.Quantity</td>
                        <td>@line.ShippedQuantity</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2>受領確認欄</h2>
        <table class="table">
            <thead><tr><th>受領日</th><th>受領者署名</th></tr></thead>
            <tbody><tr><td>　</td><td>　</td></tr></tbody>
        </table>

        <div class="barcode">@((MarkupString)Code39.ToSvg(_order.ShippingNo))</div>
        <div class="barcode-text">@_order.ShippingNo</div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ShippingOrderResponse? _order;

    protected override async Task OnParametersSetAsync() =>
        _order = await Http.GetFromJsonAsync<ShippingOrderResponse>($"api/shipping-orders/{Id}");
}
