@page "/print/stocktake/{Id:int}"
@attribute [Authorize]
@inject HttpClient Http

@* 棚卸表（D-50-30-05） *@
<PageTitle>@L["棚卸表 - Parallel Factory MES"]</PageTitle>

@if (_stocktake is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <PrintButton Label="@L["棚卸表を印刷 / PDF出力"]" />

    <div class="print-sheet">
        <h1>@L["棚 卸 表"]</h1>
        <table class="table">
            <tbody>
                <tr>
                    <th>@L["棚卸番号"]</th><td>@_stocktake.StocktakeNo</td>
                    <th>@L["作成日"]</th><td>@_stocktake.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                </tr>
                <tr>
                    <th>@L["状態"]</th><td>@EnumLabels.Of(_stocktake.Status)</td>
                    <th>@L["確定日"]</th><td>@(_stocktake.FinalizedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            </tbody>
        </table>

        <table class="table">
            <thead>
                <tr><th>@L["ロット番号"]</th><th>@L["品目"]</th><th>@L["ロケーション"]</th><th>@L["理論数量"]</th><th>@L["実棚数量"]</th><th>@L["差異"]</th></tr>
            </thead>
            <tbody>
                @foreach (var line in _stocktake.Lines)
                {
                    <tr>
                        <td>@line.LotNumber</td>
                        <td>@line.ProductCode @line.ProductName</td>
                        <td>@line.LocationCode</td>
                        <td>@line.TheoreticalQuantity</td>
                        <td>@(line.CountedQuantity?.ToString() ?? "　")</td>
                        <td>@(line.Difference?.ToString() ?? "　")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private StocktakeResponse? _stocktake;

    protected override async Task OnParametersSetAsync() =>
        _stocktake = await Http.GetFromJsonAsync<StocktakeResponse>($"api/stocktakes/{Id}");
}
