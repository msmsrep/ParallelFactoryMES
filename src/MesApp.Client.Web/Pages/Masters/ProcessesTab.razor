@inject HttpClient Http

@* 工程マスタ（Spec.md 5.1 Process） *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MasterWrite">
    <div class="card">
        <h2 style="margin-top:0;">@(_editingId is null ? L["工程の登録"] : L["工程の編集（ID {0}）", _editingId])</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["工程コード"]</label>
                <input @bind="_code" />
            </div>
            <div class="form-field">
                <label>@L["工程名"]</label>
                <input @bind="_name" />
            </div>
            <div class="form-field">
                <label>@L["工程区分"]</label>
                <select @bind="_category">
                    <option value="@MakeOrBuy.InHouse">@EnumLabels.Of(MakeOrBuy.InHouse)</option>
                    <option value="@MakeOrBuy.Outsourced">@EnumLabels.Of(MakeOrBuy.Outsourced)</option>
                </select>
            </div>
        </div>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
            }
        </div>
    </div>
</AuthorizeView>

<CsvIoPanel Kind="processes" Label="@L["工程"]" KeyLabel="@L["工程コード"]" OnImported="LoadAsync" />

<div class="card">
    @if (_items is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>@L["コード"]</th><th>@L["工程名"]</th><th>@L["区分"]</th><th>@L["状態"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@EnumLabels.Of(item.Category)</td>
                        <td>@(item.IsActive ? L["有効"] : L["無効"])</td>
                        <td class="actions">
                            <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="pm">
                                <button class="btn btn-secondary btn-sm" @onclick="() => Edit(item)">@L["編集"]</button>
                                @if (item.IsActive)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeactivateAsync(item.Id)">@L["無効化"]</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ProcessResponse>? _items;
    private int? _editingId;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private MakeOrBuy _category = MakeOrBuy.InHouse;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _items = await Http.GetFromJsonAsync<List<ProcessResponse>>("api/processes?includeInactive=true");

    private void Edit(ProcessResponse item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _category = item.Category;
    }

    private void ResetForm()
    {
        _editingId = null;
        _code = string.Empty;
        _name = string.Empty;
        _category = MakeOrBuy.InHouse;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            _error = L["工程コードと工程名を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new ProcessRequest(_code, _name, _category);
            var response = _editingId is null
                ? await Http.PostAsJsonAsync("api/processes", request)
                : await Http.PutAsJsonAsync($"api/processes/{_editingId}", request);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.DeleteAsync($"api/processes/{id}");
            if (await response.ReadErrorAsync(L["無効化に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["無効化しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
