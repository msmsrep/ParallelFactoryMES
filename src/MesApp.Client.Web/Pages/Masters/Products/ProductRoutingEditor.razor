@inject HttpClient Http

@* 品目の工順（BOP）（Spec.md 5.1、A-40-20）。品目マスタタブで選んだ品目に対して開く *@
<div class="card">
    <h2 style="margin-top:0;">@Product.Code の 工順（BOP。A-40-20）</h2>
    <Notice Error="@_error" Message="@_message" />
    <table class="table">
        <thead>
            <tr><th>順序</th><th>工程</th><th>標準作業(分)</th><th>標準段取(分)</th><th>必要スキル</th><th>候補設備</th><th>治工具</th><th>チェックリスト</th><th>管理項目</th><th>作業手順書</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var step in _steps.OrderBy(s => s.Sequence))
            {
                <tr>
                    <td>@step.Sequence</td>
                    <td>@(_processes.FirstOrDefault(p => p.Id == step.ProcessId)?.Code)</td>
                    <td>@step.StandardWorkMinutes</td>
                    <td>@step.StandardSetupMinutes</td>
                    <td>@(_skills.FirstOrDefault(s => s.Id == step.RequiredSkillId)?.Name ?? "-")</td>
                    <td>@CandidateLabel(step)</td>
                    <td>@(_tools.FirstOrDefault(t => t.Id == step.ToolId)?.Code ?? "-")</td>
                    <td>@(_checklists.FirstOrDefault(c => c.Id == step.ChecklistId)?.Code ?? "-")</td>
                    <td>@(step.ControlItems ?? "-")</td>
                    <td>@(_workProcedures.FirstOrDefault(w => w.Id == step.WorkProcedureId)?.ProcedureNo ?? "-")</td>
                    <td><button class="btn btn-danger btn-sm" @onclick="() => _steps.Remove(step)">削除</button></td>
                </tr>
            }
        </tbody>
    </table>
    <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="routing">
        <div class="form-grid">
            <div class="form-field">
                <label>工程順序</label>
                <input type="number" @bind="_sequence" />
            </div>
            <div class="form-field">
                <label>工程</label>
                <select @bind="_processId">
                    <option value="0">選択してください</option>
                    @foreach (var process in _processes)
                    {
                        <option value="@process.Id">@process.Code @process.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>標準作業時間(分)</label>
                <input type="number" step="any" @bind="_work" />
            </div>
            <div class="form-field">
                <label>標準段取り時間(分)</label>
                <input type="number" step="any" @bind="_setup" />
            </div>
            <div class="form-field">
                <label>必要スキル・資格</label>
                <select @bind="_skillId">
                    <option value="0">なし</option>
                    @foreach (var skill in _skills)
                    {
                        <option value="@skill.Id">@skill.Code @skill.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                @* 候補設備（B-10-20-02）。複数選ぶと差立でその中から選ばせる。空なら限定しない *@
                <label>候補設備（Ctrl/Shiftで複数選択）</label>
                <select multiple size="4" @onchange="OnCandidatesChanged">
                    @foreach (var equipment in _equipments)
                    {
                        <option value="@equipment.Id" selected="@_equipmentIds.Contains(equipment.Id)">
                            @equipment.AssetNo @equipment.Name
                        </option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>作業区</label>
                <select @bind="_workCenterId">
                    <option value="0">なし</option>
                    @foreach (var wc in _workCenters)
                    {
                        <option value="@wc.Id">@wc.Code @wc.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>使用治工具</label>
                <select @bind="_toolId">
                    <option value="0">なし</option>
                    @foreach (var tool in _tools)
                    {
                        <option value="@tool.Id">@tool.Code @tool.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>チェックリスト</label>
                <select @bind="_checklistId">
                    <option value="0">なし</option>
                    @foreach (var checklist in _checklists)
                    {
                        <option value="@checklist.Id">@checklist.Code @checklist.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>工程管理項目</label>
                <input @bind="_controlItems" placeholder="例：温度、回転数" />
            </div>
            <div class="form-field">
                @* 作業手順書の紐付け（I-30-20-12）。作業者は作業指示からこれを辿る *@
                <label>作業手順書（SOP）</label>
                <select @bind="_workProcedureId">
                    <option value="0">なし</option>
                    @foreach (var procedure in _workProcedures)
                    {
                        <option value="@procedure.Id">@procedure.ProcedureNo @procedure.Title（v@(procedure.Version)）</option>
                    }
                </select>
            </div>
        </div>
        <div class="actions">
            <button class="btn btn-secondary" @onclick="AddStep">工程を追加</button>
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">工順を保存（一括置換）</button>
        </div>
    </AuthorizeView>
</div>

@code {
    /// <summary>編集対象の品目。切り替わったら工順を読み直す</summary>
    [Parameter, EditorRequired] public ProductResponse Product { get; set; } = default!;

    /// <summary>保存後に親へ知らせる（設計変更の影響を読み直すため）</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private List<ProcessResponse> _processes = [];
    private List<SkillResponse> _skills = [];
    private List<EquipmentResponse> _equipments = [];
    private List<ToolResponse> _tools = [];
    private List<ChecklistResponse> _checklists = [];
    private List<WorkProcedureResponse> _workProcedures = [];
    /// <summary>工順の作業区は最下段のみ（Spec.md 5.7 資源階層への紐付け）</summary>
    private List<WorkCenterResponse> _workCenters = [];

    private readonly List<RoutingStepRequest> _steps = [];
    private int _loadedProductId;

    private int _sequence = 1;
    private int _processId;
    private decimal _work;
    private decimal _setup;
    private int _skillId;
    /// <summary>候補設備（B-10-20-02）。画面ではこちらに一本化する（代表設備はCSV・既存データの移行用）</summary>
    private readonly List<int> _equipmentIds = [];
    private int _toolId;
    private int _checklistId;
    private int _workProcedureId;
    private int _workCenterId;
    private string? _controlItems;

    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _processes = await Http.GetFromJsonAsync<List<ProcessResponse>>("api/processes") ?? [];
        _skills = await Http.GetFromJsonAsync<List<SkillResponse>>("api/skills") ?? [];
        _equipments = await Http.GetFromJsonAsync<List<EquipmentResponse>>("api/equipments") ?? [];
        _tools = await Http.GetFromJsonAsync<List<ToolResponse>>("api/tools") ?? [];
        _checklists = await Http.GetFromJsonAsync<List<ChecklistResponse>>("api/checklists") ?? [];
        _workProcedures = await Http.GetFromJsonAsync<List<WorkProcedureResponse>>("api/work-procedures") ?? [];
        _workCenters = await Http.GetFromJsonAsync<List<WorkCenterResponse>>(
            $"api/work-centers?level={WorkCenterLevel.WorkCenter}") ?? [];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProductId != Product.Id)
        {
            await ReloadAsync();
        }
    }

    /// <summary>工順を読み直す（品目の切り替えとCSV取込の後に呼ばれる）</summary>
    public async Task ReloadAsync()
    {
        _loadedProductId = Product.Id;
        _steps.Clear();
        var routing = await Http.GetFromJsonAsync<List<RoutingStepResponse>>(
            $"api/products/{Product.Id}/routing") ?? [];
        _steps.AddRange(routing.Select(r => new RoutingStepRequest(
            r.Sequence, r.ProcessId, r.StandardWorkMinutes, r.StandardSetupMinutes,
            r.RequiredSkillId, r.EquipmentId, r.ToolId, r.ControlItems, r.ChecklistId,
            r.WorkCenterId, r.EquipmentIds, r.WorkProcedureId)));
        _sequence = _steps.Count == 0 ? 1 : _steps.Max(s => s.Sequence) + 1;
    }

    private void AddStep()
    {
        if (_processId == 0)
        {
            _error = "工程を選択してください。";
            return;
        }
        if (_steps.Any(s => s.Sequence == _sequence))
        {
            _error = "工程順序が重複しています。";
            return;
        }
        _error = null;
        _steps.Add(new RoutingStepRequest(_sequence, _processId, _work, _setup,
            _skillId == 0 ? null : _skillId,
            null,
            _toolId == 0 ? null : _toolId,
            string.IsNullOrWhiteSpace(_controlItems) ? null : _controlItems,
            _checklistId == 0 ? null : _checklistId,
            _workCenterId == 0 ? null : _workCenterId,
            _equipmentIds.Count == 0 ? null : [.. _equipmentIds],
            _workProcedureId == 0 ? null : _workProcedureId));
        _sequence = _steps.Max(s => s.Sequence) + 1;
        _controlItems = null;
        _equipmentIds.Clear();
    }

    /// <summary>複数選択の設備一覧から候補を取り込む</summary>
    private void OnCandidatesChanged(ChangeEventArgs e)
    {
        _equipmentIds.Clear();
        foreach (var value in (string[])(e.Value ?? Array.Empty<string>()))
        {
            if (int.TryParse(value, out var id))
            {
                _equipmentIds.Add(id);
            }
        }
    }

    /// <summary>一覧に出す候補設備の表示（多いときは件数で省略する）</summary>
    private string CandidateLabel(RoutingStepRequest step)
    {
        var ids = step.EquipmentIds ?? (step.EquipmentId is { } single ? [single] : []);
        if (ids.Count == 0)
        {
            return "-";
        }
        var codes = ids
            .Select(id => _equipments.FirstOrDefault(e => e.Id == id)?.AssetNo)
            .Where(code => code is not null)
            .ToList();
        return codes.Count <= 3 ? string.Join("、", codes) : $"{string.Join("、", codes.Take(3))} ほか{codes.Count - 3}件";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/products/{Product.Id}/routing", _steps);
            if (await response.ReadErrorAsync("保存に失敗しました。") is { } error)
            {
                _error = error;
                return;
            }
            _message = "工順（BOP）を保存しました。";
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
