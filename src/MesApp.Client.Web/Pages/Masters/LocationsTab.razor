@inject HttpClient Http

@* ロケーションマスタ（Spec.md 5.1 Location。D-50-20-01 棚番号・ロケーション管理） *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MasterWrite">
    <div class="card">
        <h2 style="margin-top:0;">@(_editingId is null ? L["ロケーションの登録"] : L["ロケーションの編集（{0}）", _code])</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["ロケーションコード"]</label>
                <input @bind="_code" />
            </div>
            <div class="form-field">
                <label>@L["倉庫/エリア区分"]</label>
                <select @bind="_areaType">
                    <option value="@LocationAreaType.MaterialWarehouse">@EnumLabels.Of(LocationAreaType.MaterialWarehouse)</option>
                    <option value="@LocationAreaType.InProcess">@EnumLabels.Of(LocationAreaType.InProcess)</option>
                    <option value="@LocationAreaType.ProductWarehouse">@EnumLabels.Of(LocationAreaType.ProductWarehouse)</option>
                    <option value="@LocationAreaType.ShippingArea">@EnumLabels.Of(LocationAreaType.ShippingArea)</option>
                </select>
            </div>
            <div class="form-field">
                <label>@L["所属する作業区"]</label>
                <select @bind="_workCenterId">
                    <option value="0">@L["なし"]</option>
                    @foreach (var wc in _workCenters ?? [])
                    {
                        <option value="@wc.Id">@wc.Code @wc.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>@L["棚番"]</label>
                <input @bind="_shelfNo" />
            </div>
        </div>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
            }
        </div>
    </div>
</AuthorizeView>

<CsvIoPanel Kind="locations" Label="@L["ロケーション"]" KeyLabel="@L["ロケーションコード"]" OnImported="LoadAsync" />

<div class="card">
    @if (_items is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>@L["コード"]</th><th>@L["区分"]</th><th>@L["作業区"]</th><th>@L["棚番"]</th><th>@L["状態"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@EnumLabels.Of(item.AreaType)</td>
                        <td>@(item.WorkCenterCode is null ? "-" : $"{item.WorkCenterCode} {item.WorkCenterName}")</td>
                        <td>@(item.ShelfNo ?? "-")</td>
                        <td>@(item.IsActive ? L["有効"] : L["無効"])</td>
                        <td class="actions">
                            <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="pm">
                                <button class="btn btn-secondary btn-sm" @onclick="() => Edit(item)">@L["編集"]</button>
                                @if (item.IsActive)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeactivateAsync(item.Id)">@L["無効化"]</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<LocationResponse>? _items;
    private int? _editingId;
    private string _code = string.Empty;
    private LocationAreaType _areaType = LocationAreaType.MaterialWarehouse;
    private string? _shelfNo;
    private int _workCenterId;
    /// <summary>倉庫は工場直下に置かれることがあるため、段を問わず全件から選ばせる（Spec.md 5.1 Location）</summary>
    private List<WorkCenterResponse>? _workCenters;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _items = await Http.GetFromJsonAsync<List<LocationResponse>>("api/locations?includeInactive=true");
        _workCenters = await Http.GetFromJsonAsync<List<WorkCenterResponse>>("api/work-centers");
    }

    private void Edit(LocationResponse item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _areaType = item.AreaType;
        _shelfNo = item.ShelfNo;
        _workCenterId = item.WorkCenterId ?? 0;
    }

    private void ResetForm()
    {
        _editingId = null;
        _code = string.Empty;
        _areaType = LocationAreaType.MaterialWarehouse;
        _shelfNo = null;
        _workCenterId = 0;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            _error = L["ロケーションコードを入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new LocationRequest(_code, _areaType, _shelfNo, _workCenterId == 0 ? null : _workCenterId);
            var response = _editingId is null
                ? await Http.PostAsJsonAsync("api/locations", request)
                : await Http.PutAsJsonAsync($"api/locations/{_editingId}", request);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.DeleteAsync($"api/locations/{id}");
            if (await response.ReadErrorAsync(L["無効化に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["無効化しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

}
