@inject HttpClient Http

@* ユーザー/工場従業員管理（F-10-10）とスキル・資格の割当（F-20-10-02〜05）。システム管理者専用 *@
<AuthorizeView Roles="@MesRoleGroups.UserAdmin">
    <NotAuthorized>
        <div class="card">
            <p class="text-muted">@L["ユーザー管理はシステム管理者のみ利用できます。"]</p>
        </div>
    </NotAuthorized>
    <Authorized>
        <Notice Error="@_error" Message="@_message" />

        <div class="card">
            <h2 style="margin-top:0;">@(_editingId is null ? L["ユーザーの登録"] : L["ユーザーの編集（{0}）", _userName])</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label>@L["ユーザー名"]</label>
                    <input @bind="_userName" disabled="@(_editingId is not null)" />
                </div>
                <div class="form-field">
                    <label>@L["氏名（表示名）"]</label>
                    <input @bind="_displayName" />
                </div>
                @if (_editingId is null)
                {
                    <div class="form-field">
                        <label>@L["初期パスワード（初回ログイン時に変更を強制）"]</label>
                        <input type="password" @bind="_password" autocomplete="new-password" />
                    </div>
                }
                else
                {
                    <div class="form-field">
                        <label>
                            <input type="checkbox" style="width:auto;" @bind="_isActive" />
                            @L["在籍（無効化するとログイン不可）"]
                        </label>
                    </div>
                }
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label>@L["作業場所（作業区）"]</label>
                    <select @bind="_workCenterId">
                        <option value="0">@L["なし"]</option>
                        @foreach (var wc in _workCenters)
                        {
                            <option value="@wc.Id">@wc.Code @wc.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>@L["所属（部署・課）"]</label>
                    <input @bind="_department" placeholder="@L["例：第1製造課"]" />
                </div>
                <div class="form-field">
                    @* 所属する直（F-10-10-01）。実績の直は記録時刻から引くので、ここは既定の所属 *@
                    <label>@L["所属する直"]</label>
                    <select @bind="_shiftId">
                        <option value="0">@L["なし"]</option>
                        @foreach (var shift in _shifts)
                        {
                            <option value="@shift.Id">@shift.Code @shift.Name (@shift.ScheduleLabel)</option>
                        }
                    </select>
                </div>
            </div>

            <h2>@L["ロール"]</h2>
            <div class="form-grid">
                @foreach (var role in MesRoles.All)
                {
                    <div class="form-field">
                        <label>
                            <input type="checkbox" style="width:auto;" checked="@_roles.Contains(role)"
                                   @onchange="e => ToggleRole(role, (bool)(e.Value ?? false))" />
                            @EnumLabels.Role(role)
                        </label>
                    </div>
                }
            </div>

            <div class="actions mt-2">
                <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
                @if (_editingId is not null)
                {
                    <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
                }
            </div>
        </div>

        <CsvIoPanel Kind="users" Label="@L["ユーザー"]" KeyLabel="@L["ユーザー名"]"
                    Roles="@MesRoleGroups.UserAdmin" OnImported="LoadAsync" />
        <CsvIoPanel Kind="user-skills" Label="@L["ユーザーのスキル・資格"]" KeyLabel="@L["ユーザー名＋スキル・資格コード"]"
                    Roles="@MesRoleGroups.UserAdmin" OnImported="ReloadSkillsAsync" />

        <div class="card">
            @if (_users is null)
            {
                <p class="text-muted">@L["読み込み中..."]</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>@L["ユーザー名"]</th><th>@L["氏名"]</th><th>@L["所属"]</th><th>@L["作業場所"]</th><th>@L["直"]</th><th>@L["ロール"]</th><th>@L["在籍"]</th><th>@L["パスワード"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.DisplayName</td>
                                <td>@(user.Department ?? "-")</td>
                                <td>@(user.WorkCenterCode is null ? "-" : $"{user.WorkCenterCode} {user.WorkCenterName}")</td>
                                <td>@(user.ShiftCode is null ? "-" : $"{user.ShiftCode} {user.ShiftName}")</td>
                                <td>@string.Join(L["、"], user.Roles.Select(EnumLabels.Role))</td>
                                <td>@(user.IsActive ? L["在籍"] : L["無効"])</td>
                                <td>@(user.MustChangePassword ? L["要変更"] : "-")</td>
                                <td class="actions">
                                    <button class="btn btn-secondary btn-sm" @onclick="() => Edit(user)">@L["編集"]</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => SelectSkillsAsync(user)">@L["スキル・資格"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_skillTarget is not null)
        {
            <div class="card">
                <h2 style="margin-top:0;">@L["{0} のスキル・資格（F-20-10）", _skillTarget.DisplayName]</h2>
                <table class="table">
                    <thead><tr><th>@L["スキル・資格"]</th><th>@L["取得日"]</th><th>@L["有効期限"]</th><th>@L["状態"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var line in _userSkills)
                        {
                            var skill = _skills.FirstOrDefault(s => s.Id == line.SkillId);
                            <tr>
                                <td>@skill?.Code @skill?.Name</td>
                                <td>@(line.AcquiredOn?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(line.ExpiresOn?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>
                                    @if (line.ExpiresOn is not null && line.ExpiresOn < DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="badge badge-danger">@L["期限切れ"]</span>
                                    }
                                    else if (line.ExpiresOn is not null
                                             && line.ExpiresOn < DateOnly.FromDateTime(DateTime.Today.AddDays(30)))
                                    {
                                        <span class="badge badge-warning">@L["期限接近"]</span>
                                    }
                                    else
                                    {
                                        <text>@L["有効"]</text>
                                    }
                                </td>
                                <td><button class="btn btn-danger btn-sm" @onclick="() => _userSkills.Remove(line)">@L["削除"]</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="form-grid">
                    <div class="form-field">
                        <label>@L["スキル・資格"]</label>
                        <select @bind="_newSkillId">
                            <option value="0">@L["選択してください"]</option>
                            @foreach (var skill in _skills)
                            {
                                <option value="@skill.Id">@skill.Code @skill.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>@L["取得日"]</label>
                        <input type="date" @bind="_newAcquiredOn" />
                    </div>
                    <div class="form-field">
                        <label>@L["有効期限"]</label>
                        <input type="date" @bind="_newExpiresOn" />
                    </div>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary" @onclick="AddSkill">@L["追加"]</button>
                    <button class="btn" disabled="@_busy" @onclick="SaveSkillsAsync">@L["スキルを保存（一括置換）"]</button>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private List<UserSummaryResponse>? _users;
    private List<SkillResponse> _skills = [];
    private readonly List<string> _roles = [];

    private string? _editingId;
    private string _userName = string.Empty;
    private string _displayName = string.Empty;
    private string _password = string.Empty;
    private bool _isActive = true;
    private int _workCenterId;
    /// <summary>作業場所は段を問わない（Spec.md 5.7 資源階層への紐付け）</summary>
    private List<WorkCenterResponse> _workCenters = [];
    private string? _department;
    private int _shiftId;
    private List<ShiftResponse> _shifts = [];

    private UserSummaryResponse? _skillTarget;
    private readonly List<UserSkillRequest> _userSkills = [];
    private int _newSkillId;
    private DateTime? _newAcquiredOn;
    private DateTime? _newExpiresOn;

    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _skills = await Http.GetFromJsonAsync<List<SkillResponse>>("api/skills") ?? [];
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            // 管理者以外は取得できない
        }
    }

    private async Task LoadAsync()
    {
        _users = await Http.GetFromJsonAsync<List<UserSummaryResponse>>("api/users?includeInactive=true");
        _workCenters = await Http.GetFromJsonAsync<List<WorkCenterResponse>>("api/work-centers") ?? [];
        _shifts = await Http.GetFromJsonAsync<List<ShiftResponse>>("api/shifts") ?? [];
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            if (!_roles.Contains(role))
            {
                _roles.Add(role);
            }
        }
        else
        {
            _roles.Remove(role);
        }
    }

    private void Edit(UserSummaryResponse user)
    {
        _editingId = user.Id;
        _userName = user.UserName;
        _displayName = user.DisplayName;
        _isActive = user.IsActive;
        _workCenterId = user.WorkCenterId ?? 0;
        _department = user.Department;
        _shiftId = user.ShiftId ?? 0;
        _roles.Clear();
        _roles.AddRange(user.Roles);
    }

    private void ResetForm()
    {
        _editingId = null;
        _userName = string.Empty;
        _displayName = string.Empty;
        _password = string.Empty;
        _isActive = true;
        _workCenterId = 0;
        _department = null;
        _shiftId = 0;
        _roles.Clear();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _error = L["氏名を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            HttpResponseMessage response;
            if (_editingId is null)
            {
                if (string.IsNullOrWhiteSpace(_userName) || string.IsNullOrEmpty(_password))
                {
                    _error = L["ユーザー名と初期パスワードを入力してください。"];
                    return;
                }
                response = await Http.PostAsJsonAsync("api/users",
                    new CreateUserRequest(_userName, _password, _displayName, [.. _roles],
                        _workCenterId == 0 ? null : _workCenterId,
                        string.IsNullOrWhiteSpace(_department) ? null : _department,
                        _shiftId == 0 ? null : _shiftId));
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/users/{_editingId}",
                    new UpdateUserRequest(_displayName, [.. _roles], _isActive,
                        _workCenterId == 0 ? null : _workCenterId,
                        string.IsNullOrWhiteSpace(_department) ? null : _department,
                        _shiftId == 0 ? null : _shiftId));
            }

            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>CSV取込後、表示中のユーザーのスキル・資格を読み直す</summary>
    private async Task ReloadSkillsAsync()
    {
        if (_skillTarget is not null)
        {
            await SelectSkillsAsync(_skillTarget);
        }
    }

    private async Task SelectSkillsAsync(UserSummaryResponse user)
    {
        _skillTarget = user;
        _userSkills.Clear();
        var skills = await Http.GetFromJsonAsync<List<UserSkillResponse>>($"api/users/{user.Id}/skills") ?? [];
        _userSkills.AddRange(skills.Select(s => new UserSkillRequest(s.SkillId, s.AcquiredOn, s.ExpiresOn)));
    }

    private void AddSkill()
    {
        if (_newSkillId == 0)
        {
            _error = L["スキル・資格を選択してください。"];
            return;
        }
        if (_userSkills.Any(s => s.SkillId == _newSkillId))
        {
            _error = L["同一スキルが既に登録されています。"];
            return;
        }
        _error = null;
        _userSkills.Add(new UserSkillRequest(_newSkillId,
            _newAcquiredOn is null ? null : DateOnly.FromDateTime(_newAcquiredOn.Value),
            _newExpiresOn is null ? null : DateOnly.FromDateTime(_newExpiresOn.Value)));
        _newSkillId = 0;
    }

    private async Task SaveSkillsAsync()
    {
        if (_skillTarget is null)
        {
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/users/{_skillTarget.Id}/skills", _userSkills);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["スキル・資格を保存しました。"];
        }
        finally
        {
            _busy = false;
        }
    }

}
