@inject HttpClient Http

@* 不良理由マスタ（Spec.md 5.1 DefectReason。C-40-10-01 不良項目別分析） *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MasterWrite">
    <div class="card">
        <h2 style="margin-top:0;">@(_editingId is null ? L["不良理由の登録"] : L["不良理由の編集（{0}）", _code])</h2>
        <p class="text-muted">
            @L["粒度は「現場が迷わず選べて、集計にも使える」範囲で定義する（細かすぎると選べず、粗すぎると改善に使えない）。"]
        </p>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["不良理由コード"]</label>
                <input @bind="_code" />
            </div>
            <div class="form-field">
                <label>@L["不良理由名"]</label>
                <input @bind="_name" />
            </div>
            <div class="form-field">
                <label>@L["区分"]</label>
                <select @bind="_category">
                    <option value="@DefectReasonCategory.Material">@EnumLabels.Of(DefectReasonCategory.Material)</option>
                    <option value="@DefectReasonCategory.Process">@EnumLabels.Of(DefectReasonCategory.Process)</option>
                    <option value="@DefectReasonCategory.Equipment">@EnumLabels.Of(DefectReasonCategory.Equipment)</option>
                    <option value="@DefectReasonCategory.Human">@EnumLabels.Of(DefectReasonCategory.Human)</option>
                    <option value="@DefectReasonCategory.Other">@EnumLabels.Of(DefectReasonCategory.Other)</option>
                </select>
            </div>
        </div>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
            }
        </div>
    </div>
</AuthorizeView>

<CsvIoPanel Kind="defect-reasons" Label="@L["不良理由"]" KeyLabel="@L["不良理由コード"]" OnImported="LoadAsync" />

<div class="card">
    @if (_items is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>@L["コード"]</th><th>@L["不良理由名"]</th><th>@L["区分"]</th><th>@L["状態"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@EnumLabels.Of(item.Category)</td>
                        <td>@(item.IsActive ? L["有効"] : L["無効"])</td>
                        <td class="actions">
                            <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="pm">
                                <button class="btn btn-secondary btn-sm" @onclick="() => Edit(item)">@L["編集"]</button>
                                @if (item.IsActive)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeactivateAsync(item.Id)">@L["無効化"]</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DefectReasonResponse>? _items;
    private int? _editingId;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private DefectReasonCategory _category = DefectReasonCategory.Process;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _items = await Http.GetFromJsonAsync<List<DefectReasonResponse>>("api/defect-reasons?includeInactive=true");

    private void Edit(DefectReasonResponse item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _category = item.Category;
    }

    private void ResetForm()
    {
        _editingId = null;
        _code = string.Empty;
        _name = string.Empty;
        _category = DefectReasonCategory.Process;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            _error = L["不良理由コードと不良理由名を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new DefectReasonRequest(_code, _name, _category);
            var response = _editingId is null
                ? await Http.PostAsJsonAsync("api/defect-reasons", request)
                : await Http.PutAsJsonAsync($"api/defect-reasons/{_editingId}", request);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.DeleteAsync($"api/defect-reasons/{id}");
            if (await response.ReadErrorAsync(L["無効化に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["無効化しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
