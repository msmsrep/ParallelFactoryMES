@inject HttpClient Http

@* 勤務シフト（直）マスタ（Spec.md 5.1 Shift。F-10-10-01） *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MasterWrite">
    <div class="card">
        <h2 style="margin-top:0;">@(_editingId is null ? L["直の登録"] : L["編集（{0}）", _code])</h2>
        <p class="text-muted">
            @L["昼勤・夜勤などの時間帯を定義する。終了時刻が開始時刻以下なら翌日にまたぐ夜勤として扱う。"]
            @L["時間帯が重なる直は登録できない（重なると実績がどの直か決まらないため）。"]
            @L["製造日の境界時刻をまたぐ直は登録できるが、実績が2つの製造日へ分かれるため警告を出す。"]
        </p>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["シフトコード"]</label>
                <input @bind="_code" placeholder="@L["D / N など"]" />
            </div>
            <div class="form-field">
                <label>@L["名称"]</label>
                <input @bind="_name" placeholder="@L["昼勤 / 夜勤"]" />
            </div>
            <div class="form-field">
                <label>@L["開始時刻"]</label>
                <input type="time" @bind="_startTime" />
            </div>
            <div class="form-field">
                <label>@L["終了時刻"]</label>
                <input type="time" @bind="_endTime" />
            </div>
        </div>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
            }
        </div>
    </div>
</AuthorizeView>

<CsvIoPanel Kind="shifts" Label="@L["勤務シフト（直）"]" KeyLabel="@L["シフトコード"]" OnImported="LoadAsync" />

<div class="card">
    @if (_items is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>@L["コード"]</th><th>@L["名称"]</th><th>@L["時間帯"]</th><th>@L["日跨ぎ"]</th><th>@L["状態"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>
                            @item.ScheduleLabel
                            @if (item.BoundaryWarning is not null)
                            {
                                @* 拒否はしないので、運用中も気づけるよう一覧に出し続ける *@
                                <span class="badge badge-warning" title="@item.BoundaryWarning">@L["製造日境界またぎ"]</span>
                            }
                        </td>
                        <td>@(item.CrossesMidnight ? L["あり（夜勤）"] : "-")</td>
                        <td>@(item.IsActive ? L["有効"] : L["無効"])</td>
                        <td class="actions">
                            <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="sh">
                                <button class="btn btn-secondary btn-sm" @onclick="() => Edit(item)">@L["編集"]</button>
                                @if (item.IsActive)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeactivateAsync(item.Id)">@L["無効化"]</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ShiftResponse>? _items;

    private int? _editingId;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private TimeOnly _startTime = new(8, 30);
    private TimeOnly _endTime = new(17, 30);
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _items = await Http.GetFromJsonAsync<List<ShiftResponse>>("api/shifts?includeInactive=true");

    private void Edit(ShiftResponse item)
    {
        _editingId = item.Id;
        _code = item.Code;
        _name = item.Name;
        _startTime = item.StartTime;
        _endTime = item.EndTime;
    }

    private void ResetForm()
    {
        _editingId = null;
        _code = string.Empty;
        _name = string.Empty;
        _startTime = new TimeOnly(8, 30);
        _endTime = new TimeOnly(17, 30);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            _error = L["シフトコードと名称を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new ShiftRequest(_code, _name, _startTime, _endTime);
            var response = _editingId is null
                ? await Http.PostAsJsonAsync("api/shifts", request)
                : await Http.PutAsJsonAsync($"api/shifts/{_editingId}", request);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            var saved = await response.Content.ReadFromJsonAsync<ShiftResponse>();
            if (saved?.BoundaryWarning is not null)
            {
                _message += " " + saved.BoundaryWarning;
            }
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.DeleteAsync($"api/shifts/{id}");
            if (await response.ReadErrorAsync(L["無効化に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["無効化しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
