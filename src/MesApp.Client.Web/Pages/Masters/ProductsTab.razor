@inject HttpClient Http

@* 品目マスタ（Spec.md 5.1、A-40-10／A-40-20）。
   選んだ品目のMBOM・工順・設計変更の影響は Masters/Products/ の子コンポーネントが持つ *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MasterWrite">
    <div class="card">
        <h2 style="margin-top:0;">@(_editingId is null ? L["品目の登録"] : L["品目の編集（{0}）", _code])</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>@L["品目コード"]</label>
                <input @bind="_code" />
            </div>
            <div class="form-field">
                <label>@L["品目名"]</label>
                <input @bind="_name" />
            </div>
            <div class="form-field">
                <label>@L["単位"]</label>
                <input @bind="_unit" />
            </div>
            <div class="form-field">
                <label>@L["品目区分"]</label>
                <select @bind="_type">
                    <option value="@ProductType.Product">@EnumLabels.Of(ProductType.Product)</option>
                    <option value="@ProductType.SemiFinished">@EnumLabels.Of(ProductType.SemiFinished)</option>
                    <option value="@ProductType.Material">@EnumLabels.Of(ProductType.Material)</option>
                </select>
            </div>
            <div class="form-field">
                <label>@L["規格"]</label>
                <input @bind="_specification" />
            </div>
            <div class="form-field">
                <label>@L["標準不良率(%)"]</label>
                <input type="number" step="any" @bind="_defectRate" />
            </div>
            <div class="form-field">
                <label>@L["既定ロケーション（入庫先の推奨。D-10-30-03）"]</label>
                <select @bind="_defaultLocationId">
                    <option value="0">@L["指定しない"]</option>
                    @foreach (var location in _locations)
                    {
                        <option value="@location.Id">@location.Code</option>
                    }
                </select>
            </div>
        </div>
        <p class="text-muted">
            @L["既定ロケーションを決めておくと、受入・完成品入庫でそこを第一候補として推奨する。"]
            @L["未指定でも、同じ品目の在庫がある場所と品目区分の既定エリアから推奨を出す。"]
        </p>
        <div class="actions">
            <button class="btn" disabled="@_busy" @onclick="SaveAsync">@(_editingId is null ? L["登録"] : L["更新"])</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-secondary" @onclick="ResetForm">@L["キャンセル"]</button>
            }
        </div>
    </div>
</AuthorizeView>

<CsvIoPanel Kind="products" Label="@L["品目"]" KeyLabel="@L["品目コード"]" OnImported="LoadAsync" />
<CsvIoPanel Kind="bom" Label="MBOM" KeyLabel="@L["親品目コード＋子品目コード"]" OnImported="ReloadSelectedAsync" />
<CsvIoPanel Kind="routing" Label="@L["工順（BOP）"]" KeyLabel="@L["品目コード＋工程順序"]" OnImported="ReloadSelectedAsync" />

<div class="card">
    @if (_products is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>@L["コード"]</th><th>@L["品目名"]</th><th>@L["区分"]</th><th>@L["単位"]</th><th>@L["標準不良率"]</th><th>@L["状態"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@EnumLabels.Of(product.Type)</td>
                        <td>@product.Unit</td>
                        <td>@product.StandardDefectRate %</td>
                        <td>@(product.IsActive ? L["有効"] : L["無効"])</td>
                        <td class="actions">
                            <button class="btn btn-secondary btn-sm" @onclick="() => SelectAsync(product)">@L["MBOM・工順"]</button>
                            <AuthorizeView Roles="@MesRoleGroups.MasterWrite" Context="pm">
                                <button class="btn btn-secondary btn-sm" @onclick="() => Edit(product)">@L["編集"]</button>
                                @if (product.IsActive)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeactivateAsync(product.Id)">@L["無効化"]</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_selected is not null)
{
    <ProductBomEditor @ref="_bomEditor" Product="_selected" Products="_products ?? []"
                      OnSaved="ReloadImpactAsync" />
    <ProductRoutingEditor @ref="_routingEditor" Product="_selected" OnSaved="ReloadImpactAsync" />

    @if (_impact is not null)
    {
        <DesignChangeImpactView Product="_selected" Impact="_impact" />
    }
}

@code {
    private List<ProductResponse>? _products;
    /// <summary>既定ロケーションの選択肢（推奨ロケーション指示 D-10-30-03 の第一候補）</summary>
    private List<LocationResponse> _locations = [];

    private ProductResponse? _selected;
    /// <summary>設計変更の影響（J-40-40-01/03）。品目を選ぶたび、MBOM・工順を保存するたびに読み直す</summary>
    private DesignChangeImpactResponse? _impact;

    private ProductBomEditor? _bomEditor;
    private ProductRoutingEditor? _routingEditor;

    private int? _editingId;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _unit = "個"; // 保存される値なので訳さない（Spec.md 7.9）
    private string? _specification;
    private ProductType _type = ProductType.Product;
    private decimal _defectRate;
    private int _defaultLocationId;

    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _locations = await Http.GetFromJsonAsync<List<LocationResponse>>("api/locations") ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _products = await Http.GetFromJsonAsync<List<ProductResponse>>("api/products?includeInactive=true");

    private void Edit(ProductResponse product)
    {
        _editingId = product.Id;
        _code = product.Code;
        _name = product.Name;
        _unit = product.Unit;
        _specification = product.Specification;
        _type = product.Type;
        _defectRate = product.StandardDefectRate;
        _defaultLocationId = product.DefaultLocationId ?? 0;
    }

    private void ResetForm()
    {
        _editingId = null;
        _code = string.Empty;
        _name = string.Empty;
        _unit = "個"; // 保存される値なので訳さない
        _specification = null;
        _type = ProductType.Product;
        _defectRate = 0;
        _defaultLocationId = 0;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            _error = L["品目コードと品目名を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new ProductRequest(_code, _name, _unit, _specification, _type, _defectRate,
                _defaultLocationId == 0 ? null : _defaultLocationId);
            var response = _editingId is null
                ? await Http.PostAsJsonAsync("api/products", request)
                : await Http.PutAsJsonAsync($"api/products/{_editingId}", request);
            if (await response.ReadErrorAsync(L["保存に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["保存しました。"];
            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.DeleteAsync($"api/products/{id}");
            if (await response.ReadErrorAsync(L["無効化に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["無効化しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>CSV取込後、選択中の品目のMBOM・工順を読み直す</summary>
    private async Task ReloadSelectedAsync()
    {
        if (_selected is null)
        {
            return;
        }
        if (_bomEditor is not null)
        {
            await _bomEditor.ReloadAsync();
        }
        if (_routingEditor is not null)
        {
            await _routingEditor.ReloadAsync();
        }
        await ReloadImpactAsync();
    }

    private async Task SelectAsync(ProductResponse product)
    {
        _selected = product;
        _impact = null;
        await ReloadImpactAsync();
    }

    /// <summary>設計変更の影響を読み直す（MBOM・工順の保存後に子から呼ばれる）</summary>
    private async Task ReloadImpactAsync()
    {
        if (_selected is null)
        {
            return;
        }
        _impact = await Http.GetFromJsonAsync<DesignChangeImpactResponse>(
            $"api/products/{_selected.Id}/change-impact");
    }

}
