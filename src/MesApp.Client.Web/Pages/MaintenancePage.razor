@page "/maintenance"
@attribute [Authorize]

<PageTitle>設備保全 - Parallel Factory MES</PageTitle>

<h1>設備保全</h1>
<p class="text-muted">稼働履歴・稼働率（B-40-20、E-20-10）、保全計画（E-30-10）、保全指示・実績（E-30-20〜E-40-30）、保全手順書（E-10-20）。</p>

<div class="tabs">
    <button class="@TabClass("logs")" @onclick='() => _tab = "logs"'>稼働監視</button>
    <button class="@TabClass("plans")" @onclick='() => _tab = "plans"'>保全計画</button>
    <button class="@TabClass("orders")" @onclick='() => _tab = "orders"'>保全指示・実績</button>
    <button class="@TabClass("procedures")" @onclick='() => _tab = "procedures"'>保全手順書</button>
    <button class="@TabClass("parts")" @onclick='() => _tab = "parts"'>消耗材モニタリング</button>
</div>

@* タブの中身はそれぞれが自分で読み込む（MastersPage と同じ形）。
   タブを閉じると入力中の内容も消えるが、保全の入力はタブをまたいで続けない *@
@switch (_tab)
{
    case "logs":
        <EquipmentLogsTab />
        break;
    case "plans":
        <MaintenancePlansTab />
        break;
    case "orders":
        <MaintenanceOrdersTab />
        break;
    case "procedures":
        <MaintenanceProceduresTab />
        break;
    case "parts":
        <MaintenancePartsTab />
        break;
}

@code {
    private string _tab = "logs";

    private string TabClass(string tab) => _tab == tab ? "active" : string.Empty;
}
