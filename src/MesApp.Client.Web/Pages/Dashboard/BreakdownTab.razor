@* ダッシュボードの内訳（Spec.md 3.8。期間の実績を工程・品目・直・ライン・作業区・設備の軸で分ける。
   B-60-10-05 生産性モニタリング／C-40-10-05 不適合モニタリング／E-20-10-03 稼働モニタリング）。
   集計は api/dashboard/breakdown が行い、画面では数えない（Spec.md 7.5） *@
@inject HttpClient Http

<PeriodPicker OnChanged="OnRangeChangedAsync" />

<div class="form-grid">
    <div class="form-field">
        <label>内訳の軸</label>
        <select @bind="_axis" @bind:after="LoadAsync">
            @foreach (var axis in Enum.GetValues<DashboardAxis>())
            {
                <option value="@axis">@(EnumLabels.Of(axis))別</option>
            }
        </select>
    </div>
    <div class="form-field">
        <label>作業区で絞り込む</label>
        <select @bind="_workCenterId" @bind:after="LoadAsync">
            <option value="0">全作業区</option>
            @foreach (var wc in _workCenters)
            {
                <option value="@wc.Id">@wc.Code @wc.Name</option>
            }
        </select>
        <span class="text-muted">上位（工場・ライン・エリア）を選ぶと配下をまとめて集計する</span>
    </div>
</div>

<Notice Error="@_error" />

@if (_data is null)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    @if (!_data.ProductionAvailable)
    {
        <p class="text-muted">設備別では生産数・不良率を出していません（設備は差立で決まり作業指示に固定されないため、生産実績を設備へ分けられない）。</p>
    }
    @if (!_data.UtilizationAvailable)
    {
        <p class="text-muted">@(EnumLabels.Of(_dataAxis))別では稼働率を出していません（稼働記録は設備単位で、作業指示との紐付けが任意のため）。稼働率はライン・作業区・設備別で見る。</p>
    }
    @if (_data.Rows.Count == 0)
    {
        <p class="text-muted">この期間の実績はありません。</p>
    }
    else
    {
        var axisLabel = EnumLabels.Of(_dataAxis);
        @if (_data.ProductionAvailable)
        {
            var production = _data.Rows
                .Where(r => r.GoodQuantity is not null)
                .OrderByDescending(r => (r.GoodQuantity ?? 0) + (r.DefectQuantity ?? 0))
                .ToList();
            <h2>@(axisLabel)別の生産数@(TopNote(production.Count))</h2>
            <HBarChart AriaLabel="@($"{axisLabel}別の良品数・不良数")"
                       Items="@([.. production.Take(TopCount).Select(r => new HBarItem(r.Label,
                           [r.GoodQuantity ?? 0, r.DefectQuantity ?? 0],
                           r.DefectRate is { } rate ? $"不良率 {rate:0.##}%" : null))])"
                       Legend="@([new ChartLegendItem("良品数", "var(--primary)"), new ChartLegendItem("不良数", "var(--danger)")])" />
        }
        @if (_data.UtilizationAvailable)
        {
            var utilization = _data.Rows
                .Where(r => r.UtilizationRate is not null)
                .OrderByDescending(r => r.UtilizationRate)
                .ToList();
            <h2>@(axisLabel)別の設備稼働率@(TopNote(utilization.Count))</h2>
            <HBarChart AriaLabel="@($"{axisLabel}別の設備稼働率")" Unit="%" MaxValue="100" LevelHighIsBad="false"
                       Items="@([.. utilization.Take(TopCount).Select(r => new HBarItem(r.Label,
                           [r.UtilizationRate ?? 0],
                           $"故障 {r.FailureCount} 件"))])"
                       Legend="@([new ChartLegendItem("設備稼働率", "var(--primary)")])" />
        }

        <table class="table">
            <thead>
                <tr>
                    <th>@EnumLabels.Of(_dataAxis)</th>
                    @if (_data.ProductionAvailable)
                    {
                        <th>良品数</th>
                        <th>不良数</th>
                        <th>不良率</th>
                    }
                    @if (_data.UtilizationAvailable)
                    {
                        <th>稼働時間 / 記録時間</th>
                        <th>設備稼働率</th>
                        <th>故障件数</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Rows.Append(_data.Total))
                {
                    <tr style="@(row == _data.Total ? "font-weight:600;" : null)">
                        <td>@row.Label</td>
                        @if (_data.ProductionAvailable)
                        {
                            <td>@row.GoodQuantity?.ToString("0.##")</td>
                            <td>@row.DefectQuantity?.ToString("0.##")</td>
                            <td>
                                @if (row.DefectRate is { } rate)
                                {
                                    <span>@rate.ToString("0.##") %</span>
                                    <BarMeter Value="rate" />
                                }
                                else
                                {
                                    <span class="text-muted">実績なし</span>
                                }
                            </td>
                        }
                        @if (_data.UtilizationAvailable)
                        {
                            <td>@row.RunningHours?.ToString("0.##") / @row.RecordedHours?.ToString("0.##") h</td>
                            <td>
                                @if (row.UtilizationRate is { } utilization)
                                {
                                    <span>@utilization.ToString("0.##") %</span>
                                    <BarMeter Value="utilization" HighIsBad="false" />
                                }
                                else
                                {
                                    <span class="text-muted">記録なし</span>
                                }
                            </td>
                            <td>@row.FailureCount</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private PeriodPicker.Range? _range;
    private DashboardSummaryResponse? _data;
    private List<WorkCenterResponse> _workCenters = [];
    private DashboardAxis _axis = DashboardAxis.Process;
    /// <summary>表示中のデータの軸（選択を変えた直後は読み込み中で、選択と表示がずれる）</summary>
    private DashboardAxis _dataAxis = DashboardAxis.Process;
    private int _workCenterId;
    private string? _error;

    /// <summary>グラフに出す件数の上限（品目などは数が多く、全部並べると読めない。全件は表で見る）</summary>
    private const int TopCount = 10;

    private static string TopNote(int count) => count > TopCount ? $"（上位{TopCount}件。全{count}件は下の表）" : "";
    private int _requestNo;

    protected override async Task OnInitializedAsync()
    {
        _workCenters = await Http.GetFromJsonAsync<List<WorkCenterResponse>>("api/work-centers") ?? [];
    }

    private Task OnRangeChangedAsync(PeriodPicker.Range range)
    {
        _range = range;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_range is null)
        {
            return;
        }
        _error = null;
        var axis = _axis;
        var url = $"api/dashboard/breakdown?from={_range.From:yyyy-MM-dd}&to={_range.To:yyyy-MM-dd}&axis={axis}";
        if (_workCenterId != 0) url += $"&workCenterId={_workCenterId}";
        // 期間・軸を続けて変えると応答の順が入れ替わることがある。最後に出した要求の結果だけを使う
        var requestNo = ++_requestNo;
        var response = await Http.GetAsync(url);
        if (requestNo != _requestNo)
        {
            return;
        }
        if (await response.ReadErrorAsync("内訳の集計を取得できませんでした。") is { } error)
        {
            _error = error;
            return;
        }
        var data = await response.Content.ReadFromJsonAsync<DashboardSummaryResponse>();
        if (requestNo == _requestNo)
        {
            _data = data;
            _dataAxis = axis;
        }
    }
}
