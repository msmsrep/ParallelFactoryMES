@page "/stocktakes"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>棚卸 - Parallel Factory MES</PageTitle>

<h1>棚卸</h1>
<p class="text-muted">棚卸指示作成（D-50-10-01）、実棚数登録（-02）、差異一覧（-03）、差異調整・確定（-04〜05）。</p>

<Notice Error="@_error" Message="@_message" />

<div class="card">
    <h2 style="margin-top:0;">棚卸指示の作成</h2>
    <div class="form-grid">
        <div class="form-field">
            <label>対象ロケーション（未選択で全ロケーション）</label>
            <select @bind="_targetLocationId">
                <option value="0">全ロケーション</option>
                @foreach (var location in _locations)
                {
                    <option value="@location.Id">@location.Code</option>
                }
            </select>
        </div>
    </div>
    <button class="btn" disabled="@_busy" @onclick="CreateAsync">棚卸指示を作成（現在庫をスナップショット）</button>
</div>

<div class="card">
    <h2 style="margin-top:0;">棚卸一覧</h2>
    @if (_stocktakes is null)
    {
        <p class="text-muted">読み込み中...</p>
    }
    else if (_stocktakes.Total == 0)
    {
        <p class="text-muted">棚卸はありません。</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>棚卸番号</th><th>対象</th><th>状態</th><th>作成日</th><th>確定日</th><th>明細</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var stocktake in _stocktakes.Items)
                {
                    <tr>
                        <td>@stocktake.StocktakeNo</td>
                        <td>@(_locations.FirstOrDefault(l => l.Id == stocktake.TargetLocationId)?.Code ?? "全ロケーション")</td>
                        <td><span class="badge @StatusClass(stocktake.Status)">@StocktakeStatusLabel(stocktake.Status)</span></td>
                        <td>@stocktake.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>@(stocktake.FinalizedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@stocktake.Lines.Count 件</td>
                        <td class="actions">
                            <button class="btn btn-secondary btn-sm" @onclick="() => Select(stocktake)">開く</button>
                            <a class="btn btn-secondary btn-sm" href="print/stocktake/@stocktake.Id" target="_blank">棚卸表</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager TItem="StocktakeResponse" Result="_stocktakes" OnPageChanged="LoadPageAsync" />
    }
</div>

@if (_selected is not null)
{
    <div class="card">
        <h2 style="margin-top:0;">@_selected.StocktakeNo の明細（実棚入力・差異）</h2>
        <table class="table">
            <thead>
                <tr><th>ロット</th><th>品目</th><th>ロケーション</th><th>理論数量</th><th>実棚数量</th><th>差異</th><th>調整</th></tr>
            </thead>
            <tbody>
                @foreach (var line in _selected.Lines)
                {
                    <tr>
                        <td>@line.LotNumber</td>
                        <td>@line.ProductCode</td>
                        <td>@line.LocationCode</td>
                        <td>@line.TheoreticalQuantity</td>
                        <td>
                            @if (_selected.Status == StocktakeStatus.Instructed)
                            {
                                <input type="number" style="width:100px;" value="@GetCount(line)"
                                       @onchange="e => SetCount(line.Id, e.Value)" />
                            }
                            else
                            {
                                @(line.CountedQuantity?.ToString() ?? "-")
                            }
                        </td>
                        <td class="@(line.Difference is not null and not 0 ? "text-danger" : "")">
                            @(line.Difference?.ToString() ?? "-")
                        </td>
                        <td>@(line.IsAdjusted ? "調整済" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_selected.Status == StocktakeStatus.Instructed)
        {
            <div class="actions mt-2">
                <button class="btn" disabled="@_busy" @onclick="SaveCountsAsync">実棚数を登録</button>
                <button class="btn" disabled="@_busy" @onclick="FinalizeAsync">確定（差異を棚卸調整）</button>
                <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">取消</button>
            </div>
        }
    </div>
}

@code {
    private PagedResult<StocktakeResponse>? _stocktakes;
    private List<LocationResponse> _locations = [];
    private StocktakeResponse? _selected;
    private readonly Dictionary<int, decimal> _counts = [];
    private int _targetLocationId;
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _locations = await Http.GetFromJsonAsync<List<LocationResponse>>("api/locations") ?? [];
        await LoadAsync();
    }

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        _stocktakes = await Http.GetFromJsonAsync<PagedResult<StocktakeResponse>>($"api/stocktakes?page={page}");
        if (_selected is not null)
        {
            _selected = _stocktakes?.Items.FirstOrDefault(s => s.Id == _selected.Id);
        }
    }

    private void Select(StocktakeResponse stocktake)
    {
        _selected = stocktake;
        _counts.Clear();
        foreach (var line in stocktake.Lines.Where(l => l.CountedQuantity is not null))
        {
            _counts[line.Id] = line.CountedQuantity!.Value;
        }
    }

    private string GetCount(StocktakeLineResponse line) =>
        _counts.TryGetValue(line.Id, out var value) ? value.ToString() : string.Empty;

    private void SetCount(int lineId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), out var parsed))
        {
            _counts[lineId] = parsed;
        }
        else
        {
            _counts.Remove(lineId);
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/stocktakes",
                new StocktakeCreateRequest(_targetLocationId == 0 ? null : _targetLocationId));
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "作成に失敗しました。";
                return;
            }
            _message = "棚卸指示を作成しました。";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveCountsAsync()
    {
        if (_selected is null || _counts.Count == 0)
        {
            _error = "実棚数を入力してください。";
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var counts = _counts.Select(c => new StocktakeCountLine(c.Key, c.Value)).ToList();
            var response = await Http.PutAsJsonAsync($"api/stocktakes/{_selected.Id}/counts",
                new StocktakeCountRequest(counts));
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "登録に失敗しました。";
                return;
            }
            _selected = await response.Content.ReadFromJsonAsync<StocktakeResponse>();
            _message = "実棚数を登録しました。差異を確認して確定してください。";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinalizeAsync() =>
        await PostAsync($"api/stocktakes/{_selected!.Id}/finalize", "棚卸を確定し、差異を調整しました。");

    private async Task CancelAsync() =>
        await PostAsync($"api/stocktakes/{_selected!.Id}/cancel", "棚卸を取消しました。");

    private async Task PostAsync(string url, string successMessage)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsync(url, null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await AuthService.ReadProblemTitleAsync(response) ?? "操作に失敗しました。";
                return;
            }
            _selected = await response.Content.ReadFromJsonAsync<StocktakeResponse>();
            _message = successMessage;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StocktakeStatusLabel(StocktakeStatus status) => status switch
    {
        StocktakeStatus.Instructed => "指示",
        StocktakeStatus.Finalized => "確定",
        StocktakeStatus.Canceled => "取消",
        _ => status.ToString(),
    };

    private static string StatusClass(StocktakeStatus status) => status switch
    {
        StocktakeStatus.Finalized => "badge-success",
        StocktakeStatus.Canceled => "badge-danger",
        _ => "badge-info",
    };
}
