@page "/work-orders"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["作業指示 - Parallel Factory MES"]</PageTitle>

<h1>@L["作業指示一覧"]</h1>

<div class="card">
    <div class="actions" style="margin-bottom:8px;">
        <select @bind="_statusFilter" @bind:after="LoadAsync">
            <option value="">@L["全状態"]</option>
            <option value="Created">@L["未配布"]</option>
            <option value="Dispatched">@L["配布済"]</option>
            <option value="Started">@L["着手"]</option>
            <option value="Completed">@L["完了"]</option>
            <option value="Approved">@L["承認済"]</option>
        </select>
    </div>

    @if (_workOrders is null)
    {
        <p class="text-muted">@L["読み込み中..."]</p>
    }
    else if (_workOrders.Total == 0)
    {
        <p class="text-muted">@L["作業指示はありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["指示番号"]</th>
                    <th>@L["指図番号"]</th>
                    <th>@L["品目"]</th>
                    <th>@L["工程"]</th>
                    <th>@L["計画数"]</th>
                    <th>@L["着手順"]</th>
                    <th>@L["担当者"]</th>
                    <th>@L["状態"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var workOrder in _workOrders.Items)
                {
                    <tr>
                        <td>@workOrder.WorkOrderNo</td>
                        <td><a href="manufacturing-orders/@workOrder.ManufacturingOrderId">@workOrder.OrderNo</a></td>
                        <td>@workOrder.ProductCode @workOrder.ProductName</td>
                        <td>@workOrder.ProcessCode @workOrder.ProcessName</td>
                        <td>@workOrder.PlannedQuantity</td>
                        <td>@(workOrder.DispatchOrder?.ToString() ?? "-")</td>
                        <td>@(workOrder.AssignedUserName ?? "-")</td>
                        <td><StatusBadge Status="@workOrder.Status.ToString()" /></td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" href="work-orders/@workOrder.Id/setup">@L["段取り"]</a>
                            <a class="btn btn-secondary btn-sm" href="work-orders/@workOrder.Id/record">@L["実績入力"]</a>
                            <a class="btn btn-secondary btn-sm" href="print/work-order/@workOrder.Id" target="_blank">@L["指示書"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager TItem="WorkOrderResponse" Result="_workOrders" OnPageChanged="LoadPageAsync" />
    }
</div>

@code {
    private PagedResult<WorkOrderResponse>? _workOrders;
    private string _statusFilter = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task LoadAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        var url = $"api/work-orders?page={page}";
        if (!string.IsNullOrEmpty(_statusFilter))
        {
            url += $"&status={_statusFilter}";
        }
        _workOrders = await Http.GetFromJsonAsync<PagedResult<WorkOrderResponse>>(url);
    }
}
