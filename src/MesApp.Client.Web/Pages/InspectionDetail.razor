@page "/inspections/{Id:int}"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["検査詳細 - Parallel Factory MES"]</PageTitle>

@if (_order is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <h1>@L["検査指示 {0}", _order.OrderNo]</h1>
    <p class="text-muted">
        @L["{0} ／ 対象：{1} ／ 状態：{2}", EnumLabels.Of(_order.Type), _order.TargetLotNumber ?? _order.TargetWorkOrderNo ?? "-", EnumLabels.Of(_order.Status)]
        @if (_order.OverallJudgment is InspectionJudgment judgment)
        {
            <span class="badge @(judgment == InspectionJudgment.Pass ? "badge-success" : "badge-danger")">
                @EnumLabels.Of(judgment)
            </span>
        }
        <a class="btn btn-secondary btn-sm" href="print/inspection/@Id" target="_blank">@L["検査成績書"]</a>
    </p>

    <Notice Error="@_error" Message="@_message" />

    <AuthorizeView Roles="@MesRoleGroups.QualityManage">
        @if (_order.Status is InspectionOrderStatus.Instructed or InspectionOrderStatus.InProgress)
        {
            <div class="card">
                <h2 style="margin-top:0;">@L["検査実績の入力（C-20-10-03。規格値から自動判定）"]</h2>
                <table class="table">
                    <thead>
                        <tr><th>@L["検査項目"]</th><th>@L["規格値"]</th><th>@L["検査方法"]</th><th>@L["測定値"]</th><th>@L["定性記録"]</th><th>@L["判定（手動）"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _order.Items)
                        {
                            <tr>
                                <td>@item.Code @item.Name</td>
                                <td>
                                    @(item.LowerLimit?.ToString() ?? "-") 〜 @(item.UpperLimit?.ToString() ?? "-")
                                    @if (item.StandardValue is not null)
                                    {
                                        <span class="text-muted">@L["（基準 {0}）", item.StandardValue]</span>
                                    }
                                </td>
                                <td>@(item.Method ?? "-")</td>
                                <td>
                                    <input type="number" step="any" style="width:110px;"
                                           value="@GetEntry(item.InspectionItemId).Measured"
                                           @onchange="e => GetEntry(item.InspectionItemId).Measured = e.Value?.ToString()" />
                                </td>
                                <td>
                                    <input style="width:130px;" value="@GetEntry(item.InspectionItemId).Text"
                                           @onchange="e => GetEntry(item.InspectionItemId).Text = e.Value?.ToString()" />
                                </td>
                                <td>
                                    <select value="@GetEntry(item.InspectionItemId).Judgment"
                                            @onchange="e => GetEntry(item.InspectionItemId).Judgment = e.Value?.ToString()">
                                        <option value="">@L["自動判定"]</option>
                                        <option value="Pass">@L["合格"]</option>
                                        <option value="Fail">@L["不合格"]</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @* 使用した検査機（C-20-50-03）。校正期限切れの機器はAPIが拒否するので、選択肢から外しておく *@
                <div class="form-grid">
                    <div class="form-field">
                        <label>@L["使用した検査機（任意）"]</label>
                        <select @bind="_deviceId">
                            <option value="0">@L["選択しない"]</option>
                            @foreach (var device in _devices)
                            {
                                <option value="@device.Id">@device.Code @device.Name</option>
                            }
                        </select>
                    </div>
                </div>
                @if (_expiredDevices.Count > 0)
                {
                    <p class="text-muted">
                        @L["校正期限切れのため選べない検査機：{0}。", string.Join(L["、"], _expiredDevices.Select(d => $"{d.Code} {d.Name}")).ToString()]
                        @L["マスタ管理の検査機・測定器で校正を記録してください。"]
                    </p>
                }
                <button class="btn mt-2" disabled="@_busy" @onclick="SubmitResultsAsync">@L["検査実績を登録"]</button>
            </div>

            <div class="card">
                <h2 style="margin-top:0;">@L["総合判定（C-20-10-04）"]</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label>@L["グレード（任意。C-60-10-01）"]</label>
                        <input @bind="_grade" placeholder="@L["例：A"]" />
                    </div>
                </div>
                <p class="text-muted">@L["全検査項目の実績が合格なら合格。判定結果は対象ロットの在庫ステータスへ反映され、不合格時は不適合が自動起票されます。"]</p>
                <button class="btn" disabled="@_busy" @onclick="JudgeAsync">@L["判定する"]</button>
            </div>
        }

        @if (_order.Status == InspectionOrderStatus.Judged)
        {
            <div class="card">
                <button class="btn" disabled="@_busy" @onclick="ApproveAsync">@L["検査承認（C-20-10-06）"]</button>
            </div>
        }

        @* 誤発行の取消。検査待ちで拘束していたロットは解放される（承認済み・取消済みは不可） *@
        @if (_order.Status is not (InspectionOrderStatus.Approved or InspectionOrderStatus.Canceled))
        {
            <div class="card">
                <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">
                    @L["検査指示を取消（対象ロットの検査待ちを解除）"]
                </button>
            </div>
        }
    </AuthorizeView>

    <div class="card">
        <h2 style="margin-top:0;">@L["検査実績"]</h2>
        @if (_order.Results.Count == 0)
        {
            <p class="text-muted">@L["実績はまだありません。"]</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>@L["検査項目"]</th><th>@L["サンプルNo"]</th><th>@L["測定値"]</th><th>@L["記録"]</th><th>@L["判定"]</th><th>@L["検査機"]</th><th>@L["検査者"]</th><th>@L["検査日時"]</th><th>@L["訂正"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var result in _order.Results)
                    {
                        <tr>
                            <td>@result.ItemCode @result.ItemName</td>
                            <td>@result.SampleNo</td>
                            <td>@(result.MeasuredValue?.ToString() ?? "-")</td>
                            <td>@(result.TextValue ?? "-")</td>
                            <td>
                                <span class="badge @(result.Judgment == InspectionJudgment.Pass ? "badge-success" : "badge-danger")">
                                    @EnumLabels.Of(result.Judgment)
                                </span>
                            </td>
                            <td>@(result.InspectionDeviceCode ?? "-")</td>
                            <td>@result.InspectedByName</td>
                            <td>@result.InspectedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td>
                                @* 訂正はAPIと同じ品質管理権限（api/inspection-orders/{id}/results/{resultId}） *@
                                <AuthorizeView Roles="@MesRoleGroups.QualityManage" Context="correct">
                                    @if (_order.Status != InspectionOrderStatus.Approved)
                                    {
                                        <button class="btn btn-secondary btn-sm" @onclick="() => StartCorrection(result)">@L["訂正"]</button>
                                    }
                                </AuthorizeView>
                                @if (result.CorrectionNote is { Length: > 0 })
                                {
                                    <div class="text-muted" style="white-space:pre-wrap;">@result.CorrectionNote</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* 訂正履歴（C-20-50-07）：元の記録を残したまま、誰がいつ何を根拠に直したかを示す *@
        @if (_order.Corrections.Count > 0)
        {
            <h2>@L["訂正履歴"]</h2>
            <table class="table">
                <thead>
                    <tr><th>@L["日時"]</th><th>@L["検査項目"]</th><th>@L["サンプルNo"]</th><th>@L["訂正前"]</th><th>@L["訂正後"]</th><th>@L["理由"]</th><th>@L["訂正者"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var correction in _order.Corrections)
                    {
                        <tr>
                            <td>@correction.CorrectedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@correction.ItemCode @correction.ItemName</td>
                            <td>@correction.SampleNo</td>
                            <td>@FormatValue(correction.BeforeMeasuredValue, correction.BeforeTextValue, correction.BeforeJudgment)</td>
                            <td>@FormatValue(correction.AfterMeasuredValue, correction.AfterTextValue, correction.AfterJudgment)</td>
                            <td>@correction.Reason</td>
                            <td>@(correction.CorrectedByName ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <AuthorizeView Roles="@MesRoleGroups.QualityManage" Context="correctForm">
    @if (_correcting is not null)
    {
        <div class="card">
            <h2 style="margin-top:0;">@L["検査実績の訂正（C-20-50-07。理由必須・監査ログ記録）"]</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label>@L["測定値"]</label>
                    <input type="number" step="any" @bind="_correctMeasured" />
                </div>
                <div class="form-field">
                    <label>@L["判定"]</label>
                    <select @bind="_correctJudgment">
                        <option value="@InspectionJudgment.Pass">@EnumLabels.Of(InspectionJudgment.Pass)</option>
                        <option value="@InspectionJudgment.Fail">@EnumLabels.Of(InspectionJudgment.Fail)</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>@L["訂正理由"]</label>
                    <input @bind="_correctReason" />
                </div>
            </div>
            <div class="actions">
                <button class="btn" disabled="@_busy" @onclick="SubmitCorrectionAsync">@L["訂正を登録"]</button>
                <button class="btn btn-secondary" @onclick="() => _correcting = null">@L["キャンセル"]</button>
            </div>
        </div>
    }
    </AuthorizeView>
}

@code {
    private string FormatValue(decimal? measured, string? text, InspectionJudgment judgment)
    {
        var value = measured?.ToString() ?? text ?? "-";
        return L["{0}（{1}）", value, EnumLabels.Of(judgment)];
    }

    private sealed class ResultEntry
    {
        public string? Measured { get; set; }
        public string? Text { get; set; }
        public string? Judgment { get; set; }
    }

    [Parameter] public int Id { get; set; }

    private InspectionOrderResponse? _order;
    private readonly Dictionary<int, ResultEntry> _entries = [];
    private InspectionResultResponse? _correcting;
    private decimal? _correctMeasured;
    private InspectionJudgment _correctJudgment = InspectionJudgment.Pass;
    private string? _correctReason;
    private string? _grade;
    private int _deviceId;
    private List<InspectionDeviceResponse> _devices = [];
    private List<InspectionDeviceResponse> _expiredDevices = [];
    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _order = await Http.GetFromJsonAsync<InspectionOrderResponse>($"api/inspection-orders/{Id}");
        _entries.Clear();

        // 校正期限切れの機器はAPIが拒否するため選択肢から外し、外した事実は画面に出す
        // （黙って消すと「登録した機器が無い」と見える）
        var devices = await Http.GetFromJsonAsync<List<InspectionDeviceResponse>>("api/inspection-devices") ?? [];
        _devices = devices.Where(d => !d.IsCalibrationExpired).ToList();
        _expiredDevices = devices.Where(d => d.IsCalibrationExpired).ToList();
    }

    private ResultEntry GetEntry(int itemId)
    {
        if (!_entries.TryGetValue(itemId, out var entry))
        {
            entry = new ResultEntry();
            _entries[itemId] = entry;
        }
        return entry;
    }

    private async Task SubmitResultsAsync()
    {
        var requests = new List<InspectionResultRequest>();
        foreach (var (itemId, entry) in _entries)
        {
            var hasValue = !string.IsNullOrWhiteSpace(entry.Measured)
                           || !string.IsNullOrWhiteSpace(entry.Text)
                           || !string.IsNullOrWhiteSpace(entry.Judgment);
            if (!hasValue)
            {
                continue;
            }
            requests.Add(new InspectionResultRequest(
                itemId, null,
                decimal.TryParse(entry.Measured, out var measured) ? measured : null,
                string.IsNullOrWhiteSpace(entry.Text) ? null : entry.Text,
                Enum.TryParse<InspectionJudgment>(entry.Judgment, out var judgment) ? judgment : null,
                _deviceId == 0 ? null : _deviceId));
        }
        if (requests.Count == 0)
        {
            _error = L["検査結果を入力してください。"];
            return;
        }

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/inspection-orders/{Id}/results", requests);
            if (await response.ReadErrorAsync(L["登録に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _order = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _entries.Clear();
            _message = L["検査実績を登録しました。"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task JudgeAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/inspection-orders/{Id}/judge",
                new InspectionJudgeRequest(string.IsNullOrWhiteSpace(_grade) ? null : _grade));
            if (await response.ReadErrorAsync(L["判定に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _order = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _message = _order?.OverallJudgment == InspectionJudgment.Fail
                ? L["不合格と判定しました。ロットは不良となり、不適合が自動起票されました。"]
                : L["合格と判定しました。ロットは正常になりました。"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>検査指示の取消。検査待ちで拘束していたロットはAPI側で解放される</summary>
    private async Task CancelAsync()
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsync($"api/inspection-orders/{Id}/cancel", null);
            if (await response.ReadErrorAsync(L["取消に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _order = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _message = L["検査指示を取消しました。"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync($"api/inspection-orders/{Id}/approve", null);
            if (await response.ReadErrorAsync(L["承認に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _order = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _message = L["検査を承認しました。"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCorrection(InspectionResultResponse result)
    {
        _correcting = result;
        _correctMeasured = result.MeasuredValue;
        _correctJudgment = result.Judgment;
        _correctReason = null;
    }

    private async Task SubmitCorrectionAsync()
    {
        if (_correcting is null || string.IsNullOrWhiteSpace(_correctReason))
        {
            _error = L["訂正理由を入力してください。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/inspection-orders/{Id}/results/{_correcting.Id}",
                new InspectionResultCorrectionRequest(_correctMeasured, _correcting.TextValue,
                    _correctJudgment, _correctReason));
            if (await response.ReadErrorAsync(L["訂正に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _order = await response.Content.ReadFromJsonAsync<InspectionOrderResponse>();
            _correcting = null;
            _message = L["検査実績を訂正しました（判定済みの場合は再判定が必要です）。"];
        }
        finally
        {
            _busy = false;
        }
    }
}
