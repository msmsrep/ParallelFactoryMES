@page "/change-password"
@attribute [Authorize]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>パスワード変更 - Parallel Factory MES</PageTitle>

<h1>パスワード変更</h1>

<div class="card" style="max-width: 420px;">
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    <div class="form-field" style="margin-bottom: 10px;">
        <label>現在のパスワード</label>
        <input type="password" @bind="_current" autocomplete="current-password" />
    </div>
    <div class="form-field" style="margin-bottom: 10px;">
        <label>新しいパスワード（8文字以上・英小文字・数字を含む）</label>
        <input type="password" @bind="_new" autocomplete="new-password" />
    </div>
    <button class="btn" disabled="@_busy" @onclick="SubmitAsync">変更（変更後は再ログイン）</button>
</div>

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            _error = await Auth.ChangePasswordAsync(_current, _new);
            if (_error is null)
            {
                Navigation.NavigateTo("login");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
