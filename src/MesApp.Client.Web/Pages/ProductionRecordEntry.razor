@page "/work-orders/{Id:int}/record"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>@L["実績入力 - Parallel Factory MES"]</PageTitle>

@* 実績入力（B-40-10-01）。着手・出来高報告・訂正・承認だけをここに置き、
   部材投入・作業手順書・製造条件・状態履歴は Pages/ProductionRecord/ の各節が自分で読み込む *@
@if (_workOrder is null)
{
    <p class="text-muted">@L["読み込み中..."]</p>
}
else
{
    <h1>@L["実績入力：{0}", _workOrder.WorkOrderNo]</h1>
    <p class="text-muted">
        @_workOrder.ProductCode @_workOrder.ProductName ／ @L["工程"] @_workOrder.ProcessCode @_workOrder.ProcessName
        ／ @L["計画数"] @_workOrder.PlannedQuantity ／ @L["状態"] <StatusBadge Status="@_workOrder.Status.ToString()" />
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="alert alert-success">@_message</div>
    }

    @* 着手・実績登録はAPIと同じ製造実行の記録権限（Spec.md 7.4。段取り画面と揃える） *@
    <AuthorizeView Roles="@MesRoleGroups.ShopFloorRecord" Context="record">
    @if (_workOrder.Status is WorkOrderStatus.Created or WorkOrderStatus.Dispatched)
    {
        <div class="card">
            <button class="btn" disabled="@_busy" @onclick="StartAsync">@L["着手（B-30-30-01）"]</button>
        </div>
    }

    @if (Editable)
    {
        <div class="card">
            <h2 style="margin-top:0;">@L["出来高報告（B-40-10-01）"]</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label>@L["良品数"]</label>
                    <input type="number" @bind="_good" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["不良数"]</label>
                    <input type="number" @bind="_defect" min="0" />
                </div>
                @* 廃棄・再作業待ちは不良数の内訳（B-40-10-01）。残りは判定待ち・保留中の数量 *@
                <div class="form-field">
                    <label>@L["うち廃棄数"]</label>
                    <input type="number" @bind="_scrap" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["うち再作業待ち数"]</label>
                    <input type="number" @bind="_rework" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["開始時刻"]</label>
                    <input type="datetime-local" @bind="_startedAt" />
                </div>
                <div class="form-field">
                    <label>@L["終了時刻"]</label>
                    <input type="datetime-local" @bind="_endedAt" />
                </div>
                <div class="form-field">
                    <label>@L["入庫先ロケーション（最終工程のみ必須）"]</label>
                    <select @bind="_outputLocationId">
                        <option value="0">@L["選択してください"]</option>
                        @foreach (var location in _locations)
                        {
                            <option value="@location.Id">@location.Code</option>
                        }
                    </select>
                    @* 推奨ロケーション指示（D-40-40-03）。押し付けず、理由を添えて候補を出す *@
                    @if (_locationRecommendations is { Count: > 0 })
                    {
                        <p class="text-muted">
                            @L["推奨："]
                            @foreach (var r in _locationRecommendations)
                            {
                                <button class="btn btn-secondary btn-sm"
                                        @onclick="() => _outputLocationId = r.LocationId">@r.Code</button>
                                <span>&nbsp;</span>
                            }
                        </p>
                        <p class="text-muted">
                            @_locationRecommendations[0].Code: @_locationRecommendations[0].Reason
                        </p>
                    }
                </div>
                <div class="form-field">
                    <label>
                        <input type="checkbox" @bind="_backflush" style="width:auto;" />
                        @L["バックフラッシュ（MBOMから部材を自動消費。B-40-10-09）"]
                    </label>
                </div>
            </div>

            @* 不良理由別の内訳（C-40-10-01）。合計は不良数を超えられない。残りは理由未分類 *@
            @if (_defectReasons.Count > 0 && _defect > 0)
            {
                <h3>@L["不良理由別の内訳"]</h3>
                <table class="table">
                    <thead><tr><th>@L["不良理由"]</th><th>@L["区分"]</th><th>@L["数量"]</th></tr></thead>
                    <tbody>
                        @foreach (var reason in _defectReasons)
                        {
                            <tr>
                                <td>@reason.Code @reason.Name</td>
                                <td>@EnumLabels.Of(reason.Category)</td>
                                <td>
                                    <input type="number" min="0" style="width:6rem;"
                                           value="@GetDefectQuantity(reason.Id)"
                                           @onchange="e => SetDefectQuantity(reason.Id, e.Value?.ToString())" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted">@L["内訳の合計 {0} / 不良数 {1}", _defectByReason.Values.Sum(), _defect]</p>
            }

            <button class="btn" disabled="@_busy" @onclick="SubmitAsync">@L["実績を登録（作業完了報告）"]</button>
        </div>
    }
    </AuthorizeView>

    <h2>@L["登録済みの実績"]</h2>
    @if (_records.Count == 0)
    {
        <p class="text-muted">@L["実績はまだありません。"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["良品数"]</th>
                    <th>@L["不良数"]</th>
                    <th>@L["廃棄"]</th>
                    <th>@L["再作業待ち"]</th>
                    <th>@L["不良理由内訳"]</th>
                    <th>@L["作業者"]</th>
                    <th>@L["直"]</th>
                    <th>@L["開始"]</th>
                    <th>@L["終了"]</th>
                    <th>@L["産出ロット"]</th>
                    <th>@L["承認"]</th>
                    <th>@L["訂正"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in _records)
                {
                    <tr>
                        <td>@record.GoodQuantity</td>
                        <td>@record.DefectQuantity</td>
                        <td>@record.ScrapQuantity</td>
                        <td>@record.ReworkQuantity</td>
                        <td>
                            @if (record.Defects is { Count: > 0 })
                            {
                                @string.Join("、", record.Defects.Select(d => $"{d.DefectReasonCode} {d.Quantity}"))
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@record.PerformedByName</td>
                        @* 直は記録時に固定した値。直を登録していない運用では空になる *@
                        <td>@(record.ShiftCode is null ? "-" : $"{record.ShiftCode} {record.ShiftName}")</td>
                        <td>@record.StartedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                        <td>@(record.EndedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "-")</td>
                        <td>@(record.OutputLotNumber ?? "-")</td>
                        <td>@(record.ApprovedAt is null ? L["未承認"] : L["承認済"])</td>
                        <td>
                            @* 実績訂正（B-70-30-01）。APIと同じ生産管理権限 *@
                            <AuthorizeView Roles="@MesRoleGroups.ProductionManage" Context="correct">
                                <button class="btn btn-secondary btn-sm"
                                        @onclick="() => StartCorrection(record)">@L["訂正"]</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <AuthorizeView Roles="@MesRoleGroups.ProductionManage" Context="correctForm">
    @if (_correcting is not null)
    {
        <div class="card">
            <h2 style="margin-top:0;">@L["実績の訂正（B-70-30-01。理由必須・訂正履歴と監査ログに残ります）"]</h2>
            <p class="text-muted">
                @L["訂正前：良品 {0} ／ 不良 {1} ／ 廃棄 {2} ／ 再作業待ち {3}", _correcting.GoodQuantity, _correcting.DefectQuantity,
                    _correcting.ScrapQuantity, _correcting.ReworkQuantity]
            </p>
            <div class="form-grid">
                <div class="form-field">
                    <label>@L["良品数"]</label>
                    <input type="number" step="any" @bind="_correctGood" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["不良数"]</label>
                    <input type="number" step="any" @bind="_correctDefect" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["廃棄数"]</label>
                    <input type="number" step="any" @bind="_correctScrap" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["再作業待ち数"]</label>
                    <input type="number" step="any" @bind="_correctRework" min="0" />
                </div>
                <div class="form-field">
                    <label>@L["訂正理由"]</label>
                    <input @bind="_correctReason" />
                </div>
            </div>
            <div class="actions">
                <button class="btn" disabled="@_busy" @onclick="SubmitCorrectionAsync">@L["訂正を登録"]</button>
                <button class="btn btn-secondary" @onclick="() => _correcting = null">@L["キャンセル"]</button>
            </div>
        </div>
    }
    </AuthorizeView>

    <MaterialConsumptionSection @ref="_consumptionSection" WorkOrderId="Id" Editable="Editable" />

    <WorkProcedureSection WorkOrderId="Id" />

    <ControlItemDataSection WorkOrderId="Id" Editable="Editable" />

    <WorkOrderStatusHistorySection @ref="_historySection" WorkOrderId="Id" />

    <AuthorizeView Roles="@MesRoleGroups.ProductionManage">
        @if (_workOrder.Status == WorkOrderStatus.Completed)
        {
            <div class="card">
                <button class="btn" disabled="@_busy" @onclick="ApproveAsync">@L["製造完了承認（B-40-10-10）"]</button>
            </div>
        }
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkOrderResponse? _workOrder;
    private List<ProductionRecordResponse> _records = [];
    private List<LocationOption> _locations = [];
    /// <summary>産出品の推奨入庫先（D-40-40-03）。作業指示の品目から引く</summary>
    private List<LocationRecommendationResponse>? _locationRecommendations;

    private MaterialConsumptionSection? _consumptionSection;
    private WorkOrderStatusHistorySection? _historySection;

    // 実績訂正（B-70-30-01）
    private ProductionRecordResponse? _correcting;
    private decimal _correctGood;
    private decimal _correctDefect;
    private decimal _correctScrap;
    private decimal _correctRework;
    private string _correctReason = string.Empty;

    private decimal _good;
    private decimal _defect;
    private decimal _scrap;
    private decimal _rework;
    private DateTime _startedAt = DateTime.Now;
    private DateTime? _endedAt;
    private int _outputLocationId;
    private bool _backflush;
    private List<DefectReasonResponse> _defectReasons = [];
    private readonly Dictionary<int, decimal> _defectByReason = [];

    private string? _error;
    private string? _message;
    private bool _busy;

    // ロケーションはコード表示のみ使用（MasterContractsのLocationResponseはenumを含むため簡易DTOで受ける）
    private sealed record LocationOption(int Id, string Code);

    /// <summary>入力を受け付けてよい状態か（承認済・取消では各節の入力欄を出さない）</summary>
    private bool Editable =>
        _workOrder is not null &&
        _workOrder.Status is not (WorkOrderStatus.Approved or WorkOrderStatus.Canceled);

    private decimal GetDefectQuantity(int reasonId) =>
        _defectByReason.TryGetValue(reasonId, out var quantity) ? quantity : 0;

    private void SetDefectQuantity(int reasonId, string? value)
    {
        if (decimal.TryParse(value, out var quantity) && quantity > 0)
        {
            _defectByReason[reasonId] = quantity;
        }
        else
        {
            _defectByReason.Remove(reasonId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _locations = await Http.GetFromJsonAsync<List<LocationOption>>("api/locations") ?? [];
        _defectReasons = await Http.GetFromJsonAsync<List<DefectReasonResponse>>("api/defect-reasons") ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _workOrder = await Http.GetFromJsonAsync<WorkOrderResponse>($"api/work-orders/{Id}");
        if (_workOrder is not null)
        {
            _locationRecommendations = await Http.GetFromJsonAsync<List<LocationRecommendationResponse>>(
                $"api/locations/recommendations?productId={_workOrder.ProductId}");
        }
        _records = await Http.GetFromJsonAsync<List<ProductionRecordResponse>>(
            $"api/work-orders/{Id}/production-records") ?? [];

        // 着手・実績登録・承認は状態履歴を増やし、バックフラッシュは部材投入も増やす。
        // 初回は各節が自分で読み込むため、参照が入っているとき（2回目以降）だけ読み直す
        if (_historySection is not null)
        {
            await _historySection.ReloadAsync();
        }
        if (_consumptionSection is not null)
        {
            await _consumptionSection.ReloadAsync();
        }
    }

    private void StartCorrection(ProductionRecordResponse record)
    {
        _correcting = record;
        _correctGood = record.GoodQuantity;
        _correctDefect = record.DefectQuantity;
        _correctScrap = record.ScrapQuantity;
        _correctRework = record.ReworkQuantity;
        _correctReason = string.Empty;
        _error = null;
        _message = null;
    }

    private async Task SubmitCorrectionAsync()
    {
        if (_busy || _correcting is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_correctReason))
        {
            _error = L["訂正理由を入力してください。"];
            return;
        }
        if (_correctScrap + _correctRework > _correctDefect)
        {
            _error = L["廃棄数と再作業待ち数の合計は不良数を超えられません。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/production-records/{_correcting.Id}",
                new ProductionRecordCorrectionRequest(
                    _correctGood, _correctDefect, _correctReason, _correctScrap, _correctRework));
            if (await response.ReadErrorAsync(L["訂正に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["実績を訂正しました（訂正前の値は訂正履歴に残ります）。"];
            _correcting = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync($"api/work-orders/{Id}/start", null);
            if (await response.ReadErrorAsync(L["着手に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["着手しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }
        if (_good + _defect <= 0)
        {
            _error = L["良品数と不良数の合計は0より大きい必要があります。"];
            return;
        }
        if (_scrap + _rework > _defect)
        {
            _error = L["廃棄数と再作業待ち数の合計は不良数を超えられません。"];
            return;
        }
        if (_defectByReason.Values.Sum() > _defect)
        {
            _error = L["不良理由別の内訳の合計は不良数を超えられません。"];
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/work-orders/{Id}/production-records",
                new ProductionRecordRequest(
                    _good, _defect,
                    new DateTimeOffset(_startedAt),
                    _endedAt is null ? null : new DateTimeOffset(_endedAt.Value),
                    _outputLocationId == 0 ? null : _outputLocationId,
                    _backflush, _scrap, _rework,
                    _defectByReason.Where(x => x.Value > 0)
                        .Select(x => new ProductionDefectRequest(x.Key, x.Value))
                        .ToList()));
            if (await response.ReadErrorAsync(L["実績登録に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["実績を登録しました。"];
            _good = 0;
            _defect = 0;
            _scrap = 0;
            _rework = 0;
            _defectByReason.Clear();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync($"api/work-orders/{Id}/approve", null);
            if (await response.ReadErrorAsync(L["承認に失敗しました。"]) is { } error)
            {
                _error = error;
                return;
            }
            _message = L["承認しました。"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
