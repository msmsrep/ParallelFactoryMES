@inject HttpClient Http

@* 保全計画（Spec.md 3.1。E-30-10）。年次の計画と、そこからの指示発行 *@
<Notice Error="@_error" Message="@_message" />

<AuthorizeView Roles="@MesRoleGroups.MaintenanceManage">
    <div class="card">
        <h2 style="margin-top:0;">保全計画の作成（E-30-10）</h2>
        <div class="form-grid">
            <div class="form-field">
                <label>設備</label>
                <select @bind="_plan.EquipmentId">
                    <option value="0">選択してください</option>
                    @foreach (var equipment in _equipments)
                    {
                        <option value="@equipment.Id">@equipment.AssetNo @equipment.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>保全種別</label>
                <select @bind="_plan.Category">
                    <option value="@MaintenanceCategory.Periodic">@EnumLabels.Of(MaintenanceCategory.Periodic)</option>
                    <option value="@MaintenanceCategory.Unplanned">@EnumLabels.Of(MaintenanceCategory.Unplanned)</option>
                </select>
            </div>
            <div class="form-field">
                <label>計画年度</label>
                <input type="number" @bind="_plan.PlanYear" />
            </div>
            <div class="form-field">
                <label>予定日</label>
                <input type="date" @bind="_plan.ScheduledDate" />
            </div>
            <div class="form-field">
                <label>周期（日数）</label>
                <input type="number" @bind="_plan.CycleDays" />
            </div>
            <div class="form-field">
                <label>備考</label>
                <input @bind="_plan.Note" />
            </div>
        </div>
        <button class="btn" disabled="@_busy" @onclick="CreatePlanAsync">計画を作成</button>
    </div>
</AuthorizeView>

<div class="card">
    @if (_plans is null)
    {
        <p class="text-muted">読み込み中...</p>
    }
    else if (_plans.Count == 0)
    {
        <p class="text-muted">保全計画はありません。</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>設備</th><th>種別</th><th>年度</th><th>予定日</th><th>周期</th><th>状態</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var plan in _plans)
                {
                    <tr>
                        <td>@plan.AssetNo @plan.EquipmentName</td>
                        <td>@EnumLabels.Of(plan.Category)</td>
                        <td>@plan.PlanYear</td>
                        <td>@(plan.ScheduledDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(plan.CycleDays is null ? "-" : $"{plan.CycleDays}日")</td>
                        <td>@EnumLabels.Of(plan.Status)</td>
                        <td>
                            <AuthorizeView Roles="@MesRoleGroups.MaintenanceManage" Context="mt">
                                @if (plan.Status == MaintenancePlanStatus.Planned)
                                {
                                    <button class="btn btn-sm" disabled="@_busy"
                                            @onclick="() => CreateOrderFromPlanAsync(plan)">保全指示を発行</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private sealed class PlanForm
    {
        public int EquipmentId { get; set; }
        public MaintenanceCategory Category { get; set; } = MaintenanceCategory.Periodic;
        public int PlanYear { get; set; } = DateTime.Today.Year;
        public DateTime? ScheduledDate { get; set; }
        public int? CycleDays { get; set; }
        public string? Note { get; set; }
    }

    private List<EquipmentResponse> _equipments = [];
    private List<MaintenancePlanResponse>? _plans;

    private readonly PlanForm _plan = new();

    private string? _error;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _equipments = await Http.GetFromJsonAsync<List<EquipmentResponse>>("api/equipments") ?? [];
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync() =>
        _plans = await Http.GetFromJsonAsync<List<MaintenancePlanResponse>>("api/maintenance-plans");

    private async Task CreatePlanAsync()
    {
        if (_plan.EquipmentId == 0)
        {
            _error = "設備を選択してください。";
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/maintenance-plans",
                new MaintenancePlanRequest(_plan.EquipmentId, _plan.Category, _plan.PlanYear,
                    _plan.ScheduledDate is null ? null : DateOnly.FromDateTime(_plan.ScheduledDate.Value),
                    _plan.CycleDays, _plan.Note));
            if (await response.ReadErrorAsync("作成に失敗しました。") is { } error)
            {
                _error = error;
                return;
            }
            _message = "保全計画を作成しました。";
            await LoadPlansAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>計画から指示を起こす（E-30-30-01）。指示の一覧は「保全指示・実績」タブで見る</summary>
    private async Task CreateOrderFromPlanAsync(MaintenancePlanResponse plan)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/maintenance-orders",
                new MaintenanceOrderCreateRequest(plan.EquipmentId, null, plan.Id, null,
                    plan.ScheduledDate, MaintenanceRequestType.Planned, plan.Note));
            if (await response.ReadErrorAsync("発行に失敗しました。") is { } error)
            {
                _error = error;
                return;
            }
            _message = "保全指示を発行しました。";
            await LoadPlansAsync();
        }
        finally
        {
            _busy = false;
        }
    }

}
