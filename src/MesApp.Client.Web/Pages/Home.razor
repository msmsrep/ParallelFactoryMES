@* ダッシュボード（Spec.md 3.8。期間の実績サマリ・推移・内訳のKPI表示。
   B-60-10-05 生産性モニタリング／C-40-10-05 不適合モニタリング／E-20-10-03 稼働モニタリング／A-30-10-01 進捗） *@
@page "/"
@attribute [Authorize]

<PageTitle>ダッシュボード - Parallel Factory MES</PageTitle>

<h1>ダッシュボード</h1>

<div class="tabs">
    <button class="@TabClass("summary")" @onclick='() => _tab = "summary"'>サマリ</button>
    <button class="@TabClass("trend")" @onclick='() => _tab = "trend"'>推移（日・週・月）</button>
    <button class="@TabClass("breakdown")" @onclick='() => _tab = "breakdown"'>内訳（工程・品目・直・ライン・設備）</button>
</div>

@* タブの中身はそれぞれが自分で読み込む（MastersPage と同じ形） *@
@switch (_tab)
{
    case "summary":
        <SummaryTab />
        break;
    case "trend":
        <TrendTab />
        break;
    case "breakdown":
        <BreakdownTab />
        break;
}

@code {
    private string _tab = "summary";

    private string TabClass(string tab) => _tab == tab ? "active" : string.Empty;
}
