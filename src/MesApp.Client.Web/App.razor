<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                @* 未認証はログインへ。ログイン済みで権限が足りない場合は理由を出す
                   （同じ扱いにすると、ログイン中の利用者がログイン画面に戻されて理由が分からない） *@
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <PageTitle>権限がありません - Parallel Factory MES</PageTitle>
                        <h1>権限がありません</h1>
                        <p class="text-muted">
                            この画面は、いまのユーザーに割り当てられたロールでは開けません。
                            必要な権限はシステム管理者に確認してください。
                        </p>
                        <a class="btn btn-secondary" href="">ダッシュボードへ戻る</a>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>ページが見つかりません</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>ページが見つかりません。</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
