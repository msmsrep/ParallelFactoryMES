@inject HttpClient Http
@inject IJSRuntime JS

@* CSV一括入出力（エクスポート／テンプレート／取込）。マスタ（api/masters/csv）と実績（api/actuals/csv。取込のみ）で共用 *@
<div class="card">
    <details>
        <summary class="csv-summary">CSV入出力（@Label）</summary>

        <p class="text-muted mt-2">
            @if (CanExport)
            {
                <span>エクスポートしたCSVをExcelで編集して取り込めます。取込は
                <strong>@KeyLabel が既存と一致すれば更新、無ければ新規登録</strong>です。</span>
            }
            else
            {
                <span>取込は<strong>常に新規登録</strong>です（既存の記録は更新しません。同じファイルを2回取り込むと2回分登録されます）。</span>
            }
            文字コードはUTF-8とShift_JISのどちらでも取り込めます。
        </p>

        <div class="actions">
            @if (CanExport)
            {
                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="ExportAsync">CSVエクスポート</button>
            }
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="TemplateAsync">テンプレート（空のCSV）</button>
        </div>

        <AuthorizeView Roles="@Roles">
            <div class="csv-import mt-2">
                <div class="form-field">
                    <label>取込ファイル（.csv）</label>
                    <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" />
                </div>
                <div class="actions mt-2">
                    <label class="text-muted">
                        <input type="checkbox" style="width:auto;" @bind="_dryRun" />
                        検証のみ（DBに反映しない）
                    </label>
                    <button type="button" class="btn" disabled="@(_busy || _file is null)" @onclick="ImportAsync">
                        取込を実行
                    </button>
                </div>
            </div>
        </AuthorizeView>

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-2">@_error</div>
        }
        @if (_result is not null)
        {
            @if (_result.Succeeded)
            {
                <div class="alert alert-success mt-2">
                    @(_result.DryRun ? "検証のみ：エラーはありません。" : "取り込みました。")
                    @if (CanExport)
                    {
                        <span>データ行 @_result.DataRows 件（新規 @_result.Created 件／更新 @_result.Updated 件）</span>
                    }
                    else
                    {
                        <span>データ行 @_result.DataRows 件（登録 @_result.Created 件）</span>
                    }
                </div>
                @* 警告は取り込めている。エラーと違い取り消されないので、その旨を添えて出す *@
                @if (_result.Warnings.Count > 0)
                {
                    <div class="alert alert-warning mt-2">
                        警告が @_result.Warnings.Count 件あります（<strong>取込は完了しています</strong>）。
                    </div>
                    <table class="table">
                        <thead><tr><th style="width:80px;">行</th><th>内容</th></tr></thead>
                        <tbody>
                            @foreach (var warning in _result.Warnings)
                            {
                                <tr>
                                    <td>@(warning.Line > 0 ? warning.Line.ToString() : "-")</td>
                                    <td>@warning.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                <div class="alert alert-danger mt-2">
                    エラーが @_result.Errors.Count 件あります。<strong>1行でもエラーがあると全件取り消されます</strong>
                    （DBは変更されていません）。修正して再度取り込んでください。
                </div>
                <table class="table">
                    <thead><tr><th style="width:80px;">行</th><th>内容</th></tr></thead>
                    <tbody>
                        @foreach (var error in _result.Errors)
                        {
                            <tr>
                                <td>@(error.Line > 0 ? error.Line.ToString() : "-")</td>
                                <td>@error.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        @if (_columns is not null)
        {
            <details class="mt-2">
                <summary class="csv-summary">列の説明</summary>
                <table class="table mt-2">
                    <thead><tr><th>列名</th><th>項目</th><th>必須</th><th>備考</th></tr></thead>
                    <tbody>
                        @foreach (var column in _columns)
                        {
                            <tr>
                                <td><code>@column.Name</code></td>
                                <td>@column.Label</td>
                                <td>@(column.Required ? "必須" : "任意")</td>
                                <td>@column.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted">
                    @(CanExport
                        ? "列の順序は自由です。不要な列は削除できます（削除した列は現在の値を保ちます）。"
                        : "列の順序は自由です。任意の列は削除できます（削除した列は空欄と同じ扱いです）。")
                </p>
            </details>
        }
    </details>
</div>

@code {
    /// <summary>種別（{BaseUrl}/{Kind}）</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;

    /// <summary>CSV入出力APIの基点（マスタは api/masters/csv、実績は api/actuals/csv）</summary>
    [Parameter] public string BaseUrl { get; set; } = "api/masters/csv";

    /// <summary>エクスポートを出すか（実績CSVは取込のみ）</summary>
    [Parameter] public bool CanExport { get; set; } = true;

    /// <summary>種別と列の説明を親が取得済みなら渡す（種別ごとに kinds を取り直さないため）</summary>
    [Parameter] public CsvKindInfo? Info { get; set; }

    /// <summary>画面表示用の名称</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>キー列の説明（例：品目コード）</summary>
    [Parameter] public string KeyLabel { get; set; } = "コード";

    /// <summary>取込を実行できるロール</summary>
    [Parameter] public string Roles { get; set; } = MesRoleGroups.MasterWrite;

    /// <summary>取込成功後に一覧を再読み込みするためのコールバック</summary>
    [Parameter] public EventCallback OnImported { get; set; }

    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private List<CsvColumnInfo>? _columns;
    private IBrowserFile? _file;
    private CsvImportResult? _result;
    private string? _error;
    private bool _dryRun;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var info = Info;
            if (info is null)
            {
                var kinds = await Http.GetFromJsonAsync<List<CsvKindInfo>>($"{BaseUrl}/kinds") ?? [];
                info = kinds.FirstOrDefault(k => k.Kind == Kind);
            }
            _columns = info?.Columns;
            if (string.IsNullOrEmpty(Label) && info is not null)
            {
                Label = info.Label;
            }
        }
        catch (HttpRequestException)
        {
            // 列の説明が取れなくても入出力自体は利用できる
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _result = null;
        _error = null;
    }

    private Task ExportAsync() => DownloadAsync($"{BaseUrl}/{Kind}?includeInactive=true", $"{Kind}.csv");

    private Task TemplateAsync() => DownloadAsync($"{BaseUrl}/{Kind}/template", $"{Kind}_template.csv");

    private async Task DownloadAsync(string url, string fallbackFileName)
    {
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            var response = await Http.GetAsync(url);
            if (await response.ReadErrorAsync("CSVの出力に失敗しました。") is { } error)
            {
                _error = error;
                return;
            }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = response.Content.Headers.ContentDisposition?.FileName?.Trim('"');
            await JS.InvokeVoidAsync("mesApp.downloadFile",
                string.IsNullOrEmpty(fileName) ? fallbackFileName : fileName,
                Convert.ToBase64String(bytes), "text/csv");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_file is null)
        {
            return;
        }
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            if (_file.Size > MaxUploadBytes)
            {
                _error = $"ファイルサイズが大きすぎます（上限 {MaxUploadBytes / 1024 / 1024} MB）。";
                return;
            }

            using var buffer = new MemoryStream();
            await using (var stream = _file.OpenReadStream(MaxUploadBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(buffer.ToArray());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");
            content.Add(fileContent, "file", _file.Name);

            var response = await Http.PostAsync($"{BaseUrl}/{Kind}?dryRun={(_dryRun ? "true" : "false")}", content);
            if (await response.ReadErrorAsync("取込に失敗しました。") is { } error)
            {
                _error = error;
                return;
            }

            _result = await response.Content.ReadFromJsonAsync<CsvImportResult>();
            if (_result is { Succeeded: true, DryRun: false })
            {
                await OnImported.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
