<span class="badge @CssClass">@Label</span>

@code {
    [Parameter, EditorRequired]
    public string Status { get; set; } = string.Empty;

    /// <summary>
    /// 状態の表示名（Spec.md 7.9）。製造指図・作業指示・治工具の引当払出の状態名を API から文字列で受け取るため、
    /// どの区分の値かを順に当てて Core の表示名を引く
    /// </summary>
    private string Label =>
        Enum.TryParse<ManufacturingOrderStatus>(Status, out var order) ? EnumLabels.Of(order)
        : Enum.TryParse<WorkOrderStatus>(Status, out var workOrder) ? EnumLabels.Of(workOrder)
        : Enum.TryParse<ToolIssueStatus>(Status, out var toolIssue) ? EnumLabels.Of(toolIssue)
        : Status;

    private string CssClass => Status switch
    {
        "Draft" or "Created" => "",
        "Approved" or "Dispatched" => "badge-info",
        "Released" or "Started" or "Issued" => "badge-warning",
        "Allocated" => "badge-info",
        "Completed" or "Returned" => "badge-success",
        "Canceled" => "badge-danger",
        _ => "",
    };
}
