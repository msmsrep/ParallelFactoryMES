<span class="badge @CssClass">@Label</span>

@code {
    [Parameter, EditorRequired]
    public string Status { get; set; } = string.Empty;

    private string Label => Status switch
    {
        // 製造指図（ManufacturingOrderStatus）
        "Draft" => "未承認",
        "Approved" => "承認済",
        "Released" => "展開済",
        "Completed" => "完了",
        "Canceled" => "取消",
        // 作業指示（WorkOrderStatus）
        "Created" => "未配布",
        "Dispatched" => "配布済",
        "Started" => "着手",
        _ => Status,
    };

    private string CssClass => Status switch
    {
        "Draft" or "Created" => "",
        "Approved" or "Dispatched" => "badge-info",
        "Released" or "Started" => "badge-warning",
        "Completed" => "badge-success",
        "Canceled" => "badge-danger",
        _ => "",
    };
}
