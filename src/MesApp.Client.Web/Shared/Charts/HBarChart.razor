@* 横棒グラフ（Spec.md 3.8 ダッシュボードの内訳）。軸の値（工程・品目・設備など）ごとに積み上げた横棒を並べる。
   並べ替え・件数の絞り込みは呼び出し側で行い、ここでは渡された順に描く *@

<div class="chart">
    <svg viewBox="0 0 @ChartScale.F(Width) @ChartScale.F(Height)" style="width:100%; min-width:520px;"
         role="img" aria-label="@AriaLabel">
        @foreach (var tick in _ticks)
        {
            var x = X(tick);
            <line x1="@ChartScale.F(x)" y1="@ChartScale.F(Top)" x2="@ChartScale.F(x)" y2="@ChartScale.F(Height - 18)"
                  style="stroke:var(--border); stroke-dasharray:@(tick == 0 ? "none" : "2 3");" />
            @ChartScale.Text(x, Height - 4, ChartScale.Number(tick) + (tick == _ticks[^1] ? Unit ?? "" : ""))
        }
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var y = Top + RowHeight * i;
            <g>
                <title>@item.Label：@string.Join(" / ", item.Values.Select((v, k) => $"{Legend.ElementAtOrDefault(k)?.Name} {ChartScale.Number(v)}{Unit}"))@(item.Note is null ? "" : $"（{item.Note}）")</title>
                @ChartScale.Text(LabelWidth - 8, y + RowHeight / 2 + 4, Shorten(item.Label), "end",
                    "font-size:12px; fill:var(--text);")
                @{
                    var left = X(0);
                }
                @for (var k = 0; k < item.Values.Count; k++)
                {
                    var w = X(Math.Max(item.Values[k], 0)) - X(0);
                    <rect x="@ChartScale.F(left)" y="@ChartScale.F(y + 4)" width="@ChartScale.F(w)" height="@ChartScale.F(RowHeight - 8)"
                          style="fill:@SegmentColor(k, item.Values[k]);" />
                    left += w;
                }
                @ChartScale.Text(left + 6, y + RowHeight / 2 + 4,
                    ChartScale.Number(item.Values.Sum()) + Unit + (item.Note is null ? "" : $"（{item.Note}）"), "start")
            </g>
        }
    </svg>
    @if (Legend.Count > 1)
    {
        <p class="text-muted">
            @foreach (var legend in Legend)
            {
                <span style="margin-right:12px;"><span style="color:@legend.Color;">■</span> @legend.Name</span>
            }
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HBarItem> Items { get; set; } = [];

    /// <summary>積み上げる値の名前と色（<see cref="HBarItem.Values"/> と同じ順）</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ChartLegendItem> Legend { get; set; } = [];

    [Parameter] public string? Unit { get; set; }

    /// <summary>軸の上限を固定する（%なら100）。null なら最大値に合わせる</summary>
    [Parameter] public decimal? MaxValue { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "グラフ";

    /// <summary>
    /// 割合の棒を水準で色分けするときの向き（true なら高いほど悪い）。null なら凡例の色のまま。
    /// しきい値は割合バー（BarMeter）と同じ（表のメーターと棒の色がずれないように）
    /// </summary>
    [Parameter] public bool? LevelHighIsBad { get; set; }

    private const decimal LabelWidth = 170m;
    private const decimal BarWidth = 420m;
    private const decimal NoteWidth = 170m;
    private const decimal RowHeight = 28m;
    private const decimal Top = 4m;

    private IReadOnlyList<decimal> _ticks = [0m, 1m];

    private decimal Width => LabelWidth + BarWidth + NoteWidth;
    private decimal Height => Top + RowHeight * Items.Count + 22m;

    protected override void OnParametersSet()
    {
        var max = MaxValue ?? Items.Select(i => i.Values.Sum()).DefaultIfEmpty(0).Max();
        _ticks = ChartScale.Ticks(max, target: 4);
    }

    private decimal X(decimal value) => LabelWidth + Math.Min(value, _ticks[^1]) / _ticks[^1] * BarWidth;

    private string SegmentColor(int index, decimal value) =>
        LevelHighIsBad is { } highIsBad && ChartScale.Level(value, highIsBad) is { } level
            ? $"var(--{level})"
            : Legend.ElementAtOrDefault(index)?.Color ?? "var(--primary)";

    /// <summary>長い名前は切る（全体はツールチップで見る）</summary>
    private static string Shorten(string label) => label.Length <= 14 ? label : label[..13] + "…";
}
