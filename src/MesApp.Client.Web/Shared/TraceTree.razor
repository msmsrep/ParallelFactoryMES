@* トレース結果の再帰ツリー表示（トレースバック／フォワード共通） *@
<ul class="trace-tree">
    @foreach (var node in Nodes)
    {
        <li>
            <strong>@node.LotNumber</strong>
            <span class="text-muted">@node.ProductCode @node.ProductName</span>
            @if (node.Quantity is not null)
            {
                <span class="badge">@node.Quantity</span>
            }
            @if (node.WorkOrderNo is not null)
            {
                <span class="badge badge-info">@node.WorkOrderNo</span>
            }
            @if (node.Relation is not null)
            {
                <span class="badge badge-warning">@EnumLabels.Of(node.Relation.Value)</span>
            }
            <span class="badge">@EnumLabels.Of(node.StockStatus)</span>
            <a class="btn btn-secondary btn-sm" href="traceability?lot=@node.LotNumber">@L["この Lot を追跡"]</a>

            @if (node.Children.Count > 0)
            {
                <TraceTree Nodes="@node.Children" />
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public List<TraceNode> Nodes { get; set; } = [];
}
