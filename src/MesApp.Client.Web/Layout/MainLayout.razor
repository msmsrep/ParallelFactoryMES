@inherits LayoutComponentBase
@inject AuthService Auth
@inject TokenStore Tokens
@inject NavigationManager Navigation

<div class="app-layout">
    <aside class="sidebar">
        <div class="brand">Parallel Factory MES</div>
        <NavMenu />
    </aside>
    <div class="main-area">
        <header class="topbar">
            <CultureSelector />
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted">@Tokens.User?.DisplayName</span>
                    <button class="btn btn-secondary btn-sm" @onclick="LogoutAsync">@L["ログアウト"]</button>
                </Authorized>
            </AuthorizeView>
        </header>
        <main class="content">
            @* 画面の読み込み（GET）が失敗しても、リロードするまで操作不能にならないようにする *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="card">
                        <div class="alert alert-danger">
                            @L["画面の読み込みに失敗しました。通信状態を確認して再試行してください。"]
                        </div>
                        <div class="actions">
                            <button class="btn" @onclick="RetryAsync">@L["再試行"]</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private const string ChangePasswordPath = "change-password";

    private ErrorBoundary? _errorBoundary;

    /// <summary>エラー表示から復帰する（同じ画面を組み立て直す）</summary>
    private Task RetryAsync()
    {
        _errorBoundary?.Recover();
        return Task.CompletedTask;
    }

    /// <summary>
    /// 初期パスワードのままの利用者はパスワード変更画面へ誘導する。
    /// APIも同じ状態のトークンを403で拒否する（MustChangePasswordFilter）ため、
    /// ここで止めないとどの画面も読み込みに失敗するだけになる。
    /// </summary>
    protected override void OnParametersSet()
    {
        // 画面を移ったらエラー表示は解除する（前の画面の失敗を引きずらない）
        _errorBoundary?.Recover();

        if (Tokens.User?.MustChangePassword != true)
        {
            return;
        }
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimStart('/');
        if (!path.Equals(ChangePasswordPath, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(ChangePasswordPath, replace: true);
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
