<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 連携API の OpenAPI 文書に XML コメントを説明として載せる（Spec.md 3.8 連携API）。
         説明の網羅は求めない（CS1591：コメントの無い公開型、CS1573：引数の一部にだけ説明がある） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ロールグループはCoreに置いてAPIと画面で共有する。全コントローラで使うのでグローバルusingにする -->
    <Using Include="MesApp.Core.Constants" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MesApp.Client.Web\MesApp.Client.Web.csproj" />
    <ProjectReference Include="..\MesApp.Core\MesApp.Core.csproj" />
    <ProjectReference Include="..\MesApp.Infrastructure\MesApp.Infrastructure.csproj" />
    <ProjectReference Include="..\MesApp.Migrations.PostgreSql\MesApp.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\MesApp.Migrations.SqlServer\MesApp.Migrations.SqlServer.csproj" />
  </ItemGroup>

</Project>
