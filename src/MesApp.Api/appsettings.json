{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=mesapp.db"
  },
  "Jwt": {
    "Issuer": "MesApp",
    "Audience": "MesApp",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeHours": 12,
    "SigningKeyFile": "jwt-signing.key"
  },
  "BusinessDay": {
    "BoundaryHour": 6,
    "TimeZone": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
